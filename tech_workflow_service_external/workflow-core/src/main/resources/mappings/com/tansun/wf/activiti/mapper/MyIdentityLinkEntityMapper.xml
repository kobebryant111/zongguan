<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.camunda.bpm.engine.impl.persistence.entity.IdentityLinkEntity">

    <delete id="deleteIdentityByTaskId" parameterType="string">
        delete from ${prefix}ACT_RU_IDENTITYLINK where TASK_ID_ = #{taskId}
    </delete>

    <delete id="deleteIdentityByProcInstId" parameterType="string">
        delete from ${prefix}ACT_RU_IDENTITYLINK where proc_inst_id_ = #{procInstId}
    </delete>
</mapper>

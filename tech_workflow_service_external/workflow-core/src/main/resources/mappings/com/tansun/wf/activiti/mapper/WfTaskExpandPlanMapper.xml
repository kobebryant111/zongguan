<?xml version="1.0" encoding="UTF-8" ?> 

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd"> 
  
<mapper namespace="com.tansun.wf.activiti.mapper.WfTaskExpandPlanMapper">

  <resultMap id="taskExpandPlanResultMap" type="com.tansun.wf.activiti.model.TaskExpandPlanEntity">
    <id property="id" column="ID" jdbcType="VARCHAR" />
    <result property="wfClassId" column="WF_CLASS_ID" jdbcType="INTEGER" />
    <result property="wfClassName" column="WF_CLASS_NAME" jdbcType="VARCHAR" />
    <result property="fieldKey" column="FIELD_KEY" jdbcType="VARCHAR" />
    <result property="fieldName" column="FIELD_NAME" jdbcType="VARCHAR" />
    <result property="fieldValue" column="FIELD_VALUE" jdbcType="VARCHAR" />
    <result property="fieldType" column="FIELD_TYPE" jdbcType="VARCHAR" />
    <result property="fieldStatus" column="FIELD_STATUS" jdbcType="VARCHAR" />
    <result property="fieldUrl" column="FIELD_URL" jdbcType="VARCHAR" />
    <result property="tenantId" column="tenant_id" jdbcType="VARCHAR" />
    <result property="isQueryCondition" column="is_query_condition" jdbcType="VARCHAR" />
  </resultMap>


  <select id="selectWfTaskExpandPlanCountByQueryCriteria" parameterType="com.tansun.wf.activiti.query.WfExpandPlanQuery" resultType="long">
    select count(distinct RES.ID_)
    <include refid="selectWfTaskExpandPlanByQueryCriteriaSql"/>
  </select>

  <select id="selectWfTaskExpandPlanByQueryCriteria" parameterType="com.tansun.wf.activiti.query.WfExpandPlanQuery" resultMap="taskExpandPlanResultMap">
    ${limitBefore}
    select distinct RES.*
    <if test="databaseType !='db2'">
      ${limitBetween}
    </if>
    <if test="databaseType =='db2'">
      , row_number() over (ORDER BY RES.ID ) rnk FROM ( select distinct RES.*
    </if>
    <include refid="selectWfTaskExpandPlanByQueryCriteriaSql"/>

    ${limitAfter}
  </select>

  <sql id="selectWfTaskExpandPlanByQueryCriteriaSql">
    from ${prefix}wf_task_expand_plan RES
    <where>
      <if test="wfClassId != null">
        RES.WF_CLASS_ID = #{wfClassId}
      </if>
      <if test="wfClassCode != null and wfClassCode !=''">
        RES.WF_CLASS_ID = (
          SELECT id FROM wf_process_classify WHERE code = #{wfClassCode}
          AND del_flag = '0'
        )
      </if>
      <if test="fieldKey != null">
        RES.FIELD_KEY = #{fieldKey}
      </if>

    </where>
    ORDER BY RES.field_value
  </sql>

    <select id="getExpandPlanByClassifyCodes" parameterType="java.util.List" resultMap="taskExpandPlanResultMap">
        select
            *
        from wf_task_expand_plan where field_status = '1'
        <if test="classifyCodes!=null and classifyCodes.size > 0">
            and wf_class_id in
            (SELECT id FROM wf_process_classify WHERE code in
            <foreach collection="classifyCodes" item="classifyCode"  open="(" separator="," close=")">
                #{classifyCode}
            </foreach>
            AND del_flag = '0')
        </if>
        order by field_value
    </select>

  <select id="getAllExpandPlanClassifyCount" resultType="long">
    SELECT count(distinct wf_class_id) from wf_task_expand_plan
  </select>

</mapper>
<!--        <property name="basePackage" value="com.tansun.wf.platform.mapper" />-->
<!--        <property name="sqlSessionFactoryBeanName" value="wfPlatformSqlSessionFactory" />-->
<!--    </bean>-->

    <bean class="com.tansun.wf.activiti.service.SendMailService">
        <property name="emailHost" value="${mail.emailHost:null}"/>
        <property name="emailPort" value="${mail.emailPort:null}"/>
        <property name="emailUserName" value="${mail.emailUserName:null}"/>
        <property name="emailPassword" value="${mail.emailPassword:null}"/>
    </bean>

    <bean id="httpServiceTaskDelegate" class="com.tansun.wf.decision.service.HttpServiceTaskDelegate">
        <property name="address" value="${java.service.address:null}"/>
    </bean>
</beans>
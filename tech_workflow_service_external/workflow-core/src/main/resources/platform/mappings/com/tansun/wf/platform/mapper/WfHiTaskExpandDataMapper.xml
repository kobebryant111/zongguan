  <select id="selectByHiTaskId" parameterType="com.tansun.wf.activiti.query.WfHiTaskQuery" resultMap="hiTaskExpandDataResultMap">
    SELECT
        ID,
        TASK_EXPAND_PLAN_ID,
        PROCESS_INST_ID,
        PROCESS_DEF_ID,
        TASK_ID,
        TASK_NODE_ID,
        FIELD01,
        FIELD02,
        FIELD03,
        FIELD04,
        FIELD05,
        FIELD06,
        FIELD07,
        FIELD08,
        FIELD09,
        FIELD10,
        FIELD11,
        FIELD12,
        FIELD13,
        FIELD14,
        FIELD15,
        FIELD16,
        FIELD17,
        FIELD18,
        FIELD19,
        FIELD20,
        COMMENT_MSG,
        OPINION,
        OPION,
        OPION_KEY,
        ASSIGNEE_ORG_NAME,
        ASSIGNEE_ORG_CODE,
        ASSIGNEE_DEPT_NAME,
        ASSIGNEE_DEPT_CODE,
        ASSIGNEE_ROLE_NAME,
        ASSIGNEE_ROLE_CODE,
        CANDIDATE_ORGS,
        CANDIDATE_DEPTS,
        CANDIDATE_ROLES,
        SELECT_USER_MODEL,
        IS_MULTI,
        ACT_BUTTON,
        FORM_SCENE,
        TASK_END_TIME,
        TASK_CREATE_TIME,
        IS_START_NODE,
        TASK_TYPE,
        TASK_NAME,
        START_USER_ORG_CODE,
        START_USER_PARENT_ORG_CODE,
        START_USER_ROLE_CODE,
        START_USER_DEPT_CODE,
        START_USER_ID,
        PROCESS_END_TIME,
        PROCESS_START_TIME,
        SUPER_PROCESS_INSTANCE_ID,
        PROCESS_CLASSIFY_CODE,
        PROCESS_NAME,
        PROCESS_CLASSIFY_ID,
        BUSINESS_KEY,
        PROCESS_DEF_KEY,
        TENANT_ID,
        START_USER_NAME
    FROM
        WF_HI_TASK_EXPAND_DATA
    <where>
      <if test="taskId!=null and taskId!=null">
        TASK_ID = #{taskId}
      </if>
      <if test="taskIds!=null and taskIds.size>0">
        TASK_ID IN
        <foreach collection="taskIds" item="taskId"  open="(" separator="," close=")">
          #{taskId}
        </foreach>
      </if>
    </where>
  </select>


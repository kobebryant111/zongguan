<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.tansun.wf.platform.mapper.ActRuTaskMapper">


    <update id="updateRuTaskAssignee"  parameterType="com.tansun.wf.activiti.model.RuTaskEntity" >
        update ACT_RU_TASK
        set  ASSIGNEE_= #{assignee}
        where ID_= #{taskId}
    </update>

</mapper>

# 生产环境下的配置文件
# 只是一个标志
ENV = 'production'
NODE_ENV = production

#规范： 属性名必须以VUE_APP_开头，比如VUE_APP_XXX
使用例子：process.env.VUE_APP_BASE_API
使用例子：在工程中使用process.env.VUE_APP_XXXX



# base api
VUE_APP_BASE_API = '/workflow-micro-service'
# 代理的请求地址
VUE_APP_BASE_HOST ='http://localhost:8081/workflow-micro-service'


VUE_CLI_BABEL_TRANSPILE_MODULES = true

# dev port 端口号
VUE_APP_BASE_PORT= 9529

# 设置 页面标题
VUE_APP_NAME ='流程管理平台'



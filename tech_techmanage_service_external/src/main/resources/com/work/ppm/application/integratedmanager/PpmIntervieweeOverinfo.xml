    <!-- 20220922修复 -->
    <!-- 根据人力需求ID查询已通过人数 -->
    <select id="queryCarryOutNum" parameterType="map" resultType="long">
        SELECT COUNT(1) FROM PPM_INTERVIEWEE_OVERINFO pio
        JOIN PPM_INTERVIEW_APPLY pia ON pia.INSTANCEID = pio.INSTANCEID
        WHERE pia.rl_id = #{rlId}  AND pio.INTERVIEWRESULT = 1
    </select>

    <!-- 根据身份证查询是否存在记录  K6991 2021-01-09-->
    <select id="getCheckedExistEntry" parameterType="ppmIntervieweeOverinfo" resultMap="PPMINTERVIEWEEOVERINFO_ALL">
        SELECT * FROM (
        SELECT INSTANCEID FROM PPM_INTERVIEWEE_OVERINFO WHERE IDCARD=#{idcard} ORDER BY ID DESC )
        WHERE ROWNUM=1
    </select>
    <!-- 根据身份证查询是否通过  ywwb436 -->
    <select id="getCheckedPassEntry" parameterType="ppmIntervieweeOverinfo" resultMap="PPMINTERVIEWEEOVERINFO_ALL">
        SELECT * FROM (
        SELECT INSTANCEID FROM PPM_INTERVIEWEE_OVERINFO WHERE isrz = 1 AND IDCARD=#{idcard} ORDER BY ID DESC )
        WHERE ROWNUM=1
    </select>
    <!-- 查询分页  2020-08-24 k6991  -->
    <select id="queryList" parameterType="map" resultMap="PPMINTERVIEWEEOVERINFO_ALL_EXT">
        SELECT o.id,
        o.msname,
        o.sex,
        o.idcard,
        o.birthday,
        o.workyears,
        o.suggestlevel,
        o.wbsid,
        o.position,
        o.jl,
        o.mspy,
        o.score,
        o.interviewresult,
        o.suggestprice,
        o.reason,
        o.instanceid,
        o.createtime,
        o.isrz,
        o.ms_date ,
        e.dictname positionname,
        e1.dictname interviewresultname
        FROM PPM_INTERVIEWEE_OVERINFO o
        left join eos_dict_entry e on e.dicttypeid='RLWBXQLX' and e.dictid=o.position
        left join eos_dict_entry e1 on e1.dicttypeid='NEW_BUSI_OUTSOURCE_INTERVRESULT' and e1.dictid=o.interviewresult
        <include refid="sql_select_condition"/>
        order by o.createtime desc
    </select>

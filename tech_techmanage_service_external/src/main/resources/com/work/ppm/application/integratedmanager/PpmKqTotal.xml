	<!--查询外包加班数据统计  k1327 2021-03-16 -->
	<select id="getOutOvertimeMonthData" parameterType="map" resultType="outOverTimeMonthData">
		select * from (
		select t.jobid,t.tmonth,t.overtime
		from ppm_kq_total t
		where t.jobid=#{jobid} and t.tyear=#{year}
		) pivot(
		sum(overtime) for tmonth in ('01' as jan,'02' as feb,'03' as mar,'04' as apr,'05' as may,'06' as jun,'07' as jul,'08' as aug,'09' as sep,'10' as oct,'11' as nov,'12' as dec,'年度' as year )
		)
	</select>
	<!--查询外包加班数据统计根据部门  k1327 2021-03-16 -->
	<select id="getOutOvertimeOrderByDep" parameterType="map" resultType="outOvertimeOrderData">
		select t.jobid,count(*) counts,round(sum(t.overtime)/count(*),2) avgscore from ppm_kq_total t
		where t.tyear=#{year} and t.deptno=#{deptno} group by t.jobid
		order by round(sum(t.overtime)/count(*),2) desc
	</select>
	<!--查询外包加班数据统计根据供应商 k1327 2021-03-16 -->
	<select id="getOutOvertimeOrderByOutsourceno" parameterType="map" resultType="outOvertimeOrderData">
		select t.jobid,count(*) counts,round(sum(t.overtime)/count(*),2) avgscore from ppm_kq_total t
		left join ppm_outsourcing_basic b on t.jobid=b.job_id
		where t.tyear=#{year} and b.outsource_no=#{outsourceno} group by t.jobid
		order by round(sum(t.overtime)/count(*),2) desc
	</select>
	<!--查询外包加班数据统计根据科技部 k1327 2021-03-16 -->
	<select id="getOutOvertimeOrder" parameterType="map" resultType="outOvertimeOrderData">
		select t.jobid,count(*) counts,round(sum(t.overtime)/count(*),2) avgscore from ppm_kq_total t
		left join comm_department d on t.deptno=d.depid
		where t.tyear=#{year} and d.adminid='7004' group by t.jobid
		order by round(sum(t.overtime)/count(*),2) desc
	</select>

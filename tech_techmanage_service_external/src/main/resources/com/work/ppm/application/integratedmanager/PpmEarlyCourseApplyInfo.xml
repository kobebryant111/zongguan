	<select id="queryBaseInfo" parameterType="ppmEarlyCourseApplyInfoView" resultMap="PPMEARLYCOURSEAPPLYINFO_ALL_EXT">
        SELECT 
			AI.ID,
			AI.PID,
			AI.INSTANCEID,
			AI.INTERVIEW_ID,
			AI.USER_NAME,
			AI.EARLY_ENTRY_TIME,
			AI.IS_COMPLEMENT,
			AI.CAMPAIGN_TIME,
			AI.CREATED_TIME,
			AI.CREATED_BY,
			AI.MODIFIED_TIME,
			AI.MODIFIED_BY,
			CA.APPLYER,
			CE.EMPNAME APPLYER_NAME,
			CA.DEPT_NO,
			CD.LOCATION DEPT_NAME,
			II.WBSID WBS_ID,
			OI.OUTSOURCNAME OUT_SOURCE_NAME,
			II.WORKYEARS WORK_YEARS,
			II.SUGGESTPRICE SUGGEST_PRICE,
			DE.DICTNAME POSITION
		FROM PPM_EARLY_COURSE_APPLY_INFO AI
			LEFT JOIN PPM_EARLY_COURSE_APPLY CA ON CA.ID = AI.PID
			LEFT JOIN PPM_INTERVIEWEE_OVERINFO II ON II.ID = AI.INTERVIEW_ID
			LEFT JOIN COMM_EMPLOYEE CE ON CA.APPLYER = CE.BADGE
			LEFT JOIN COMM_DEPARTMENT CD ON CA.DEPT_NO = CD.DEPID
			LEFT JOIN PPM_OUTSOURCING_INFO OI ON II.WBSID = OI.ID
			LEFT JOIN EOS_DICT_ENTRY DE ON (II.POSITION = DE.DICTID AND DE.DICTTYPEID = 'RLWBXQLX')
		WHERE AI.ID = #{id}
    </select>
	
	<select id="queryBaseInfoList" parameterType="ppmEarlyCourseApplyInfoView" resultMap="PPMEARLYCOURSEAPPLYINFO_ALL_EXT">
		SELECT 
			AI.ID,
			AI.PID,
			AI.INSTANCEID,
			AI.INTERVIEW_ID,
			AI.USER_NAME,
			AI.EARLY_ENTRY_TIME,
			AI.IS_COMPLEMENT,
			AI.CAMPAIGN_TIME,
			AI.CREATED_TIME,
			AI.CREATED_BY,
			AI.MODIFIED_TIME,
			AI.MODIFIED_BY,
			AI.CARD_NO,
			CA.APPLYER,
			CE.EMPNAME APPLYER_NAME,
			CA.DEPT_NO,
			CD.LOCATION DEPT_NAME,
			II.WBSID WBS_ID,
			OI.OUTSOURCNAME OUT_SOURCE_NAME,
			II.WORKYEARS WORK_YEARS,
			II.SUGGESTPRICE SUGGEST_PRICE,
			DE.DICTNAME POSITION
		FROM PPM_EARLY_COURSE_APPLY_INFO AI
			LEFT JOIN PPM_EARLY_COURSE_APPLY CA ON CA.ID = AI.PID
			LEFT JOIN PPM_INTERVIEWEE_OVERINFO II ON II.ID = AI.INTERVIEW_ID
			LEFT JOIN COMM_EMPLOYEE CE ON CA.APPLYER = CE.BADGE
			LEFT JOIN COMM_DEPARTMENT CD ON CA.DEPT_NO = CD.DEPID
			LEFT JOIN PPM_OUTSOURCING_INFO OI ON II.WBSID = OI.ID
			LEFT JOIN EOS_DICT_ENTRY DE ON (II.POSITION = DE.DICTID AND DE.DICTTYPEID = 'RLWBXQLX')
		<trim prefix="WHERE" suffixOverrides="AND">
            <if test="userName != null and userName != '' ">AI.USER_NAME = #{userName} AND</if>
            <if test="cardNo != null and cardNo != '' ">AI.CARD_NO = #{cardNo} AND</if>
            <if test="isComplement != null and isComplement != '' ">AI.IS_COMPLEMENT = #{isComplement} AND</if>
            <if test="deptNo != null and deptNo != '' ">CA.DEPT_NO = #{deptNo} AND</if>
            <if test="deptNoQue != null and deptNoQue != '' ">CA.DEPT_NO = #{deptNoQue} AND</if>
            <if test="wbsId != null and wbsId != '' ">II.WBSID = #{wbsId} AND</if>
            <if test="instanceid != null and instanceid != '' ">AI.INSTANCEID = #{instanceid} AND</if>
            <if test="pid != null and pid != '' ">AI.PID = #{pid} AND</if>
			<if test="deptId != null  and deptId != '' " >CA.DEPTNO in (${deptId}) AND </if>
			<if test="applyer != null and applyer != '' " > CA.APPLYER = #{applyer} AND </if>
			<if test="applyerName != null and applyerName != '' " > CE.EMPNAME = #{applyerName} AND </if>
			<if test="applyerValue != null and applyerValue != '' " > ( CE.EMPNAME = #{applyerValue} OR CA.APPLYER = #{applyerValue} ) AND</if>
			<if test="campaignTimeVal != null and campaignTimeVal != '' " > TO_CHAR(AI.CAMPAIGN_TIME,'yyyy-MM-dd') &lt;= #{campaignTimeVal} AND </if>
        </trim>
		ORDER BY AI.ID DESC
	</select>


	<!--通过id查询  ywwb905 2022-12-08 -->
	<select id="queryBaseInfo" parameterType="ppmSupplierAssessExt" resultMap="PPMSUPPLIERASSESS_ALL_EXT">
        SELECT 
			SA.ID,
			SA.ASSESS_YEAR,
			SA.SUPPLIER_ID,
			SA.INSTANCEID,
			SA.ASSESS_TYPE,
			SA.ASSESS_SCORES,
			SA.ASSESS_SCORE_SUM,
			SA.ASSESS_LEVEL,
			SA.PM_TYPE,
			E.DICTNAME PM_TYPE_NAME,
			SA.PM_ID,
			SA.DEPT_ID,
			SA.PROJECT_ID,
			SA.PROJECT_NUMBER,
			SA.EXIST_QUESTION,
			SA.IS_SYNC,
			SA.STATE,
			SA.STATE_NAME,
			SA.CURRENT_ID,
			SA.CURRENT_NAME,
			SA.CREATED_TIME,
			SA.CREATED_BY,
			SA.MODIFIED_TIME,
			SA.MODIFIED_BY,
			CE.EMPNAME PM_NAME,
			OI.OUTSOURCNAME SUPPLIER_NAME,
			CD.LOCATION DEPT_NAME,
			BS.NAME PROJECT_NAME
		FROM PPM_SUPPLIER_ASSESS SA
			LEFT JOIN COMM_EMPLOYEE CE ON SA.PM_ID = CE.BADGE
			LEFT JOIN PPM_OUTSOURCING_INFO OI ON SA.SUPPLIER_ID = OI.ORGCODE
			LEFT JOIN PPM_PROJECT_INFO BS ON BS.ID = SA.PROJECT_ID
			LEFT JOIN COMM_DEPARTMENT CD ON SA.DEPT_ID = CD.DEPID
			LEFT JOIN EOS_DICT_ENTRY E ON E.DICTTYPEID='PROJECT_PM_TYPE' AND SA.PM_TYPE=E.DICTID
			
		<trim prefix="WHERE" suffixOverrides="AND">
			<if test="id == null and instanceid == null " > SA.ID = '' AND </if>
            <if test="id != null and id != '' " > SA.ID = #{id} AND </if>
			<if test="instanceid != null and instanceid != '' " > SA.INSTANCEID = #{instanceid} AND </if>
        </trim>
    </select>
	
	<select id="queryBaseInfoList" parameterType="ppmSupplierAssessExt" resultMap="PPMSUPPLIERASSESS_ALL_EXT">
		SELECT 
			SA.ID,
			SA.INSTANCEID,
			SA.ASSESS_YEAR,
			SA.SUPPLIER_ID,
			SA.ASSESS_TYPE,
			SA.ASSESS_SCORES,
			SA.ASSESS_SCORE_SUM,
			SA.ASSESS_LEVEL,
			SA.PM_TYPE,
			E.DICTNAME PM_TYPE_NAME,
			SA.PM_ID,
			SA.DEPT_ID,
			SA.PROJECT_ID,
			SA.PROJECT_NUMBER,
			SA.EXIST_QUESTION,
			SA.IS_SYNC,
			SA.STATE,
			SA.STATE_NAME,
			SA.CURRENT_ID,
			SA.CURRENT_NAME,
			SA.CREATED_TIME,
			SA.CREATED_BY,
			SA.MODIFIED_TIME,
			SA.MODIFIED_BY,
			CE.EMPNAME PM_NAME,
			OI.OUTSOURCNAME SUPPLIER_NAME,
			CD.LOCATION DEPT_NAME,
			BS.NAME PROJECT_NAME
		FROM PPM_SUPPLIER_ASSESS SA
			LEFT JOIN COMM_EMPLOYEE CE ON SA.PM_ID = CE.BADGE
			LEFT JOIN PPM_OUTSOURCING_INFO OI ON SA.SUPPLIER_ID = OI.ORGCODE
			LEFT JOIN PPM_PROJECT_INFO BS ON BS.ID = SA.PROJECT_ID
			LEFT JOIN COMM_DEPARTMENT CD ON SA.DEPT_ID = CD.DEPID
			LEFT JOIN EOS_DICT_ENTRY E ON E.DICTTYPEID='PROJECT_PM_TYPE' AND SA.PM_TYPE=E.DICTID
		<trim prefix="WHERE" suffixOverrides="AND">
            <if test="pmId != null and pmId != '' ">SA.PM_ID = #{pmId} AND</if>
            <if test="deptId != null and deptId != '' ">SA.DEPT_ID = #{deptId} AND</if>
            <if test="deptIdQue != null and deptIdQue != '' ">SA.DEPT_ID = #{deptIdQue} AND</if>
            <if test="pmValue != null and pmValue != '' ">(SA.PM_ID = #{pmValue} OR CE.EMPNAME = #{pmValue} ) AND</if>
            <if test="assessYear != null and assessYear != '' ">SA.ASSESS_YEAR = #{assessYear} AND</if>
            <if test="supplierId != null and supplierId != '' ">SA.SUPPLIER_ID = #{supplierId} AND</if>
			<if test="assessLevel != null and assessLevel != '' " > SA.ASSESS_LEVEL = #{assessLevel} AND </if>
			<if test="state != null and state != '' " > SA.STATE = #{state} AND </if>
			<if test="projectNumber != null and projectNumber != '' " > SA.PROJECT_NUMBER = #{projectNumber} AND </if>
			<if test="assessType != null and assessType != '' " > SA.ASSESS_TYPE = #{assessType} AND </if>
			<if test="instanceid != null and instanceid != '' " > SA.INSTANCEID = #{instanceid} AND </if>
			<if test="projectId != null " > SA.PROJECT_ID = #{projectId} AND </if>
			<if test="projectName != null and projectName != ''" > BS.NAME = #{projectName} AND </if>
			<if test="projectNameVal != null and projectNameVal != ''" > BS.NAME like '%'||#{projectNameVal}||'%' AND </if>
        </trim>
		ORDER BY SA.ID DESC
	</select>
	
	<select id="countSupplierPmRL" parameterType="ppmSupplierAssessExt" resultMap="PPMSUPPLIERASSESS_ALL_EXT">	
		SELECT 
			SUPPLIERID,
			PM_ID,
			PERSON_COUNT
		FROM (
			SELECT 
				OUTSOURCE_NO SUPPLIERID,
				PERSON_IN_CHARGE PM_ID,
				COUNT(*) PERSON_COUNT
			FROM
				(
				SELECT 
					OUTSOURCE_NO ,
					PERSON_IN_CHARGE ,
					OUTSOURCE_TYPE 
				FROM 
					PPM_OUTSOURCING_BASIC T 
				WHERE 
					T.OUTSOURCE_TYPE = '1' 
					AND TO_CHAR(T.ENTRY_TIME,'yyyyMMdd') &lt;= #{endTime} 
					AND (TO_CHAR(T.Leaving_Time,'yyyyMMdd') &lt; #{startTime} OR T.LEAVING_TIME is null)
				)
			GROUP BY OUTSOURCE_NO,PERSON_IN_CHARGE
		) S WHERE S.SUPPLIERID = #{supplierId} 
		
	</select>
	
	


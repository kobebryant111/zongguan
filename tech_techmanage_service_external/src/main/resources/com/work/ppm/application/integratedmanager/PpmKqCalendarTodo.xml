            <if test="id != null " > ID=#{id} AND</if>
            <if test="instanceid != null  and instanceid != '' " > INSTANCEID=#{instanceid}  AND </if>
        </trim>
    </update>

    <!--通过id批量删除  ywwb436 2022-07-08 -->
    <delete id="deleteById" parameterType="ppmKqCalendarTodo">
        DELETE
        FROM
        PPM_KQ_CALENDAR_TODO
        WHERE ID = #{id}
    </delete>

</mapper>

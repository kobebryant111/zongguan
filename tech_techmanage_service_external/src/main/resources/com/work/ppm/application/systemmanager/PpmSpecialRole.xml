<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- author:k6991 2021-04-26 -->
<mapper namespace="com.work.ppm.application.model.systemmanager.PpmSpecialRole">
    <resultMap type="ppmSpecialRole" id="PPMSPECIALROLE_ALL">
        <result property="id" column="ID"/>
        <result property="roleId" column="ROLE_ID"/>
    </resultMap>

    <!-- 所有字段名称 -->
    <sql id="sql_flied_all">
        ID,
        ROLE_ID
    </sql>
    <sql id="sql_select_condition">
        <trim prefix="WHERE" suffixOverrides="AND">
            <if test="id != null ">ID = #{id} AND</if>
            <if test="roleId != null  and roleId != '' ">ROLE_ID = #{roleId} AND</if>
        </trim>
    </sql>


    <!-- 新增  2021-04-26 k6991  -->
    <insert id="addPojo" parameterType="ppmSpecialRole">
        INSERT INTO PPM_SPECIAL_ROLE (
        <trim suffixOverrides=",">
            <if test="id != null ">ID ,</if>
            <if test="roleId != null  and roleId != '' ">ROLE_ID ,</if>
        </trim>
        )
        VALUES(
        <trim suffixOverrides=",">
            <if test="id != null ">#{id} ,</if>
            <if test="roleId != null  and roleId != '' ">#{roleId} ,</if>
        </trim>
        )
    </insert>

    <!--通过id查询  k6991 2021-04-26 -->
    <select id="queryDetail" parameterType="ppmSpecialRole" resultMap="PPMSPECIALROLE_ALL">
        SELECT
        <include refid="sql_flied_all"/>
        FROM PPM_SPECIAL_ROLE WHERE ID=#{id}
    </select>

    <!--查询集合  k6991 2021-04-26 -->
    <select id="getList" parameterType="ppmSpecialRole" resultMap="PPMSPECIALROLE_ALL">
        SELECT
        <include refid="sql_flied_all"/>
        FROM PPM_SPECIAL_ROLE
        <include refid="sql_select_condition"/>
    </select>
    <!-- update sql -->
    <sql id="update_pojo_sql">
        <trim prefix="SET" suffixOverrides=",">
            <if test="id != null ">ID=#{id} ,</if>
            <if test="roleId != null  and roleId != '' ">ROLE_ID=#{roleId} ,</if>
        </trim>
    </sql>

    <!--通过id编辑 k6991 2021-04-26 -->
    <update id="updatePojo" parameterType="ppmSpecialRole">
        UPDATE
        PPM_SPECIAL_ROLE
        <include refid="update_pojo_sql"/>
        WHERE ID=#{id}
    </update>

    <!--通过id批量删除  k6991 2021-04-26 -->
    <delete id="deleteById" parameterType="ppmSpecialRole">
        DELETE
        FROM
        PPM_SPECIAL_ROLE
        WHERE ROLE_ID=#{roleId}
    </delete>

</mapper>

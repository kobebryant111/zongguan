<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- author:ywwb905 2023-04-24 -->
<!--  外包人员考勤年假记录表 查询脚本 -->
<mapper namespace="com.work.ppm.application.model.integratedmanager.PpmKqAnnualVacation">
	 <resultMap type="ppmKqAnnualVacation" id="PPMKQANNUALVACATION_ALL">
        <result property="id" column="ID" />
		<result property="jobId" column="JOB_ID" />
		<result property="annualVacationDate" column="ANNUAL_VACATION_DATE" />
		<result property="annualVacationSurplus" column="ANNUAL_VACATION_SURPLUS" />
		<result property="annualVacationDays" column="ANNUAL_VACATION_DAYS" />
		<result property="annualVacationDateValue" column="ANNUAL_VACATION_DATE_VALUE" />
		<result property="entryTime" column="ENTRY_TIME," />
		
     </resultMap>

     <!-- 所有字段名称 -->
    <sql id="sql_flied_all">
        ID,
		JOB_ID,
		ANNUAL_VACATION_DATE,
		ANNUAL_VACATION_SURPLUS,
		ANNUAL_VACATION_DAYS
    </sql>
    <sql id="sql_select_condition">
        <trim prefix="WHERE" suffixOverrides="AND">
            <if test="id != null  and id != '' " > ID = #{id} AND </if>
			<if test="jobId != null  and jobId != '' " > JOB_ID = #{jobId} AND </if>
			<if test="annualVacationDate != null " > ANNUAL_VACATION_DATE = #{annualVacationDate} AND </if>
			<if test="annualVacationSurplus != null " > ANNUAL_VACATION_SURPLUS = #{annualVacationSurplus} AND </if>
			<if test="annualVacationDays != null " > ANNUAL_VACATION_DAYS = #{annualVacationDays} AND </if>
        </trim>
    </sql>
    <!-- 查询分页  2023-04-24 ywwb905  -->
    <select id="queryPagerList" parameterType="map" resultMap="PPMKQANNUALVACATION_ALL">
        SELECT
        <include refid="sql_flied_all" />
        FROM PPM_KQ_ANNUAL_VACATION
        <include refid="sql_select_condition" />
    </select>

    <!-- 新增  2023-04-24 ywwb905  -->
    <insert id="addPojo" parameterType="ppmKqAnnualVacation">
        INSERT INTO PPM_KQ_ANNUAL_VACATION (
        <trim suffixOverrides=",">
			<if test="id != null  and id != '' " > ID , </if>
			<if test="jobId != null  and jobId != '' " > JOB_ID , </if>
			<if test="annualVacationDate != null " > ANNUAL_VACATION_DATE , </if>
			<if test="annualVacationSurplus != null " > ANNUAL_VACATION_SURPLUS , </if>
			<if test="annualVacationDays != null " > ANNUAL_VACATION_DAYS , </if>
        </trim>
        )
        VALUES(
        <trim suffixOverrides=",">
			<if test="id != null  and id != '' " > #{id} , </if>
			<if test="jobId != null  and jobId != '' " > #{jobId} , </if>
			<if test="annualVacationDate != null " > #{annualVacationDate} , </if>
			<if test="annualVacationSurplus != null " > #{annualVacationSurplus} , </if>
			<if test="annualVacationDays != null " > #{annualVacationDays} , </if>
        </trim>
        )
    </insert>

    <!--通过id查询  ywwb905 2023-04-24 -->
    <select id="queryDetail" parameterType="ppmKqAnnualVacation" resultMap="PPMKQANNUALVACATION_ALL">
        SELECT
        <include refid="sql_flied_all" />
        FROM PPM_KQ_ANNUAL_VACATION  
		<trim prefix="WHERE" suffixOverrides="OR">
            <if test="id != null  and id != '' " > ID = #{id} OR </if>
			<if test="jobId != null  and jobId != '' " > JOB_ID = #{jobId} OR </if>
        </trim>
    </select>

     <!--查询集合  ywwb905 2023-04-24 -->
    <select id="getList" parameterType="ppmKqAnnualVacation" resultMap="PPMKQANNUALVACATION_ALL">
        SELECT
        <include refid="sql_flied_all" />
        FROM PPM_KQ_ANNUAL_VACATION
        <include refid="sql_select_condition" />
    </select>
    <!-- update sql -->
    <sql id="update_pojo_sql">
        <trim prefix="SET" suffixOverrides=",">
            <if test="id != null  and id != '' " > ID=#{id} , </if>
			<if test="jobId != null  and jobId != '' " > JOB_ID=#{jobId} , </if>
			<if test="annualVacationDate != null " > ANNUAL_VACATION_DATE=#{annualVacationDate} , </if>
			<if test="annualVacationSurplus != null " > ANNUAL_VACATION_SURPLUS=#{annualVacationSurplus} , </if>
			<if test="annualVacationDays != null " > ANNUAL_VACATION_DAYS=#{annualVacationDays} , </if>
        </trim>
    </sql>

    <!--通过id编辑 ywwb905 2023-04-24 -->
    <update id="updatePojo" parameterType="ppmKqAnnualVacation">
        UPDATE
        PPM_KQ_ANNUAL_VACATION
        <include refid="update_pojo_sql" />
        <trim prefix="WHERE" suffixOverrides="OR">
            <if test="id != null  and id != '' " > ID = #{id} OR </if>
			<if test="jobId != null  and jobId != '' " > JOB_ID = #{jobId} OR </if>
        </trim>
    </update>

    <!--通过id批量删除  ywwb905 2023-04-24 -->
    <delete id="deleteById" parameterType="ppmKqAnnualVacation">
        DELETE
        FROM
        PPM_KQ_ANNUAL_VACATION
        WHERE ID = #{id}
    </delete>
	
	<!--通过id编辑 ywwb905 2023-04-24 -->
    <update id="updateVacationList" parameterType="ppmKqAnnualVacation">
        UPDATE
        PPM_KQ_ANNUAL_VACATION
        <include refid="update_pojo_sql" />
        WHERE ID=#{id}
    </update>
	
	<select id="getQuarzList" parameterType="ppmKqAnnualVacation" resultMap="PPMKQANNUALVACATION_ALL">
        SELECT
			VA.ID,
			OB.JOB_ID,
			OB.ENTRY_TIME,
			VA.ANNUAL_VACATION_DATE,
			VA.ANNUAL_VACATION_SURPLUS,
			VA.ANNUAL_VACATION_DAYS
        FROM PPM_OUTSOURCING_BASIC OB
			LEFT JOIN PPM_KQ_ANNUAL_VACATION VA ON OB.JOB_ID = VA.JOB_ID AND OB.STATE = '0'
        WHERE OB.OUTSOURCE_TYPE = '1' AND  VA.VA.ANNUAL_VACATION_DATE &lt;= TO_DATE(#{annualVacationDateValue},'yyyy-MM-dd')
    </select>      
	

</mapper>

		<update id="updatePojoByOnlineno" parameterType="map">
			update ppm_online_orgarea a
			   set a.isonline=#{isonline}
			 where a.onlineno=#{onlineno}
			  and a.projectno=#{projectno}
		</update>

	<resultMap id="QUERYSYSNOFORONLINENO_MAP" type="ppmOnlineOrgareaInfo">
		<result column="SYSNO" property="sysNo" />
		<result column="PROJECTNAME" property="projectname" />
	</resultMap>
	<select id="querySysNoForOnlineno" parameterType="map" resultMap="QUERYSYSNOFORONLINENO_MAP">
		SELECT P.SYSNO,P.PROJECTNAME
		FROM PPM_PROJECT P
		LEFT JOIN
		PPM_ONLINE_ORGAREA A ON(P.SUBPROJECTNO=A.PROJECTNO)
		LEFT JOIN AAP_SYSTEM AA ON (P.SYSNO = AA.SYSTEM_ID)
		LEFT JOIN AAP_SYSTEM_RESPONSIBILITY R ON (AA.RES_ID = R.RES_ID)
		LEFT JOIN COMM_DEPARTMENT D ON (D.DEPID = R.TEC_DEP)
		LEFT JOIN COMM_ORGANIZATION N ON (D.COMPID = N.COMPID)

		WHERE A.ONLINENO = #{onlineno}
		AND N.LOCATION LIKE '%分行%'
	</select>


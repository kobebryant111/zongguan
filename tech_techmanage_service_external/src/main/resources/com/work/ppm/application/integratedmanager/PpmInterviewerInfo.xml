<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- author:k6991 2020-08-24 -->
<mapper namespace="com.work.ppm.application.model.integratedmanager.PpmInterviewerInfo">
	 <resultMap type="ppmInterviewerInfo" id="PPMINTERVIEWERINFO_ALL">
        <result property="id" column="ID" />
		<result property="instanceid" column="INSTANCEID" />
		<result property="msgid" column="MSGID" />
		<result property="msgname" column="MSGNAME" />
		<result property="msgdeptname" column="MSGDEPTNAME" />
		<result property="msgdeptno" column="MSGDEPTNO" />
		
     </resultMap>

     <!-- 所有字段名称 -->
        <sql id="sql_flied_all">
        	ID,
			INSTANCEID,
			MSGID,
			MSGNAME,
			MSGDEPTNAME,
			MSGDEPTNO
        </sql>
        <sql id="sql_select_condition">
            <trim prefix="WHERE" suffixOverrides="AND">
                <if test="id != null  and id != '' " > ID = #{id} AND </if>
				<if test="instanceid != null  and instanceid != '' " > INSTANCEID = #{instanceid} AND </if>
				<if test="msgid != null  and msgid != '' " > MSGID = #{msgid} AND </if>
				<if test="msgname != null  and msgname != '' " > MSGNAME = #{msgname} AND </if>
				<if test="msgdeptname != null  and msgdeptname != '' " > MSGDEPTNAME = #{msgdeptname} AND </if>
				<if test="msgdeptno != null  and msgdeptno != '' " > MSGDEPTNO = #{msgdeptno} AND </if>
				
            </trim>
        </sql>
    	<!-- 查询分页  2020-08-24 k6991  -->
        <select id="queryPagerList" parameterType="map" resultMap="PPMINTERVIEWERINFO_ALL">
        	SELECT
            <include refid="sql_flied_all" />
            FROM PPM_INTERVIEWER_INFO
            <include refid="sql_select_condition" />
        </select>

        <!-- 新增  2020-08-24 k6991  -->
        <insert id="addPojo" parameterType="ppmInterviewerInfo">
    		INSERT INTO PPM_INTERVIEWER_INFO (
    		<trim suffixOverrides=",">
    		 <if test="id != null  and id != '' " > ID , </if>
				<if test="instanceid != null  and instanceid != '' " > INSTANCEID , </if>
				<if test="msgid != null  and msgid != '' " > MSGID , </if>
				<if test="msgname != null  and msgname != '' " > MSGNAME , </if>
				<if test="msgdeptname != null  and msgdeptname != '' " > MSGDEPTNAME , </if>
				<if test="msgdeptno != null  and msgdeptno != '' " > MSGDEPTNO , </if>
				
              </trim>
    		)
    		VALUES(
    		<trim suffixOverrides=",">
    		 <if test="id != null  and id != '' " > #{id} , </if>
				<if test="instanceid != null  and instanceid != '' " > #{instanceid} , </if>
				<if test="msgid != null  and msgid != '' " > #{msgid} , </if>
				<if test="msgname != null  and msgname != '' " > #{msgname} , </if>
				<if test="msgdeptname != null  and msgdeptname != '' " > #{msgdeptname} , </if>
				<if test="msgdeptno != null  and msgdeptno != '' " > #{msgdeptno} , </if>
				
            </trim>
    		)
        </insert>

        <!--通过id查询  k6991 2020-08-24 -->
        <select id="queryDetail" parameterType="ppmInterviewerInfo" resultMap="PPMINTERVIEWERINFO_ALL">
        	SELECT
        	<include refid="sql_flied_all" />
        	FROM PPM_INTERVIEWER_INFO
			<trim prefix="WHERE" suffixOverrides="AND">
				<if test="id != null  and id != '' " > ID=#{id} AND </if>
				<if test="instanceid != null  and instanceid != '' " > INSTANCEID=#{instanceid} AND </if>
				<if test="msgid != null  and msgid != '' " > MSGID=#{msgid} AND </if>
				<if test="msgdeptno != null  and msgdeptno != '' " > MSGDEPTNO=#{msgdeptno} AND </if>
				<if test="true" > ROWNUM=1 AND </if>
			</trim>
        </select>

         <!--查询集合  k6991 2020-08-24 -->
        <select id="getList" parameterType="map" resultMap="PPMINTERVIEWERINFO_ALL">
        	SELECT
        	<include refid="sql_flied_all" />
        	FROM PPM_INTERVIEWER_INFO
        	<include refid="sql_select_condition" />
        </select>
        <!-- update sql -->
        <sql id="update_pojo_sql">
        	<trim prefix="SET" suffixOverrides=",">
        		<if test="id != null  and id != '' " > ID=#{id} , </if>
				<if test="instanceid != null  and instanceid != '' " > INSTANCEID=#{instanceid} , </if>
				<if test="msgid != null  and msgid != '' " > MSGID=#{msgid} , </if>
				<if test="msgname != null  and msgname != '' " > MSGNAME=#{msgname} , </if>
				<if test="msgdeptname != null  and msgdeptname != '' " > MSGDEPTNAME=#{msgdeptname} , </if>
				<if test="msgdeptno != null  and msgdeptno != '' " > MSGDEPTNO=#{msgdeptno} , </if>
				
            </trim>
        </sql>

        <!--通过id编辑 k6991 2020-08-24 -->
    	<update id="updatePojo" parameterType="ppmInterviewerInfo">
        	UPDATE
        	PPM_INTERVIEWER_INFO
        	<include refid="update_pojo_sql" />
        	WHERE ID=#{id}
        </update>

        <delete id="deleteById" parameterType="ppmInterviewerInfo">
        	DELETE FROM PPM_INTERVIEWER_INFO WHERE id=#{id}
        </delete>

        <delete id="deleteByInstanceId" parameterType="ppmInterviewerInfo">
        	DELETE FROM PPM_INTERVIEWER_INFO WHERE INSTANCEID=#{instanceid}
        </delete>

</mapper>

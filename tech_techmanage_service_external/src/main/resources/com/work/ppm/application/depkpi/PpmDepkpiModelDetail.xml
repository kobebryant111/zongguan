    <select id="queryDepModelTargetList" resultMap="PPMDEPKPIMODELDETAIL_ALL_EXT">
        SELECT
        T1.ID,
        T1.MODELID,
        T1.TARGETID,
        T1.PARENTID,
        T1.BASEPOINT,
        T1.HASSON
        ,T2.NAME TARGETNAME
        ,T2.LEVELNUM LEVELNUM
        ,T2.TARGETTYPE TARGETTYPE
        ,T2.DEPID DEPID
        ,T2.EVALTYPE EVALTYPE
        ,T2.SELFEVAL SELFEVAL
        ,T2.MAXPOINT MAXPOINT
        ,T2.MINPOINT MINPOINT
        FROM PPM_DEPKPI_MODEL_DETAIL T1
        LEFT JOIN PPM_DEPKPI_TARGET T2
        ON T1.TARGETID=T2.ID
        WHERE T1.MODELID=#{modelid}
        order by T1.ID asc
    </select>


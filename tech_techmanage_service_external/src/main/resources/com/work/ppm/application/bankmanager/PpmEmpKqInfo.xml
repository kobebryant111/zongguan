	<select id="empQueryDetailObject" parameterType="ppmEmpKqInfo" resultMap="PPMEMPKQINFO_ALL">
        SELECT
        <include refid="sql_flied_all" />
        FROM PPM_EMP_KQ_INFO
        WHERE 
		JOB_ID = #{jobId} AND 
		USER_NAME = #{userName} AND 
		ATTENDANCE_MONTH = #{attendanceMonth}
    </select>
	
	
	<select id="empQueryBaseInfoList" parameterType="ppmEmpKqInfoView" resultMap="PPMEMPKQINFO_ALL_EXT">
		SELECT
		KI.ID,
		KI.JOB_ID,
		KI.USER_NAME,
		KI.ATTENDANCE_MONTH,
		KI.OVERTIME_HOURS,
		KI.WORKTIME_HOURS,
		KI.FORGET_CLOCK_IN_NUMBER,
		KI.BELATE_NUMBER,
		KI.LEAVE_EARLY_NUMBER,
		KI.ABSENT_NUMBER,
		KI.LEAVE_NUMBER,
		KI.REQUIRED_ATTENDANCE_DAYS,
		KI.ACTUAL_ATTENDANCE_DAYS,
		KI.WHETHER_UPDATE,
		KI.CREATED_TIME,
		KI.CREATED_BY,
		CM.Depid DEPT_ID,
		CD.LOCATION DEPT_NAME,
		CM.REPORTTO PM_ID,
		(select EMPNAME from COMM_EMPLOYEE em where em.eid = CM.Reportto) PM_NAME,
		CM.CERTIFICATE_NUMBER,
		CM.EMPSTATUS STATE,
		E4.DICTNAME STATENAME
		FROM PPM_EMP_KQ_INFO KI
		LEFT JOIN COMM_EMPLOYEE CM ON KI.JOB_ID = CM.BADGE
		LEFT JOIN COMM_DEPARTMENT CD ON CM.Depid = CD.DEPID
		LEFT JOIN EOS_DICT_ENTRY E4 ON CM.EMPSTATUS = E4.DICTID AND E4.DICTTYPEID = 'COMM_EMPSTATUS'
		<trim prefix="WHERE" suffixOverrides="AND">
            <if test="attendanceMonth != null and attendanceMonth != '' ">KI.ATTENDANCE_MONTH = #{attendanceMonth} AND</if>
            <if test="userName != null and userName != '' ">KI.USER_NAME like '%'||#{userName}||'%' AND</if>
            <if test="deptId != null and deptId != '' ">CD.Depid = #{deptId} AND</if>
            <if test="deptId == null or deptId == '' ">CD.Depid IN (
				SELECT DEPID FROM COMM_DEPARTMENT CD
				<trim prefix="WHERE" suffixOverrides="AND">
					<if test="jobId != null and jobId != '' ">
						CD.ADMINID in(
						SELECT ADMINID
						FROM COMM_DEPARTMENT
						WHERE DEPID = (
						SELECT DEPID FROM COMM_EMPLOYEE WHERE BADGE = #{jobId}
						)
						UNION ALL
						SELECT ADMINID FROM COMM_DEPARTMENT WHERE ADMINID =#{jobId}
						group  by ADMINID
						UNION ALL
						SELECT ADMINID
						FROM COMM_DEPARTMENT
						WHERE DEPID =#{jobId}
						)
						AND
					</if>
				</trim>
				) AND</if>
        </trim>
		ORDER BY KI.ID DESC
	</select>


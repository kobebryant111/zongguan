	<select id="getDepCenList" parameterType="ppmKpiDepRole" resultMap="PPMKPIDEPROLE_ALL">
		select to_char(d.depid) depid,m.centerid,e.badge director,m.userid depcharge,
		c.resuserid centercharge,'1' sign
		from comm_department d
		left join comm_employee e on d.director=e.eidhr
		left join ppm_da_dept_manager m on to_char(d.depid)=m.deptid
		left join ppm_da_center c on m.centerid=to_char(c.id)
		where d.adminid='7004' and d.isdisabled='0'
		union
		select '' depid,to_char(c.id) centerid,'' director,'' depcharge,c.resuserid centercharge,'2' sign
		from ppm_da_center c
		union
		select to_char(d.depid) depid,m.centerid,e.badge director,m.userid depcharge,
		c.resuserid centercharge,'3' sign
		from comm_department d
		left join comm_employee e on d.director=e.eidhr
		left join ppm_da_dept_manager m on to_char(d.depid)=m.deptid
		left join ppm_da_center c on m.centerid=to_char(c.id)
		where d.depid='7004' and d.isdisabled='0'
	</select>


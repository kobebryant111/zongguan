				<if test="createdTime != null " > CREATED_TIME=#{createdTime} , </if>
				<if test="createdBy != null  and createdBy != '' " > CREATED_BY=#{createdBy} , </if>
				<if test="modifiedTime != null " > MODIFIED_TIME=#{modifiedTime} , </if>
				<if test="modifiedBy != null  and modifiedBy != '' " > MODIFIED_BY=#{modifiedBy} , </if>
				
        </trim>
    </sql>

    <!--通过id编辑 ywwb905 2023-05-19 -->
    <update id="updatePojo" parameterType="ppmAccessCardApply">
        UPDATE
        PPM_ACCESS_CARD_APPLY
        <include refid="update_pojo_sql" />
        <trim prefix="WHERE" suffixOverrides="AND">
            <if test="id != null  and id != '' " > ID = #{id} AND </if>
			<if test="instanceId != null  and instanceId != '' " > INSTANCE_ID = #{instanceId} AND </if>
			<if test="id == null  and instanceId == null " >ID = '' AND</if>
        </trim>
    </update>

    <!--通过id批量删除  ywwb905 2023-05-19 -->
    <delete id="deleteById" parameterType="ppmAccessCardApply">
        DELETE
        FROM
        PPM_ACCESS_CARD_APPLY
        WHERE ID = #{id}
    </delete>
	
	<!--通过id批量删除  ywwb905 2023-05-19 -->
    <delete id="deleteByInstanceId" parameterType="ppmAccessCardApply">
        DELETE
        FROM
        PPM_ACCESS_CARD_APPLY
        WHERE INSTANCE_ID = #{instanceId}
    </delete>
	
	<select id="queryDetailForInstanceId" parameterType="ppmAccessCardApplyExt" resultMap="PPMACCESSCARDAPPLY_ALL_EXT">
        SELECT
		  A.ID,
		  A.TYPE,
		  A.INSTANCE_ID,
		  A.APPLYER_ID,
		  A.APPLYER_DEPT_ID,
		  A.STATE,
		  A.STATE_NAME,
		  A.CURRENT_ID,
		  A.CURRENT_NAME,
		  A.CREATED_TIME,
		  A.CREATED_BY,
		  A.MODIFIED_TIME,
		  A.MODIFIED_BY,
		  A.FILE_NO,
		  A.IS_DEL,
		  D.LOCATION APPLYER_DEPT_NAME,
		  E.EMPNAME APPLYER_NAME
		FROM PPM_ACCESS_CARD_APPLY A 
			LEFT JOIN COMM_DEPARTMENT D ON A.APPLYER_DEPT_ID = D.DEPID
			LEFT JOIN COMM_EMPLOYEE E ON E.BADGE = A.APPLYER_ID
		WHERE INSTANCE_ID = #{instanceId}
    </select>

</mapper>

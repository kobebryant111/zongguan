    <!--通过id查询  ywwb905 2023-05-19 -->
    <select id="queryDetail" parameterType="ppmAccessCardApply" resultMap="PPMACCESSCARDAPPLY_ALL">
        SELECT
        <include refid="sql_flied_all" />
        FROM PPM_ACCESS_CARD_APPLY  
		<trim prefix="WHERE" suffixOverrides="AND">
            <if test="id != null  and id != '' " > ID = #{id} AND </if>
			<if test="instanceId != null  and instanceId != '' " > INSTANCE_ID = #{instanceId} AND </if>
			<if test="id == null  and instanceId == null " >ID = '' AND</if>
        </trim>
    </select>

     <!--查询集合  ywwb905 2023-05-19 -->
    <select id="getList" parameterType="ppmAccessCardApply" resultMap="PPMACCESSCARDAPPLY_ALL">
        SELECT
        <include refid="sql_flied_all" />
        FROM PPM_ACCESS_CARD_APPLY
        <include refid="sql_select_condition" />
    </select>
    <!-- update sql -->
    <sql id="update_pojo_sql">
        <trim prefix="SET" suffixOverrides=",">
            <if test="id != null  and id != '' " > ID=#{id} , </if>
				<if test="type != null  and type != '' " > TYPE=#{type} , </if>
				<if test="instanceId != null  and instanceId != '' " > INSTANCE_ID=#{instanceId} , </if>
				<if test="applyerId != null  and applyerId != '' " > APPLYER_ID=#{applyerId} , </if>
				<if test="applyerDeptId != null  and applyerDeptId != '' " > APPLYER_DEPT_ID=#{applyerDeptId} , </if>
				<if test="fileNo != null  and fileNo != '' " > FILE_NO=#{fileNo} , </if>

    <!-- selectCountJoinHMC 关联花名册  2022-11-03 ywwb903  -->
    <select id="selectCountJoinHMC" parameterType="map" resultType="Long">
        SELECT COUNT(1) count
        FROM PPM_ATTATCH_MANAGEMENT a
        INNER JOIN (SELECT AAA AS file_id FROM PPM_OUTSOURCING_BASIC) b
        ON a.id = b.file_id
        WHERE a.id = #{id}

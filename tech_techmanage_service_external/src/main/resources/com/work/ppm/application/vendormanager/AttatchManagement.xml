    <sql id="sql_flied_all">
        ID
        ,FILE_NO
        ,ATTACH_NAME
        ,FILE_TYPE
        ,contract_info
        ,START_DATE
        ,END_DATE
        ,CASE
         when  sysdate &lt; to_date(start_date,'yyyy-MM-dd') then '未生效'
         when  sysdate &gt; to_date(end_date,'yyyy-MM-dd') then '已失效'
         else '生效中'  end  as STATUS
        ,DOC
        ,IS_DEL
        ,IS_ASSOCIATED
        ,TOTALS
        ,AVAILABLE_COUNT
        ,NUMBER_USED
    </sql>


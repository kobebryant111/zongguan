<mapper namespace="com.work.ppm.application.model.projectmanager.PpmProjectOnlineversion">
	 <resultMap type="ppmProjectOnlineversion" id="PPMPROJECTONLINEVERSION_ALL">
        <result property="id" column="ID" />
		<result property="onlineno" column="ONLINENO" />
		<result property="projectno" column="PROJECTNO" />
		<result property="subprojectno" column="SUBPROJECTNO" />
		<result property="versiontype" column="VERSIONTYPE" />
		<result property="isdel" column="ISDEL" />
		
     </resultMap>

     <!-- 所有字段名称 -->
        <sql id="sql_flied_all">
        	ID,
			ONLINENO,
			PROJECTNO,
			SUBPROJECTNO,
			VERSIONTYPE,
			ISDEL
        </sql>
        <sql id="sql_select_condition">
            <trim prefix="WHERE" suffixOverrides="AND">
                <if test="id != null " > ID = #{id} AND </if>
				<if test="onlineno != null  and onlineno != '' " > ONLINENO = #{onlineno} AND </if>
				<if test="projectno != null  and projectno != '' " > PROJECTNO = #{projectno} AND </if>
				<if test="subprojectno != null  and subprojectno != '' " > SUBPROJECTNO = #{subprojectno} AND </if>
				<if test="versiontype != null  and versiontype != '' " > VERSIONTYPE = #{versiontype} AND </if>
				<if test="isdel != null  and isdel != '' " > ISDEL = #{isdel} AND </if>
				
            </trim>
        </sql>
    	<!-- 查询分页  2021-09-28 k4038  -->
        <select id="queryPagerList" parameterType="map" resultMap="PPMPROJECTONLINEVERSION_ALL">
        	SELECT
            <include refid="sql_flied_all" />
            FROM PPM_PROJECT_ONLINEVERSION
            <include refid="sql_select_condition" />
        </select>

        <!-- 新增  2021-09-28 k4038  -->
        <insert id="addPojo" parameterType="ppmProjectOnlineversion">
    		INSERT INTO PPM_PROJECT_ONLINEVERSION (
    		<trim suffixOverrides=",">
    		 <if test="id != null " > ID , </if>
				<if test="onlineno != null  and onlineno != '' " > ONLINENO , </if>
				<if test="projectno != null  and projectno != '' " > PROJECTNO , </if>
				<if test="subprojectno != null  and subprojectno != '' " > SUBPROJECTNO , </if>
				<if test="versiontype != null  and versiontype != '' " > VERSIONTYPE , </if>
				<if test="isdel != null  and isdel != '' " > ISDEL , </if>
				
              </trim>
    		)
    		VALUES(
    		<trim suffixOverrides=",">
    		 <if test="id != null " > #{id} , </if>
				<if test="onlineno != null  and onlineno != '' " > #{onlineno} , </if>
				<if test="projectno != null  and projectno != '' " > #{projectno} , </if>
				<if test="subprojectno != null  and subprojectno != '' " > #{subprojectno} , </if>
				<if test="versiontype != null  and versiontype != '' " > #{versiontype} , </if>
				<if test="isdel != null  and isdel != '' " > #{isdel} , </if>
				
            </trim>
    		)
        </insert>

        <!--通过id查询  k4038 2021-09-28 -->
        <select id="queryDetail" parameterType="ppmProjectOnlineversion" resultMap="PPMPROJECTONLINEVERSION_ALL">
        	SELECT
        	<include refid="sql_flied_all" />
        	FROM PPM_PROJECT_ONLINEVERSION  WHERE ID=#{id}
        </select>

         <!--查询集合  k4038 2021-09-28 -->
        <select id="getList" parameterType="ppmProjectOnlineversion" resultMap="PPMPROJECTONLINEVERSION_ALL">
        	SELECT
        	<include refid="sql_flied_all" />
        	FROM PPM_PROJECT_ONLINEVERSION
        	<include refid="sql_select_condition" />
        </select>
        <!-- update sql -->
        <sql id="update_pojo_sql">
        	<trim prefix="SET" suffixOverrides=",">
        		<if test="id != null " > ID=#{id} , </if>
				<if test="onlineno != null  and onlineno != '' " > ONLINENO=#{onlineno} , </if>
				<if test="projectno != null  and projectno != '' " > PROJECTNO=#{projectno} , </if>
				<if test="subprojectno != null  and subprojectno != '' " > SUBPROJECTNO=#{subprojectno} , </if>
				<if test="versiontype != null  and versiontype != '' " > VERSIONTYPE=#{versiontype} , </if>
				<if test="isdel != null  and isdel != '' " > ISDEL=#{isdel} , </if>
				
            </trim>
        </sql>

        <!--通过id编辑 k4038 2021-09-28 -->
    	<update id="updatePojo" parameterType="ppmProjectOnlineversion">
        	UPDATE
        	PPM_PROJECT_ONLINEVERSION
        	<include refid="update_pojo_sql" />
        	WHERE ID=#{id}
        </update>

        <!--通过id批量删除  k4038 2021-09-28 -->
        <delete id="deleteById" parameterType="ppmProjectOnlineversion">
        	DELETE
        	FROM
        	PPM_PROJECT_ONLINEVERSION
        	WHERE ID = #{id}
        </delete>

</mapper>

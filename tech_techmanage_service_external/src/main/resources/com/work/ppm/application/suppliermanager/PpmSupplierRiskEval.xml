	<!--通过id查询  ywwb905 2022-12-08 -->
	<select id="queryBaseInfo" parameterType="ppmSupplierRiskEvalExt" resultMap="PPMSUPPLIERRISKEVAL_ALL_EXT">
        SELECT 
			RE.ID,
			RE.INSTANCEID,
			RE.ASSESS_TYPE,
			RE.ASSESS_YEAR,
			RE.BUSI_NAME,
			RE.BUSI_TYPE,
			RE.SUPPLIER_ID,
			RE.IMP_INFO,
			RE.EXECUTION_MODE,
			RE.AFFECT_BUSI_TYPE,
			RE.ASSESS_SCORES,
			RE.ASSESS_RESULT,
			RE.PM_ID,
			RE.DEPT_ID,
			RE.LEADER_PM_ID,
			RE.STATE,
			RE.STATE_NAME,
			RE.CURRENT_ID,
			RE.CURRENT_NAME,
			RE.CREATED_TIME,
			RE.CREATED_BY,
			RE.MODIFIED_TIME,
			RE.MODIFIED_BY,
			CE1.EMPNAME PM_NAME,
			CE2.EMPNAME LEADER_PM_NAME,
			OI.OUTSOURCNAME SUPPLIER_NAME,
			CD.LOCATION DEPT_NAME
		FROM PPM_SUPPLIER_RISK_EVAL RE
			LEFT JOIN COMM_EMPLOYEE CE1 ON RE.PM_ID = CE1.BADGE
			LEFT JOIN COMM_EMPLOYEE CE2 ON RE.LEADER_PM_ID = CE2.BADGE
			LEFT JOIN PPM_OUTSOURCING_INFO OI ON RE.SUPPLIER_ID = OI.ORGCODE
			LEFT JOIN COMM_DEPARTMENT CD ON RE.DEPT_ID = CD.DEPID
		<trim prefix="WHERE" suffixOverrides="AND">
			<if test="id == null and instanceid == null " > RE.ID = '' AND </if>
            <if test="id != null and id != '' " > RE.ID = #{id} AND </if>
			<if test="instanceid != null and instanceid != '' " > RE.INSTANCEID = #{instanceid} AND </if>
        </trim>
    </select>
	
	<select id="queryBaseInfoList" parameterType="ppmSupplierRiskEvalExt" resultMap="PPMSUPPLIERRISKEVAL_ALL_EXT">
		SELECT 
			RE.ID,
			RE.INSTANCEID,
			RE.ASSESS_TYPE,
			RE.ASSESS_YEAR,
			RE.BUSI_NAME,
			RE.BUSI_TYPE,
			RE.SUPPLIER_ID,
			RE.IMP_INFO,
			RE.EXECUTION_MODE,
			RE.AFFECT_BUSI_TYPE,
			RE.ASSESS_SCORES,
			RE.ASSESS_RESULT,
			RE.PM_ID,
			RE.DEPT_ID,
			RE.LEADER_PM_ID,
			RE.STATE,
			RE.STATE_NAME,
			RE.CURRENT_ID,
			RE.CURRENT_NAME,
			RE.CREATED_TIME,
			RE.CREATED_BY,
			RE.MODIFIED_TIME,
			RE.MODIFIED_BY,
			CE1.EMPNAME PM_NAME,
			CE2.EMPNAME LEADER_PM_NAME,
			OI.OUTSOURCNAME SUPPLIER_NAME,
			CD.LOCATION DEPT_NAME
		FROM PPM_SUPPLIER_RISK_EVAL RE
			LEFT JOIN COMM_EMPLOYEE CE1 ON RE.PM_ID = CE1.BADGE
			LEFT JOIN COMM_EMPLOYEE CE2 ON RE.LEADER_PM_ID = CE2.BADGE
			LEFT JOIN PPM_OUTSOURCING_INFO OI ON RE.SUPPLIER_ID = OI.ORGCODE
			LEFT JOIN COMM_DEPARTMENT CD ON RE.DEPT_ID = CD.DEPID
		<trim prefix="WHERE" suffixOverrides="AND">
            <if test="pmId != null and pmId != '' ">RE.PM_ID = #{pmId} AND</if>
            <if test="deptId != null and deptId != '' ">RE.DEPT_ID = #{deptId} AND</if>
            <if test="pmValue != null and pmValue != '' ">(RE.PM_ID = #{pmValue} OR CE1.EMPNAME = #{pmValue} ) AND</if>
            <if test="assessYear != null and assessYear != '' ">RE.ASSESS_YEAR = #{assessYear} AND</if>
            <if test="supplierId != null and supplierId != '' ">RE.SUPPLIER_ID = #{supplierId} AND</if>
			<if test="state != null and state != '' " > RE.STATE = #{state} AND </if>
			<if test="assessType != null and assessType != '' " > RE.ASSESS_TYPE = #{assessType} AND </if>
			<if test="instanceid != null and instanceid != '' " > RE.INSTANCEID = #{instanceid} AND </if>
			<if test="deptIdVal != null and deptIdVal != '' " > RE.DEPT_ID = #{deptIdVal} AND </if>
			<if test="pmIdVal != null and pmIdVal != '' " > RE.PM_ID = #{pmIdVal} AND </if>
			<if test="busiName != null and busiName != '' " > RE.BUSI_NAME = #{busiName} AND </if>
        </trim>
		ORDER BY RE.ID DESC
	</select>

</mapper>

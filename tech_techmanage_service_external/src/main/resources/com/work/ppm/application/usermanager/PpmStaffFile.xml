        <!--员工档案  k6991 2020-03-18 -->
        <select id="queryByBadge" parameterType="ppmStaffFile" resultMap="QUERYBYBADGE_MAP">
        	SELECT
			F.ID,F.BADGE,F.EMPNAME,F.GENDER,F.CERTTYPE,F.CERTNO,F.BIRTHDAY,F.NATION,F.DOMICILELOCATION,F.RECRUITMODLE,F.RANKSALARY,F.JOINDATE,F.WORKTIME
			,D.LOCATION DEP_NAME,J.LOCATION JOB_NAME,F.HIGHESTEDU,F.HIGHESTFULLTIMEEDU,F.HIGHESTDEGREE,F.HIGHESTFULLTIMEDEGREE,F.XADDRESS,F.HEIGHT,F.WEIGHT,F.POLITICCONTENANCE,
			F.JOINPARTYTIME,F.SUBORDINATEBRANCH,F.OFFICELOCATION,F.TECHNICALEXPERTISE,F.INTEREST,F.OTHERINFOS,F.SHIRTSIZE,F.CARNO,F.LAUNDAYCARD,F.HOSPITAL,F.MARITALSTATUS,
			F.FRATERNALWILL,F.IMAGE,F.MOTTO ,B.EMAIL,B.CONTEL,T.GROUPNAME,F.UPDATEFLAG
			FROM PPM_STAFF_FILE F
			LEFT JOIN PPM_EEMPLOYEE_BASEINFOR B ON F.BADGE=B.BADGE
			LEFT JOIN COMM_DEPARTMENT D ON F.DEPID=D.DEPID
			LEFT JOIN COMM_JOB J ON F.JOBID=J.JOBID
			LEFT JOIN (
			SELECT U.USERID,U.TEAMGRPUPID,G.GROUPNAME  FROM PPM_DA_TEAM_USER U
			LEFT JOIN  PPM_DA_TEAM_GROUP G  ON U.TEAMGRPUPID=G.ID
			UNION
			SELECT G.GROUPUSERID,G.ID,G.GROUPNAME FROM PPM_DA_TEAM_GROUP G
			) T ON T.USERID=F.BADGE
			WHERE F.BADGE=#{badge} AND ROWNUM=1
        </select>


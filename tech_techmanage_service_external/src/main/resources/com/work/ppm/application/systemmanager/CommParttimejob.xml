<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- author:k6991 2020-01-19 -->
<mapper namespace="com.work.ppm.application.model.systemmanager.CommParttimejob">
	 <resultMap type="commParttimejob" id="COMMPARTTIMEJOB_ALL">
        <result property="compid" column="COMPID" />
		<result property="empname" column="EMPNAME" />
		<result property="boardline" column="BOARDLINE" />
		<result property="headship1" column="HEADSHIP1" />
		<result property="isdisable" column="ISDISABLE" />
		<result property="remark" column="REMARK" />
		<result property="enddate" column="ENDDATE" />
		<result property="partid" column="PARTID" />
		<result property="badge" column="BADGE" />
		<result property="jobid" column="JOBID" />
		<result property="costcut" column="COSTCUT" />
		<result property="begindate" column="BEGINDATE" />
		<result property="eid" column="EID" />
		<result property="depid" column="DEPID" />
		
     </resultMap>

     <!-- 所有字段名称 -->
        <sql id="sql_flied_all">
        	COMPID,
			EMPNAME,
			BOARDLINE,
			HEADSHIP1,
			ISDISABLE,
			REMARK,
			ENDDATE,
			PARTID,
			BADGE,
			JOBID,
			COSTCUT,
			BEGINDATE,
			EID,
			DEPID
        </sql>
		<resultMap id="QUERYPAGERLIST_MAP" type="commParttimejobInfo" extends="COMMPARTTIMEJOB_ALL">
			<result column="ORGNAME" property="orgName" />
			<result column="DEPNAME" property="depName" />
			<result column="JOBNAME" property="jobName" />
		</resultMap>
    	<!-- 查询分页  2020-01-19 k6991  -->
        <select id="queryPagerList" parameterType="map" resultMap="QUERYPAGERLIST_MAP">
			SELECT T.EID,
			T.BADGE,
			T.EMPNAME,
			T.COMPID,
			T.DEPID,
			T.JOBID,
			T.BOARDLINE,
			T.COSTCUT,
			T.BEGINDATE,
			T.ENDDATE,
			T.ISDISABLE,
			T.REMARK,
			ORG.LOCATION ORGNAME,
			DEP.LOCATION DEPNAME,
			JOB.LOCATION JOBNAME
			FROM COMM_PARTTIMEJOB  T,
			COMM_ORGANIZATION ORG,
			COMM_DEPARTMENT   DEP,
			COMM_JOB          JOB
            <trim prefix="WHERE" suffixOverrides="AND">
				<if test="1==1" >
					T.COMPID = ORG.COMPID
					AND T.DEPID = DEP.DEPID
					AND T.JOBID = JOB.JOBID
					AND T.ISDISABLE = '0' AND
				</if>
				<if test="compid != null and compid != -1 " > T.COMPID = #{compid} AND </if>
				<if test="empname != null  and empname != '' " > EMPNAME = #{empname} AND </if>
				<if test="boardline != null  and boardline != '' " > BOARDLINE = #{boardline} AND </if>
				<if test="headship1 != null  and headship1 != '' " > HEADSHIP1 = #{headship1} AND </if>
				<if test="isdisable != null  and isdisable != '' " > ISDISABLE = #{isdisable} AND </if>
				<if test="remark != null  and remark != '' " > REMARK = #{remark} AND </if>
				<if test="enddate != null " > ENDDATE = #{enddate} AND </if>
				<if test="partid != null " > T.PARTID = #{partid} AND </if>
				<if test="badge != null  and badge != '' " > T.BADGE = #{badge} AND </if>
				<if test="jobid != null " > T.JOBID = #{jobid} AND </if>
				<if test="costcut != null " > COSTCUT = #{costcut} AND </if>
				<if test="begindate != null " > BEGINDATE = #{begindate} AND </if>
				<if test="eid != null " > T.EID = #{eid} AND </if>
				<if test="depid != null " > T.DEPID = #{depid} AND </if>
            </trim>
			ORDER BY ORG.COMPCODE , T.EID
        </select>

        <!-- 新增  2020-01-19 k6991  -->
        <insert id="addPojo" parameterType="commParttimejob">
    		INSERT INTO COMM_PARTTIMEJOB (
    		COMPID,
			EMPNAME,
			BOARDLINE,
			HEADSHIP1,
			ISDISABLE,
			REMARK,
			ENDDATE,
			PARTID,
			BADGE,
			JOBID,
			COSTCUT,
			BEGINDATE,
			EID,
			DEPID
    		)
    		VALUES(
    		#{compid},
			#{empname},
			#{boardline},
			#{headship1},
			#{isdisable},
			#{remark},
			#{enddate},
			#{partid},
			#{badge},
			#{jobid},
			#{costcut},
			#{begindate},
			#{eid},
			#{depid}
    		)
        </insert>

        <!--通过id查询  k6991 2020-01-19 -->
        <select id="queryById" parameterType="map" resultMap="COMMPARTTIMEJOB_ALL">
        	SELECT
        	<include refid="sql_flied_all" />
        	FROM COMM_PARTTIMEJOB  WHERE COMPID=#{compid}
        </select>

         <!--查询集合  k6991 2020-01-19 -->
        <select id="getList" parameterType="map" resultMap="COMMPARTTIMEJOB_ALL">
        	SELECT
        	<include refid="sql_flied_all" />
        	FROM COMM_PARTTIMEJOB
        	<trim prefix="WHERE" suffixOverrides="AND">
        		<if test="compid != null " > COMPID=#{compid} AND </if>
				<if test="empname != null  and empname != '' " > EMPNAME=#{empname} AND </if>
				<if test="boardline != null  and boardline != '' " > BOARDLINE=#{boardline} AND </if>
				<if test="headship1 != null  and headship1 != '' " > HEADSHIP1=#{headship1} AND </if>
				<if test="isdisable != null  and isdisable != '' " > ISDISABLE=#{isdisable} AND </if>
				<if test="remark != null  and remark != '' " > REMARK=#{remark} AND </if>
				<if test="enddate != null " > ENDDATE=#{enddate} AND </if>
				<if test="partid != null " > PARTID=#{partid} AND </if>
				<if test="badge != null  and badge != '' " > BADGE=#{badge} AND </if>
				<if test="jobid != null " > JOBID=#{jobid} AND </if>
				<if test="costcut != null " > COSTCUT=#{costcut} AND </if>
				<if test="begindate != null " > BEGINDATE=#{begindate} AND </if>
				<if test="eid != null " > EID=#{eid} AND </if>
				<if test="depid != null " > DEPID=#{depid} AND </if>
				
            </trim>
        </select>
        <!-- update sql -->
        <sql id="update_pojo_sql">
        	<trim prefix="SET" suffixOverrides=",">
        		<if test="compid != null " > COMPID=#{compid} , </if>
				<if test="empname != null  and empname != '' " > EMPNAME=#{empname} , </if>
				<if test="boardline != null  and boardline != '' " > BOARDLINE=#{boardline} , </if>
				<if test="headship1 != null  and headship1 != '' " > HEADSHIP1=#{headship1} , </if>
				<if test="isdisable != null  and isdisable != '' " > ISDISABLE=#{isdisable} , </if>
				<if test="remark != null  and remark != '' " > REMARK=#{remark} , </if>
				<if test="enddate != null " > ENDDATE=#{enddate} , </if>
				<if test="partid != null " > PARTID=#{partid} , </if>
				<if test="badge != null  and badge != '' " > BADGE=#{badge} , </if>
				<if test="jobid != null " > JOBID=#{jobid} , </if>
				<if test="costcut != null " > COSTCUT=#{costcut} , </if>
				<if test="begindate != null " > BEGINDATE=#{begindate} , </if>
				<if test="eid != null " > EID=#{eid} , </if>
				<if test="depid != null " > DEPID=#{depid} , </if>
				
            </trim>
        </sql>

        <!--通过id编辑 k6991 2020-01-19 -->
    	<update id="updatePojo" parameterType="commParttimejob">
        	UPDATE
        	COMM_PARTTIMEJOB
        	<include refid="update_pojo_sql" />
        	WHERE COMPID=#{compid}
        </update>

        <!--通过id批量删除  k6991 2020-01-19 -->
        <delete id="deleteById" parameterType="commParttimejob">
        	DELETE
        	FROM
        	COMM_PARTTIMEJOB
        	WHERE COMPID = #{compid}
        </delete>
</mapper>

		<!--查询集合  k1327 2021-08-04 -->
		<select id="getPpmKpiPostevaluations" parameterType="ppmKpiPostevaluation" resultMap="PPMKPIPOSTEVALUATION_ALL">
			select p.*,e.empname eidname,t.location depname,c.centername,en.dictname itemstatusname from ppm_kpi_postevaluation p
			left join ppm_kpi_pm_detail d on p.id=p.pid
			left join ppm_kpi_pm m on d.pid=m.id
			left join comm_employee e on p.eid=e.eid
			left join comm_department t on m.depid=to_char(t.depid)
			left join ppm_da_center c on m.centerid=c.id
			left join eos_dict_entry en on en.dicttypeid='KPI_ITEM_STATUS' and en.dictid=p.itemstatus
			<trim prefix="WHERE" suffixOverrides="AND">
				<if test="id != null " > p.ID = #{id} AND </if>
				<if test="pid != null " > p.PID = #{pid} AND </if>
				<if test="item != null  and item != '' " > p.ITEM = #{item} AND </if>
				<if test="itemdescribe != null  and itemdescribe != '' " > p.ITEMDESCRIBE = #{itemdescribe} AND </if>
				<if test="plan != null  and plan != '' " > p.PLAN = #{plan} AND </if>
				<if test="plandescribe != null  and plandescribe != '' " > p.PLANDESCRIBE = #{plandescribe} AND </if>
				<if test="value != null " > p.VALUE = #{value} AND </if>
				<if test="finishdate != null " > p.FINISHDATE = #{finishdate} AND </if>
				<if test="workremark != null  and workremark != '' " > p.WORKREMARK = #{workremark} AND </if>
				<if test="firstevalscore != null " > p.FIRSTEVALSCORE = #{firstevalscore} AND </if>
				<if test="firstevalgoal != null " > p.FIRSTEVALGOAL = #{firstevalgoal} AND </if>
				<if test="secondevalscore != null " > p.SECONDEVALSCORE = #{secondevalscore} AND </if>
				<if test="secondevalgoal != null " > p.SECONDEVALGOAL = #{secondevalgoal} AND </if>
				<if test="tscore != null " > p.TSCORE = #{tscore} AND </if>
				<if test="firsteval != null  and firsteval != '' " > p.FIRSTEVAL = #{firsteval} AND </if>
				<if test="secondeval != null  and secondeval != '' " > p.SECONDEVAL = #{secondeval} AND </if>
				<if test="firstevaltime != null " > p.FIRSTEVALTIME = #{firstevaltime} AND </if>
				<if test="secondevaltime != null " > p.SECONDEVALTIME = #{secondevaltime} AND </if>
				<if test="itemstatus != null " > p.ITEMSTATUS = #{itemstatus} AND </if>
				<if test="weight != null " > p.WEIGHT = #{weight} AND </if>
				<if test="mainpart != null  and mainpart != '' " > p.MAINPART = #{mainpart} AND </if>
				<if test="createtime != null " > p.CREATETIME = #{createtime} AND </if>
				<if test="createuserid != null  and createuserid != '' " > p.CREATEUSERID = #{createuserid} AND </if>
				<if test="eid != null  and eid != '' " > p.EID = #{eid} AND </if>
				<if test="term != null  and term != '' " > p.TERM = #{term} AND </if>
				<if test="tyear != null  and tyear != '' " > p.TYEAR = #{tyear} AND </if>
				<if test="check != null  and check != '' " >
					(( p.FIRSTEVAL = #{check} and  p.itemstatus=5)
					or
					( p.SECONDEVAL = #{check} and  p.itemstatus=6))
				</if>
			</trim>
		</select>

	<select id="getAvgScore" parameterType="map" resultMap="PPMKPIPOSTEVALUATION_ALL">
			select avg(p.tscore) tscore from ppm_kpi_postevaluation p
		    where  p.PID = #{pid} AND p.ITEM = #{item} AND  p.PLAN = #{plan} AND p.ITEMSTATUS = #{itemstatus}
	</select>

	<!--查询综合能力和履职评估统计分数  k1327 2021-05-31 -->
	<select id="queryPostEvaluationSumScore" parameterType="map"  resultMap="PPMKPIPOSTEVALUATION_ALL">
		select  sum(round((sum(d.tscore)/count(*))*max(d.weight),2)) tscore from ppm_kpi_postevaluation p
		where p.tyear=#{tyear} and p.eid=#{eid} and p.secondeval=#{secondeval}
		group by p.item
	</select>

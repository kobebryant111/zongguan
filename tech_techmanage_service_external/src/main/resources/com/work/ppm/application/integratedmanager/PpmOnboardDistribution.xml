            D.ID,
            D.SEQUENCE,
            D.NAME,
            D.CENTER,
            D.DEPT_ID,
            D.DIRECTION,
            D.GRADE,
            D.RESUME_ID,
            D.SEX,
            D.TOTAL_SCORE,
            D.TECHNICAL_SCORE,
            D.TECHNICAL_SCORING,
            D.TECHNICAL_COMMENTS,
            D.ADMINISTRATIVE_SCORE,
            D.ADMINISTRATIVE_SCORING,

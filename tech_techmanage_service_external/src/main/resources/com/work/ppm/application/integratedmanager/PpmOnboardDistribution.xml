            D.TRAINING_SCORE,
            D.TRAINING_SCORING,
            D.WRITTEN_SCORE,
            D.WRITTEN_SCORING,
            D.OTHER_SCORE,
            D.OTHER_SCORING,
            D.NOTE,
            D.BORN_DATE,
            D.NATIVES,
            D.HIGHEST,
            D.COURSES_COLLEGE,
            D.COURSES_PROFESSIONAL,
            D.MASTERS_COLLEGE,
            D.DEGREE_PROFESSIONAL,
            D.BATCH,
            D.ISDEL,
            D.MID,
            (SELECT E.DICTNAME FROM EOS_DICT_ENTRY E WHERE E.DICTTYPEID='BUSI_OUTSOURCE_GENFER' AND E.DICTID=D.SEX)
            SEX_NAME,
            (SELECT E.DICTNAME FROM EOS_DICT_ENTRY E WHERE E.DICTTYPEID='NEWKG_DIRECTION' AND E.DICTID=D.DIRECTION)
            DIRECTION_NAME,

            C.CENTERNAME,P.LOCATION FROM PPM_ONBOARD_DISTRIBUTION D
            LEFT JOIN PPM_DA_CENTER C ON (D.CENTER = C.ID)
            LEFT JOIN COMM_DEPARTMENT P ON(D.DEPT_ID=P.DEPID)
			<trim prefix="WHERE" suffixOverrides="AND">
				<if test="id != null " > ID = #{id} AND </if>
				<if test="sequence != null " > SEQUENCE = #{sequence} AND </if>
				<if test="name != null  and name != '' " > NAME = #{name} AND </if>
				<if test="center != null  and center != '' " > CENTER = #{center} AND </if>
				<if test="deptId != null  and deptId != '' " > DEPT_ID = #{deptId} AND </if>
				<if test="direction != null  and direction != '' " > DIRECTION = #{direction} AND </if>
				<if test="resumeId != null  and resumeId != '' " > RESUME_ID = #{resumeId} AND </if>
				<if test="batch != null  and batch != '' " > BATCH = #{batch} AND </if>
				<if test="mid != null " > MID=#{mid} AND </if>
				<if test="centers != null  and centers != '' " > CENTER IN (${centers}) AND </if>
				<if test="year != null  and year != '' " > TO_CHAR(TO_DATE(BATCH, 'YYYY-MM'),'YYYY') = #{year} AND
				</if>
				<if test="isdel != null " > D.ISDEL = #{isdel} AND </if>
				<if test="resumeIds != null  and resumeIds != '' " > RESUME_ID IN (${resumeIds}) AND </if>
			</trim>

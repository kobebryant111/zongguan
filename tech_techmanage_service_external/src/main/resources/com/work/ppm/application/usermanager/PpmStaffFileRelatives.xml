<mapper namespace="com.work.ppm.application.model.usermanager.PpmStaffFileRelatives">
	 <resultMap type="ppmStaffFileRelatives" id="PPMSTAFFFILERELATIVES_ALL">
        <result property="id" column="ID" />
		<result property="name" column="NAME" />
		<result property="relationship" column="RELATIONSHIP" />
		<result property="gender" column="GENDER" />
		<result property="certno" column="CERTNO" />
		<result property="birthday" column="BIRTHDAY" />
		<result property="workunit" column="WORKUNIT" />
		<result property="post" column="POST" />
		<result property="address" column="ADDRESS" />
		<result property="phone" column="PHONE" />
		<result property="flag" column="FLAG" />
		<result property="badge" column="BADGE" />
		<result property="rid" column="RID" />
		<result property="ord" column="ORD" />
		<result property="updateuserid" column="UPDATEUSERID" />

    <sql id="sql_select_condition">
        <trim prefix="WHERE" suffixOverrides="AND">
            <if test="id != null  and id != '' " > ID = #{id} AND </if>
			<if test="deptId != null  and deptId != '' " > DEPT_ID = #{deptId} AND </if>
			<if test="deptName != null  and deptName != '' " > DEPT_NAME = #{deptName} AND </if>
			<if test="groupName != null  and groupName != '' " > GROUP_NAME like '%'||#{groupName}||'%' AND </if>
			<if test="groupLeaderId != null  and groupLeaderId != '' " > GROUP_LEADER_ID = #{groupLeaderId} AND </if>
			<if test="groupLeaderName != null  and groupLeaderName != '' " > GROUP_LEADER_NAME = #{groupLeaderName} AND </if>
			<if test="groupLeaderCard != null  and groupLeaderCard != '' " > GROUP_LEADER_CARD = #{groupLeaderCard} AND </if>
			<if test="groupType != null  and groupType != '' " > GROUP_TYPE = #{groupType} AND </if>
			<if test="createdBy != null  and createdBy != '' " > CREATED_BY = #{createdBy} AND </if>
			<if test="createdTime != null " > CREATED_TIME = #{createdTime} AND </if>
			<if test="modifiedBy != null  and modifiedBy != '' " > MODIFIED_BY = #{modifiedBy} AND </if>

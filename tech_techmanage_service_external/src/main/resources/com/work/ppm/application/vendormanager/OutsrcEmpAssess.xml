    <!-- manual query-->
    <select id="getYearAssessWithAvgScore" parameterType="outsrcEmpAssess" resultType="com.work.ppm.application.dto.vendormanager.OutsrcEmpAssessDto">
        SELECT a.*,(select outsourcname from PPM_OUTSOURCING_INFO where orgcode = vendorCode and rownum=1) vendorName
        ,CASE
        WHEN avgScore >9 then '10'
        WHEN avgScore>7 and avgScore&lt;=9 then '9'
        WHEN avgScore>5 and avgScore&lt;=7 then '7'
        ELSE '5'
        END assessLevel
        FROM (
        SELECT
              user_code userCode
              ,max(user_name) userName
              ,max(vendor_Code) vendorCode
              , MAX(DEPT_ID) deptId
              , MAX(prj_mgr_code) prjMgrCode
              , MAX(PRJ_MGR_NAME) prjMgrName
              , MAX(position) position
              ,round(avg(assess_level),2) avgScore
        FROM PPM_OUTSRC_EMP_ASSESS
        WHERE assess_year = #{assessYear}
          AND prj_mgr_code = #{prjMgrCode}
          AND ASSESS_TYPE = '0'
          AND is_del = '0'
        GROUP BY user_code ) a
    </select>

    <select id="getYearAssess" parameterType="outsrcEmpAssess" resultType="com.work.ppm.application.dto.vendormanager.OutsrcEmpAssessDto">
        SELECT a.*,(select outsourcname from PPM_OUTSOURCING_INFO where orgcode = vendorCode and rownum=1) vendorName
        ,CASE
        WHEN avgScore >9 then '10'
        WHEN avgScore>7 and avgScore&lt;=9 then '9'
        WHEN avgScore>5 and avgScore&lt;=7 then '7'
        ELSE '5'
        END assessLevel
        ,'1' assessType
        ,'暂无' evaluation
        FROM (
        SELECT
        user_code userCode
        ,max(user_name) userName
        ,max(vendor_Code) vendorCode
        ,max(DEPT_ID) deptId
        ,max(prj_mgr_code) prjMgrCode
        ,max(PRJ_MGR_NAME) prjMgrName
        ,max(position) position
        ,max(assess_year) assessYear
        ,round(avg(assess_level),2) avgScore
        FROM PPM_OUTSRC_EMP_ASSESS
        WHERE assess_year = #{assessYear}
        AND ASSESS_TYPE = '0'
        AND is_del = '0'
        GROUP BY user_code ) a
    </select>

    <select id="getYearAssessApply" parameterType="outsrcEmpAssess" resultType="com.work.ppm.application.dto.vendormanager.OutsrcEmpAssessApplyDto">
        SELECT a.*
               ,'1' assessType
               ,'1' approvalStatus
        FROM (
        SELECT
        prj_mgr_code applier
        ,max(DEPT_ID) deptId
        ,max(PRJ_MGR_NAME) prjMgrName
        ,max(position) position
        ,max(assess_year) assessYear
        FROM PPM_OUTSRC_EMP_ASSESS
        WHERE assess_year = '2022'
        AND ASSESS_TYPE = '0'
        AND is_del = '0'
        GROUP BY prj_mgr_code ) a
    </select>

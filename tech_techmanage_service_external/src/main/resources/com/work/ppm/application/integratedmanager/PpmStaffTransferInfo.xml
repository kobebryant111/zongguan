		  OI.OUTSOURCNAME SUPPLIER_NAME,
		  SI.NAME SYSTEM_NAME,
		  E1.DICTNAME TRANSFER_STATE_NAME,
		  E2.DICTNAME OUTSOURCE_TYPE_NAME,
		  PI.NAME PROJECT_NAME
    FROM PPM_STAFF_TRANSFER_INFO TI
		  LEFT JOIN PPM_STAFF_TRANSFER ST ON ST.INSTANCEID = TI.INSTANCEID
		  LEFT JOIN PPM_OUTSOURCING_BASIC OB ON OB.JOB_ID = TI.JOB_ID
		  LEFT JOIN COMM_EMPLOYEE CE ON ST.APPLYER_ID = CE.BADGE
		  LEFT JOIN COMM_EMPLOYEE CEB ON TI.PM_ID_BEFORE = CEB.BADGE
		  LEFT JOIN COMM_EMPLOYEE CEA ON TI.PM_ID_AFTER = CEA.BADGE
		  LEFT JOIN COMM_DEPARTMENT CD ON ST.APPLYER_DEPT_ID = CD.DEPID
		  LEFT JOIN COMM_DEPARTMENT CDB ON TI.DEPT_ID_BEFORE = CDB.DEPID
		  LEFT JOIN COMM_DEPARTMENT CDA ON TI.DEPT_ID_AFTER = CDA.DEPID
		  LEFT JOIN PPM_OUTSOURCING_INFO OI ON TI.SUPPLIER_ID = OI.ORGCODE
		  LEFT JOIN PPM_SYSTEM_INFO SI ON SI.ID = TI.SYSTEM_ID
		  LEFT JOIN PPM_PROJECT_INFO PI ON PI.ID = TI.PROJECT_ID
		  LEFT JOIN EOS_DICT_ENTRY E1 ON ( TI.TRANSFER_STATE = E1.DICTID AND E1.DICTTYPEID = 'STAFF_TRANSFER_STATE')
		  LEFT JOIN EOS_DICT_ENTRY E2 ON ( TI.OUTSOURCE_TYPE = E2.DICTID AND E2.DICTTYPEID = 'NEWKG_WBFS')
		<trim prefix="WHERE" suffixOverrides="AND">
            <if test="instanceid != null and instanceid != '' ">ST.INSTANCEID = #{instanceid} AND</if>
            <if test="jobId != null and jobId != '' ">TI.JOB_ID = #{jobId} AND</if>
            <if test="transferState != null and transferState != '' ">TI.TRANSFER_STATE = #{transferState} AND</if>	
        </trim>

    <!--通过id查询  ywwb905 2022-10-08 -->
    <select id="selListInfo" parameterType="PpmOutSourceInterview" resultMap="PpmOutSourceInterview_ALL">
        SELECT
        <include refid="sql_flied_all" />
        FROM PPM.PPM_OUTSOURCE_INTERVIEW
        <trim prefix="WHERE" suffixOverrides="AND">
            <if test="id != null " > ID = #{id} AND </if>
            <if test="msgId != null " > MSG_ID = #{msgId} AND </if>
        </trim>
    </select>

    <select id="selInterviewData" parameterType="PpmOutSourceInterview" resultType="com.work.ppm.application.dto.bankmamager.PpmOutSorceInterviewDto">
        select
        oi.id AS id,
        oi.CERTIF_NUMBER AS certifNumber,
        oi.msg_id AS msgId,
        oi.flow_path_id AS instanceId,
        oi.inter_code AS msgno,
        em.empname AS msgname,
        oi.inter_dep_code AS deptno,
        dep.location AS deptname,
        oi.techno_logy AS technology,
        oi.COM_PREHEN_SIVE AS comPrehenSive,
        oi.experience AS experience,
        oi.education AS education,
        oi.MSG_ROLE AS msgRole,
        oi.MSEMPLOY_ROLE AS msemployRole,
        oi.UNIVERSAL_TOOL_USE AS universalToolUse,
        oi.PROJECT_MANAGE_KNOWLEDGE AS projectManageKnowledge,
        oi.COMM_EXPRESSION AS commExpression,
        oi.PROJECT_EXPERIENCE AS projectExperience,
        oi.PROJECT_SCALE_XMJL AS projectScaleXmjl,
        oi.PROJECT_SCALE_JCJL AS projectScaleJcjl,
        oi.PROJECT_SCALE AS projectScale,
        oi.SCORE_RESULT AS scoreResult,
        oi.CODE_DEVELOPMENT AS codeDevelopment,
        oi.ARCHITECTURE_DESIGN AS architectureDesign,
        oi.PROFES_KNOWLEDGE AS profesKnowledge,
        oi.STAND_CONDITION AS standCondition,
        oi.PRODUCT_ABILITY AS productAbility
        from PPM_OUTSOURCE_INTERVIEW oi
        left join COMM_DEPARTMENT dep on oi.inter_dep_code = dep.depid
        left join COMM_EMPLOYEE em on oi.inter_code = em.badge
        <trim prefix="WHERE" suffixOverrides="AND">
            <if test="id != null " > ID = #{id} AND </if>
            <if test="certifNumber != null " > CERTIF_NUMBER = #{certifNumber} AND </if>
            <if test="msgId != null " > MSG_ID = #{msgId} AND </if>
        </trim>
    </select>
    <!--通过id编辑 ywwb1103 2023-11-02 -->
    <update id="updInterData" parameterType="PpmOutSourceInterview">
        UPDATE
        PPM_OUTSOURCE_INTERVIEW
        <include refid="update_pojo_sql" />
        <trim prefix="WHERE" suffixOverrides="AND">
            <if test="id != null " > ID = #{id} AND </if>
            <if test="msgId != null " > MSG_ID = #{msgId} AND </if>
        </trim>
    </update>

    <delete id="delInter" parameterType="map">
        DELETE FROM PPM_OUTSOURCE_INTERVIEW
        WHERE ID = #{id} and MSG_ID = #{msgId}
    </delete>

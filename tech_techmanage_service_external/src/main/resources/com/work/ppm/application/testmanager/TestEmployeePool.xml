<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- author:k6991 2020-06-30 -->
<mapper namespace="com.work.ppm.application.model.testmanager.TestEmployeePool">
    <resultMap type="testEmployeePool" id="TESTEMPLOYEEPOOL_ALL">
        <result property="id" column="ID"/>
        <result property="testEmpName" column="TEST_EMP_NAME"/>
        <result property="testEmpBadge" column="TEST_EMP_BADGE"/>
        <result property="affilCompany" column="AFFIL_COMPANY"/>
        <result property="employeeStatus" column="EMPLOYEE_STATUS"/>
        <result property="headOfCompany" column="HEAD_OF_COMPANY"/>
        <result property="ownedTestTeam" column="OWNED_TEST_TEAM"/>
        <result property="ownedTestGroup" column="OWNED_TEST_GROUP"/>
        <result property="empAttribute" column="EMP_ATTRIBUTE"/>
        <result property="createUser" column="CREATE_USER"/>
        <result property="createTime" column="CREATE_TIME"/>
        <result property="updateUser" column="UPDATE_USER"/>
        <result property="updateTime" column="UPDATE_TIME"/>
        <result property="deptId" column="DEPT_ID"/>
        <result property="certificateNumber" column="CERTIFICATE_NUMBER"/>
        <result property="testGroupLeader" column="TEST_GROUP_LEADER"/>
        <result property="groupMember" column="GROUP_MEMBER"/>
    </resultMap>

    <resultMap id="PPMTESTTEAMDTO_ALL" type="com.work.ppm.application.dto.testmanagement.PpmTestTeamDto">
        <result property="teamId" column="TEAM_ID"/>
        <result property="teamName" column="TEAM_NAME"/>
    </resultMap>

    <!-- 所有字段名称 -->
    <sql id="sql_flied_all">
        ID,
        TEST_EMP_NAME,
        TEST_EMP_BADGE,
        AFFIL_COMPANY,
        EMPLOYEE_STATUS,
        HEAD_OF_COMPANY,
        OWNED_TEST_TEAM,
        OWNED_TEST_GROUP,
        EMP_ATTRIBUTE,
        CREATE_USER,
        CREATE_TIME,
        UPDATE_USER,
        UPDATE_TIME,
        DEPT_ID,
        CERTIFICATE_NUMBER,
        TEST_GROUP_LEADER,
        GROUP_MEMBER
    </sql>

    <sql id="sql_select_condition">
        <trim prefix="WHERE" suffixOverrides="AND">
            <if test="id != null ">ID = #{id} AND</if>
            <if test="testEmpName != null  and testEmpName != '' ">TEST_EMP_NAME = #{testEmpName} AND</if>
            <if test="testEmpBadge != null  and testEmpBadge != '' ">TEST_EMP_BADGE like '%'||#{testEmpBadge}||'%' AND
            </if>
            <if test="affilCompany != null and affilCompany != '' ">AFFIL_COMPANY = #{affilCompany} AND</if>
            <if test="employeeStatus != null  and employeeStatus != '' ">EMPLOYEE_STATUS = #{employeeStatus} AND</if>
            <if test="headOfCompany != null  and headOfCompany != '' ">HEAD_OF_COMPANY = #{headOfCompany} AND</if>
            <if test="ownedTestTeam != null  and ownedTestTeam != '' ">OWNED_TEST_TEAM = #{ownedTestTeam} AND</if>
            <if test="ownedTestGroup != null  and ownedTestGroup != '' ">OWNED_TEST_GROUP = #{ownedTestGroup} AND</if>
            <if test="empAttribute != null and empAttribute != '' ">EMP_ATTRIBUTE = #{empAttribute} AND</if>
            <if test="createUser != null and createUser != '' ">CREATE_USER = #{createUser} AND</if>
            <if test="createTime != null ">CREATE_TIME = #{createTime} AND</if>
            <if test="updateUser != null and updateUser != '' ">UPDATE_USER = #{updateUser} AND</if>
            <if test="updateTime != null">UPDATE_TIME = #{updateTime} AND</if>
            <if test="deptId != null and deptId != '' ">DEPT_ID = #{deptId} AND</if>
            <if test="certificateNumber != null and certificateNumber != '' ">CERTIFICATE_NUMBER = #{certificateNumber}
                AND
            </if>
            <if test="testGroupLeader != null and testGroupLeader != '' ">TEST_EMP_BADGE like '%'||#{testGroupLeader}||'%' AND
            </if>
            <if test="groupMember != null and groupMember != '' ">GROUP_MEMBER = #{groupMember} AND</if>
        </trim>
    </sql>

    <sql id="sql_select_undis_condition">
        <trim prefix="WHERE" suffixOverrides="AND">
            OWNED_TEST_GROUP IS NULL AND
            <if test="id != null ">ID = #{id} AND</if>
            <if test="testEmpName != null  and testEmpName != '' ">TEST_EMP_NAME = #{testEmpName} AND</if>
            <if test="testEmpBadge != null  and testEmpBadge != '' ">TEST_EMP_BADGE like '%'||#{testEmpBadge}||'%' AND
            </if>
            <if test="affilCompany != null and affilCompany != '' ">AFFIL_COMPANY = #{affilCompany} AND</if>
            <if test="employeeStatus != null  and employeeStatus != '' ">EMPLOYEE_STATUS = #{employeeStatus} AND</if>
            <if test="headOfCompany != null  and headOfCompany != '' ">HEAD_OF_COMPANY = #{headOfCompany} AND</if>
            <if test="ownedTestTeam != null  and ownedTestTeam != '' ">OWNED_TEST_TEAM = #{ownedTestTeam} AND</if>
            <if test="empAttribute != null and empAttribute != '' ">EMP_ATTRIBUTE = #{empAttribute} AND</if>
            <if test="deptId != null and deptId != '' ">DEPT_ID = #{deptId} AND</if>
            <if test="certificateNumber != null and certificateNumber != '' ">CERTIFICATE_NUMBER = #{certificateNumber}
                AND
            </if>
            <if test="testGroupLeader != null and testGroupLeader != '' ">TEST_GROUP_LEADER = #{testGroupLeader} AND
            </if>
            <if test="groupMember != null and groupMember != '' ">GROUP_MEMBER = #{groupMember} AND</if>
        </trim>
    </sql>

    <select id="queryPagerList" parameterType="map" resultMap="TESTEMPLOYEEPOOL_ALL">
        SELECT
        <include refid="sql_flied_all"/>
        FROM TEST_EMPLOYEE_POOL
        <include refid="sql_select_condition"/>
    </select>

    <select id="queryUndistributionPagerList" parameterType="map" resultMap="TESTEMPLOYEEPOOL_ALL">
        SELECT
        <include refid="sql_flied_all"/>
        FROM TEST_EMPLOYEE_POOL
        <include refid="sql_select_undis_condition"/>
    </select>

    <insert id="insertEmployeePool" parameterType="TestEmployeePool">
        INSERT INTO PPM.TEST_EMPLOYEE_POOL (
        <trim suffixOverrides=",">
            <if test="id != null  and id != '' ">ID ,</if>
            <if test="testEmpName != null  and testEmpName != '' ">TEST_EMP_NAME ,</if>
            <if test="testEmpBadge != null and testEmpBadge != '' ">TEST_EMP_BADGE ,</if>
            <if test="affilCompany != null and affilCompany != '' ">AFFIL_COMPANY ,</if>
            <if test="employeeStatus != null  and employeeStatus != '' ">EMPLOYEE_STATUS ,</if>
            <if test="headOfCompany != null  and headOfCompany != '' ">HEAD_OF_COMPANY ,</if>
            <if test="ownedTestTeam != null  and ownedTestTeam != '' ">OWNED_TEST_TEAM ,</if>
            <if test="ownedTestGroup != null  and ownedTestGroup != '' ">OWNED_TEST_GROUP ,</if>
            <if test="empAttribute != null  and empAttribute != '' ">EMP_ATTRIBUTE ,</if>
            <if test="createUser != null ">CREATE_USER ,</if>
            <if test="createTime != null ">CREATE_TIME ,</if>
            <if test="updateUser != null ">UPDATE_USER ,</if>
            <if test="updateTime != null ">UPDATE_TIME ,</if>
            <if test="deptId != null  and deptId != '' ">DEPT_ID ,</if>
            <if test="certificateNumber != null  and certificateNumber != '' ">CERTIFICATE_NUMBER ,</if>
            <if test="testGroupLeader != null  and testGroupLeader != '' ">TEST_GROUP_LEADER ,</if>
            <if test="groupMember != null  and groupMember != '' ">GROUP_MEMBER ,</if>
        </trim>
        )
        SELECT
        <trim suffixOverrides=",">
            <if test="id != null  and id != '' ">#{id} ,</if>
            <if test="testEmpName != null  and testEmpName != '' ">#{testEmpName} ,</if>
            <if test="testEmpBadge != null and testEmpBadge != '' ">#{testEmpBadge} ,</if>
            <if test="affilCompany != null  and affilCompany != '' ">#{affilCompany} ,</if>
            <if test="employeeStatus != null and employeeStatus != '' ">#{employeeStatus} ,</if>
            <if test="headOfCompany != null and headOfCompany != '' ">#{headOfCompany} ,</if>
            <if test="ownedTestTeam != null and ownedTestTeam != '' ">#{ownedTestTeam} ,</if>
            <if test="ownedTestGroup != null and ownedTestGroup != '' ">#{ownedTestGroup} ,</if>
            <if test="empAttribute != null and empAttribute != '' ">#{empAttribute} ,</if>
            <if test="createTime != null and createTime != '' ">to_date(#{createTime} , 'YYYY-MM-DD HH24:MI:SS') ,</if>
            <if test="createUser != null and createUser != '' ">#{createUser} ,</if>
            <if test="updateTime != null and updateTime != '' ">to_date(#{updateTime} , 'YYYY-MM-DD HH24:MI:SS') ,</if>
            <if test="updateUser != null and updateUser != '' ">#{updateUser} ,</if>
            <if test="deptId != null and deptId != '' ">#{deptId} ,</if>
            <if test="certificateNumber != null and certificateNumber != '' ">#{certificateNumber} ,</if>
            <if test="testGroupLeader != null and testGroupLeader != '' ">#{testGroupLeader} ,</if>
            <if test="groupMember != null and groupMember != '' ">#{groupMember} ,</if>
        </trim>
        FROM dual
        WHERE NOT EXISTS(
        SELECT 1
        FROM TEST_EMPLOYEE_POOL
        WHERE
        <trim suffixOverrides="AND">
            <if test="certificateNumber != null and certificateNumber != ''  ">CERTIFICATE_NUMBER = #{certificateNumber}
                AND
            </if>
        </trim>
        )
    </insert>


    <update id="updateEmployeePool" parameterType="TestEmployeePool">
        UPDATE
        TEST_EMPLOYEE_POOL
        <trim prefix="SET" suffixOverrides=",">
            <if test="testEmpName != null  and testEmpName != '' ">TEST_EMP_NAME=#{testEmpName} ,</if>
            <if test="affilCompany != null  and affilCompany != '' ">AFFIL_COMPANY=#{affilCompany} ,</if>
            <if test="employeeStatus != null  and employeeStatus != '' ">EMPLOYEE_STATUS=#{employeeStatus} ,</if>
            <if test="testEmpBadge != null  and testEmpBadge != '' ">TEST_EMP_BADGE=#{testEmpBadge} ,</if>
            <if test="deptId != null  and deptId != '' ">DEPT_ID=#{deptId} ,</if>
            <if test="certificateNumber != null  and certificateNumber != '' ">CERTIFICATE_NUMBER=#{certificateNumber}
                ,
            </if>
            <if test="updateTime != null and updateTime != '' ">UPDATE_TIME= to_date(#{updateTime} , 'YYYY-MM-DD
                HH24:MI:SS') ,
            </if>
        </trim>
        WHERE CERTIFICATE_NUMBER = #{certificateNumber}
    </update>


    <select id="getOwnedTestTeamList" parameterType="map" resultMap="PPMTESTTEAMDTO_ALL">
        SELECT
        TEAM_ID,
        TEAM_NAME
        FROM PPM.COMM_TEST_TEAM
    </select>

    <update id="updateTestGroup" parameterType="TestEmployeePool">
        UPDATE
        PPM.TEST_EMPLOYEE_POOL
        SET
        OWNED_TEST_GROUP = #{ownedTestGroup} ,
        HEAD_OF_COMPANY = #{headOfCompany}
        WHERE
        TEST_EMP_BADGE IN ${testEmpBadge}
    </update>

    <update id="updateEmpAttState" parameterType="TestEmployeePool">
        UPDATE
        PPM.TEST_EMPLOYEE_POOL
        SET
        EMP_ATTRIBUTE = #{empAttribute}
        WHERE
        TEST_EMP_BADGE IN ${testEmpBadge}
    </update>

    <select id="getTestGroupEmpList" parameterType="map" resultMap="TESTEMPLOYEEPOOL_ALL">
        SELECT
        TEST_EMP_NAME,
        TEST_EMP_BADGE
        FROM PPM.TEST_EMPLOYEE_POOL
    </select>

    <update id="dialogAddSubmit" parameterType="TestEmployeePool">
        UPDATE
        TEST_EMPLOYEE_POOL
        <trim prefix="SET" suffixOverrides=",">
            <if test="headOfCompany != null  and headOfCompany != '' ">HEAD_OF_COMPANY = #{headOfCompany} ,</if>
            <if test="empAttribute != null  and empAttribute != '' ">EMP_ATTRIBUTE = #{empAttribute} ,</if>
            <if test="employeeStatus != null  and employeeStatus != '' ">EMPLOYEE_STATUS = #{employeeStatus} ,</if>
            <if test="ownedTestTeam != null and ownedTestTeam != '' ">OWNED_TEST_TEAM = #{ownedTestTeam} ,</if>
            <if test="ownedTestGroup != null and ownedTestGroup != '' ">OWNED_TEST_GROUP = #{ownedTestGroup} ,</if>
            <if test="updateTime != null and updateTime != '' ">UPDATE_TIME= to_date(#{updateTime} , 'YYYY-MM-DD
                HH24:MI:SS') ,
            </if>
        </trim>
        WHERE ID = #{id}
    </update>

</mapper>

	<select id="getPpmSubProjectView" parameterType="ppmProjectExtInfo" resultMap="PPMPROJECTINFO_ALL">
		select aa.* from (select distinct p.*,
		s.sys_name sysname,
		e.empname,
		r.principala sysuserid,
		r.principala_name sysusername,
		o.planonline,
		oo.orgarea org,s.om_level vel,
		r.bus_dep busdep,
		case
		when r.bus_dep='7004' then  （select distinct  m.userid from ppm_da_dept_manager  m where m.deptid=p.deptno)
		else ''
		end  as linkman ,

		case
		when r.bus_dep='7004' then  （select distinct ee.empname||'('|| m.userid||')' from ppm_da_dept_manager  m left join ppm_emp_view ee on ee.badge=m.userid where m.deptid=p.deptno)
		else ''
		end  as linkname
		from ppm_project p
		left join (select planonline,projectno from  ppm_project_online
		union
		select planonline,projectno from  ppm_project_newonline) o on o.projectno = p.projectno
		left join aap_system s on p.sysno = s.system_id
		left join comm_employee e on p.Manauserid = e.badge
		left join aap_system_responsibility r on s.res_id = r.res_id
		left join PPM_ONLINE_ORGAREA oo on oo.projectno = p.subprojectno and oo.planonline = o.planonline
		where p.status is not null) aa

		<trim prefix="WHERE" suffixOverrides="AND">
			<if test="projectno != null  and projectno != '' " > aa.PROJECTNO = #{projectno} AND </if>
			<if test="planonline != null  and planonline != '' " > aa.PLANONLINE = #{planonline} AND </if>
		</trim>

		order by aa.subprojectno
	</select>

	<select id="queryPpmProjectList" parameterType="ppmProjectExtInfo" resultMap="PPMPROJECTINFO_ALL">
		select distinct p.id,
		p.projectno,
		p.projectname,
		p.subprojectno,
		p.subtype,
		p.sysno,
		substr(p.subprojectname, instr(p.subprojectname,'-') + 1) subprojectname,
		p.projectscale,
		p.deptno,
		p.busideptno,
		p.manauserid,
		p.busiuserid,
		p.plan_t_workload,
		p.actual_t_workload,
		p.plan_o_workload,
		p.actual_o_workload,
		p.plan_b_workload,
		p.actual_b_workload,
		p.builddate,
		p.startdate,
		p.status,
		p.isdelay,
		p.expectdate,
		p.actualdate,
		p.closedate,
		p.isdel,
		p.createtime,
		p.creators,
		p.lastmodtime,
		p.lastmoduser,
		p.orgarea,
		p.isproduction,
		p.isonline,
		p.coupledsys,
		p.gnd,
		p.healthscore,
		p.fjhid,
		p.issueworkload,
		p.testdeptno,
		s.sys_name sysname,
		e.empname,
		r.principala sysuserid,
		r.principala_name sysusername,
		oo.planonline,
		oo.orgarea org,
		s.om_level vel,
		w.safetytesttype,
		oo.safetytestname,
		oo.coupledsys coupledsysname
		from ppm_project p
		left join PPM_PROJECT_ONLINEFJH o on o.projectno = p.projectno
		left join aap_system s on p.sysno = s.system_id
		left join comm_employee e on p.Manauserid = e.badge
		left join aap_system_responsibility r on s.res_id = r.res_id
		left join PPM_ONLINE_ORGAREA oo on oo.onlineno=o.onlineno  and oo.projectno=p.subprojectno
		left join ppm_project_soft_workload w on w.projectno=p.projectno and w.sysno=p.sysno
		<trim prefix="WHERE" suffixOverrides="AND">
			<if test="true" > p.status is not null AND </if>
			<if test="projectno != null  and projectno != '' " > p.projectno=#{projectno} AND </if>
			<if test="planonline != null  and planonline != '' " > to_char(oo.planonline,'yyyy-mm-dd')=#{planonline} AND </if>
			<if test="onlineno != null  and onlineno != '' " > o.onlineno=#{onlineno} AND </if>
		</trim>

		order by p.subprojectno
	</select>

</mapper>

		FROM
		PPM.PPM_OUTSOURCING_BASIC
		WHERE NEW_CONTRACT_ID IN
		(SELECT
		ID
		FROM
		PPM.PPM_VENDOR_CONTRACT
		WHERE CONTRACT_NO IN
		(SELECT

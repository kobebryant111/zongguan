	<select id="queryBaseInfoList" parameterType="ppmDevelopGroupLedgerExt" resultMap="PPMDEVELOPGROUPLEDGER_ALL_EXT">
		SELECT 
			T.ID,
			T.JOB_ID,
			T.GROUP_ID,
			T.IF_STAR_PERSON,
			T.REMARK,
			T.CREATED_BY,
			T.CREATED_TIME,
			T.MODIFIED_BY,
			T.MODIFIED_TIME,
			U.USER_NAME,
			U.OUTSOURCE_NO,
			U.VM_ACCOUNT,
			U.POST_ID,
			U.OUTSOURCE_TYPE,
			U.ENTRY_TIME,
			U.LEAVING_TIME,
			I.GROUP_NAME,
			I.GROUP_LEADER_ID,
			I.GROUP_LEADER_NAME,
			I.GROUP_LEADER_CARD,
			I.GROUP_TYPE,
			U.STATE,
			U.DEPT_ID,
			D.LOCATION DEPT_NAME,
			OI.OUTSOURCNAME OUTSOURCE_NAME,
			E1.DICTNAME STATE_NAME,
			E2.DICTNAME OUTSOURCE_TYPE_NAME,
			E3.DICTNAME POST_NAME
       FROM PPM.PPM_DEVELOP_GROUP_LEDGER T
		   LEFT JOIN PPM.PPM_OUTSOURCING_BASIC U ON T.JOB_ID = U.JOB_ID
		   LEFT JOIN PPM.PPM_DEVELOP_GROUP_INFO I ON T.GROUP_ID = I.ID
		   LEFT JOIN PPM.COMM_DEPARTMENT D ON D.DEPID = U.DEPT_ID
		   LEFT JOIN PPM.PPM_OUTSOURCING_INFO OI ON OI.ORGCODE = U.OUTSOURCE_NO
		   LEFT JOIN PPM.EOS_DICT_ENTRY E1 ON E1.DICTID = U.STATE AND E1.DICTTYPEID = 'NEWKG_RYZT'
		   LEFT JOIN PPM.EOS_DICT_ENTRY E2 ON E2.DICTID = U.OUTSOURCE_TYPE AND E2.DICTTYPEID = 'NEWKG_WBFS'
		   LEFT JOIN PPM.EOS_DICT_ENTRY E3 ON E3.DICTID = U.POST_ID AND E3.DICTTYPEID = 'BUSI_OUTSOURCE_POSITION'
		<trim prefix="WHERE" suffixOverrides="AND">
            <if test="jobId != null and jobId != '' ">T.JOB_ID = #{jobId} AND</if>
            <if test="userName != null and userName != '' ">U.USER_NAME like '%'||#{userName}||'%' AND</if>
            <if test="outsourceType != null and outsourceType != '' ">U.OUTSOURCE_TYPE = #{outsourceType} AND</if>
            <if test="groupLeaderName != null and groupLeaderName != '' ">I.GROUP_LEADER_NAME = '%'||#{groupLeaderName}||'%' AND</if>
            <if test="state != null and state != '' "> U.STATE = #{state} AND </if>
            <if test="groupName != null and groupName != '' "> I.GROUP_NAME like '%'||#{groupName}||'%' AND </if>
            <if test="postId != null and postId != '' "> U.POST_ID = #{postId} AND </if>
        </trim>
		ORDER BY T.ID DESC
	</select>

</mapper>

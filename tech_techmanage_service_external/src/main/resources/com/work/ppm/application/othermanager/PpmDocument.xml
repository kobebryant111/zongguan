    <!-- 所有字段名称 -->
    <sql id="sql_flied_all">
        ID,
        CATALOGNO,
        DOCNAME,
        OBJECTTYPE,
        OBJECTNO,
        STOCKPATH,
        ISWRITE,
        ISREAD,
        DOCDOMAIN,
        TAG1,
        TAG2,
        TAG3,
        ISDEL,
        CREATETIME,
        CREATORS,
        LASTMODTIME,
        LASTMODUSER,
        DOCUMENTNO,
        CURRENTVERSION,
        IPAREA,
        CREATEORID,
        LASTMODUSERID,
        STAGE
    </sql>
    <!-- 查询分页  2020-03-24 k6991  -->
    <select id="queryPagerList" parameterType="map" resultMap="PPMDOCUMENT_ALL">
        SELECT
        <include refid="sql_flied_all"/>
        FROM PPM_DOCUMENT
        <trim prefix="WHERE" suffixOverrides="AND">
            <if test="id != null ">ID = #{id} AND</if>
            <if test="catalogno != null  and catalogno != '' ">CATALOGNO = #{catalogno} AND</if>
            <if test="docname != null  and docname != '' ">DOCNAME = #{docname} AND</if>
            <if test="objecttype != null  and objecttype != '' ">OBJECTTYPE = #{objecttype} AND</if>
            <if test="objectno != null  and objectno != '' ">OBJECTNO = #{objectno} AND</if>
            <if test="stockpath != null  and stockpath != '' ">STOCKPATH = #{stockpath} AND</if>
            <if test="iswrite != null  and iswrite != '' ">ISWRITE = #{iswrite} AND</if>
            <if test="isread != null  and isread != '' ">ISREAD = #{isread} AND</if>
            <if test="docdomain != null  and docdomain != '' ">DOCDOMAIN = #{docdomain} AND</if>
            <if test="tag1 != null  and tag1 != '' ">TAG1 = #{tag1} AND</if>
            <if test="tag2 != null  and tag2 != '' ">TAG2 = #{tag2} AND</if>
            <if test="tag3 != null  and tag3 != '' ">TAG3 = #{tag3} AND</if>
            <if test="isdel != null ">ISDEL = #{isdel} AND</if>
            <if test="createtime != null ">CREATETIME = #{createtime} AND</if>
            <if test="creators != null  and creators != '' ">CREATORS = #{creators} AND</if>
            <if test="lastmodtime != null ">LASTMODTIME = #{lastmodtime} AND</if>
            <if test="lastmoduser != null  and lastmoduser != '' ">LASTMODUSER = #{lastmoduser} AND</if>
            <if test="documentno != null  and documentno != '' ">DOCUMENTNO = #{documentno} AND</if>
            <if test="currentversion != null  and currentversion != '' ">CURRENTVERSION = #{currentversion} AND</if>
            <if test="iparea != null  and iparea != '' ">IPAREA = #{iparea} AND</if>
            <if test="createorid != null  and createorid != '' ">CREATEORID = #{createorid} AND</if>
            <if test="lastmoduserid != null  and lastmoduserid != '' ">LASTMODUSERID = #{lastmoduserid} AND</if>
            <if test="stage != null  and stage != '' ">STAGE = #{stage} AND</if>

        </trim>
    </select>


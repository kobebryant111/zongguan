    <!--通过id编辑 k6991 2020-03-24 -->
    <update id="updatePojo" parameterType="ppmDocumentInfo">
        UPDATE
        PPM_DOCUMENT
        <include refid="update_pojo_sql"/>
        <trim prefix="WHERE" suffixOverrides="AND">
            <if test="id != null ">ID=#{id} AND</if>
            <if test="documentnos != null  and documentnos != '' ">
                DOCUMENTNO IN (${documentnos}) AND</if>
            <if test="documentno != null  and documentno != '' ">DOCUMENTNO=#{documentno} AND</if>
        </trim>
    </update>


    <!-- 文档名称 -->
    <select id="docmentnoSeq" parameterType="map" resultType="string">
        select 'DOCUMENT'||to_char(sysdate,'yyyyMMdd')||lpad(PPM_DOCMENTNO_SEQ.Nextval,4,'0') from dual
    </select>


    <!--通过objecttype和objectno查询文件信息  k1327 2020-09-29 -->
    <select id="getDocumentInfos" parameterType="map" resultMap="PPMDOCUMENT_ALL">
        SELECT
        <include refid="sql_flied_all"/>
        FROM PPM_DOCUMENT D WHERE D.DOCUMENTNO=#{documentno}
    </select>

    <!--通过id查询  k6991 2021-09-03 -->
    <select id="getDetail" parameterType="ppmDocument" resultMap="PPMDOCUMENT_ALL">
        SELECT
        <include refid="sql_flied_all"/>
        FROM PPM_DOCUMENT WHERE OBJECTNO=#{objectno}
        AND OBJECTTYPE = 'A9'
        and ISDEL = '0'
    </select>

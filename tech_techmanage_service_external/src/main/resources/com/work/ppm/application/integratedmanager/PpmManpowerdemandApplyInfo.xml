	<select id="getListExport" parameterType="ppmManpowerdemandApplyinfo" resultType="ppmManpowerdemandApplyInfoExport">
		select to_char(to_date(m.createtime,'yyyy-MM-dd hh24:mi:ss'),'yyyy"年"MM"月"dd"日"') createtime,m.dept,e.dictname usertypename,
		a.usernum nums,
		m.username,a.addreason,a.personrequire,e1.dictname isadvertisename,
		(select count(1)
        from ppm_interviewee_overinfo ov
        left join ppm_interview_apply ap on ov.instanceid=ap.instanceid
        where ap.rl_id = a.id
        and INTERVIEWRESULT = 1)||'/'||a.usernum demandSchedule,
		decode(a.status,'0','进行中','1','已完成','') status,
		a.supplynames
		from ppm_manpowerdemand_apply_info a
		left join ppm_interviewee_overinfo o on (a.instanceid = o.instanceid)
		left join ppm_manpowerdemand_apply m on (a.instanceid=m.instanceid)
		left join eos_dict_entry e on e.dicttypeid='REQUIRE_PEOPLE_TYPE' and a.usertype=e.dictid
		left join eos_dict_entry e1 on e1.dicttypeid='WHETHER_CONTACT_RECRUITMENT' and a.isadvertise=e1.dictid
		<trim prefix="WHERE" suffixOverrides="AND">
			<if test="1==1" > m.status in ('1','2') AND </if>
			<if test="id != null " > ID = #{id} AND </if>
			<if test="usertype != null  and usertype != '' " > USERTYPE = #{usertype} AND </if>
			<if test="userlevel != null  and userlevel != '' " > USERLEVEL = #{userlevel} AND </if>
			<if test="usernum != null  and usernum != '' " > USERNUM = #{usernum} AND </if>
			<if test="addreason != null  and addreason != '' " > ADDREASON = #{addreason} AND </if>
			<if test="personrequire != null  and personrequire != '' " > PERSONREQUIRE = #{personrequire} AND </if>
			<if test="supplyids != null  and supplyids != '' " > SUPPLYIDS = #{supplyids} AND </if>
			<if test="supplynames != null  and supplynames != '' " > SUPPLYNAMES = #{supplynames} AND </if>
			<if test="createuserid != null  and createuserid != '' " > CREATEUSERID = #{createuserid} AND </if>
			<if test="createdate != null " > CREATEDATE = #{createdate} AND </if>
			<if test="isdel != null  and isdel != '' " > ISDEL = #{isdel} AND </if>
			<if test="instanceid != null  and instanceid != '' " > INSTANCEID = #{instanceid} AND </if>
			<if test="otherrequire != null  and otherrequire != '' " > OTHERREQUIRE = #{otherrequire} AND </if>
			<if test="isadvertise != null  and isadvertise != '' " > ISADVERTISE = #{isadvertise} AND </if>
			<if test="status != null  and status != '' " > STATUS = #{status} AND </if>
			<if test="userid != null  and userid != '' " > m.userid = #{userid} AND </if>
			<if test="depid != null  and depid != '' " > m.deptno = #{depid} AND </if>
		</trim>
		<trim prefix="order by " suffixOverrides=",">
			<if test="1==1" >  CREATEDATE desc, </if>
		</trim>
	</select>

        <select id="queryPagerList" parameterType="map" resultMap="ppmManpowerdemandApplyInfoInfo_map">
			SELECT A.*,M.USERID,M.USERNAME,M.DEPT,M.DEPTNO,M.SUPPLYTIME,M.STATUS MSTATUS,
			(SELECT COUNT(1)
            FROM PPM_INTERVIEWEE_OVERINFO OV
            LEFT JOIN PPM_INTERVIEW_APPLY AP ON OV.INSTANCEID=AP.INSTANCEID
            WHERE AP.RL_ID = A.ID
            AND INTERVIEWRESULT = 1) NUMS,
            (SELECT AP.INSTANCEID
            FROM PPM_INTERVIEW_APPLY AP
            WHERE AP.RL_ID = A.ID AND ROWNUM =1)  PROCESS_ID
			FROM PPM_MANPOWERDEMAND_APPLY_INFO A
			LEFT JOIN PPM_INTERVIEWEE_OVERINFO O ON (A.INSTANCEID = O.INSTANCEID)
			LEFT JOIN PPM_MANPOWERDEMAND_APPLY M ON (A.INSTANCEID=M.INSTANCEID)

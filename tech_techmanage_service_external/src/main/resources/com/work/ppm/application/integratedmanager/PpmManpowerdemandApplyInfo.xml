	<!--面试查询人力需求  k1327 2020-09-08 -->
	<select id="queryManpowerdemands"  parameterType="map"  resultMap="manpowerdemandsInfo">
		select I.ID,I.USERTYPE,a.userid,a.username,i.instanceid,i.usernum,a.supplytime,A.deptno depid,d.location depname,en.dictname USERTYPENAME,a.status mainstatus,i.status detailstatus
		from PPM_MANPOWERDEMAND_APPLY_INFO I LEFT JOIN PPM_MANPOWERDEMAND_APPLY A ON I.INSTANCEID=A.INSTANCEID
		left join eos_dict_entry en on en.dicttypeid='REQUIRE_PEOPLE_TYPE' and i.usertype=en.dictid
		left join comm_department d on A.Deptno=d.depid
		WHERE A.STATUS='1' and i.status='0'
		<if test="userid != null  and userid != '' " > and i.CREATEUSERID = #{userid} </if>
		<if test="depid != null  and depid != '' " > and A.deptno = #{depid} </if>
		ORDER BY A.CREATETIME DESC
	</select>
	<!--面试查询人力需求  k1327 2020-09-08 -->
	<select id="queryManpowerdemandsById"  parameterType="map"  resultMap="manpowerdemandsInfo">
		select I.ID,I.USERTYPE,a.userid,a.username,i.instanceid,i.usernum,a.supplytime,A.deptno depid,d.location depname,en.dictname USERTYPENAME,a.status mainstatus,i.status detailstatus
		from PPM_MANPOWERDEMAND_APPLY_INFO I JOIN PPM_MANPOWERDEMAND_APPLY A ON I.INSTANCEID=A.INSTANCEID
		left join eos_dict_entry en on en.dicttypeid='REQUIRE_PEOPLE_TYPE' and i.usertype=en.dictid
		left join comm_department d on A.Deptno=d.depid

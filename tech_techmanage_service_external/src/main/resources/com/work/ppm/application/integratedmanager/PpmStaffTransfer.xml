<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- author:ywwb905 2022-12-12 -->
<!--  人员移交信息 查询脚本 -->
<mapper namespace="com.work.ppm.application.model.integratedmanager.PpmStaffTransfer">
	 <resultMap type="ppmStaffTransfer" id="PPMSTAFFTRANSFER_ALL">
        <result property="id" column="ID" />
		<result property="instanceid" column="INSTANCEID" />
		<result property="applyerId" column="APPLYER_ID" />
		<result property="applyerDeptId" column="APPLYER_DEPT_ID" />
		<result property="state" column="STATE" />
		<result property="stateName" column="STATE_NAME" />
		<result property="currentId" column="CURRENT_ID" />
		<result property="currentName" column="CURRENT_NAME" />
		<result property="createdTime" column="CREATED_TIME" />
		<result property="createdBy" column="CREATED_BY" />
		<result property="modifiedTime" column="MODIFIED_TIME" />
		<result property="modifiedBy" column="MODIFIED_BY" />
		
     </resultMap>

     <!-- 所有字段名称 -->
    <sql id="sql_flied_all">
        ID,
			INSTANCEID,
			APPLYER_ID,
			APPLYER_DEPT_ID,
			STATE,
			STATE_NAME,
			CURRENT_ID,
			CURRENT_NAME,
			CREATED_TIME,
			CREATED_BY,
			MODIFIED_TIME,
			MODIFIED_BY
    </sql>
    <sql id="sql_select_condition">
        <trim prefix="WHERE" suffixOverrides="AND">
            <if test="id != null " > ID = #{id} AND </if>
				<if test="instanceid != null  and instanceid != '' " > INSTANCEID = #{instanceid} AND </if>
				<if test="applyerId != null  and applyerId != '' " > APPLYER_ID = #{applyerId} AND </if>
				<if test="applyerDeptId != null  and applyerDeptId != '' " > APPLYER_DEPT_ID = #{applyerDeptId} AND </if>
				<if test="state != null  and state != '' " > STATE = #{state} AND </if>
				<if test="stateName != null  and stateName != '' " > STATE_NAME = #{stateName} AND </if>
				<if test="currentId != null  and currentId != '' " > CURRENT_ID = #{currentId} AND </if>
				<if test="currentName != null  and currentName != '' " > CURRENT_NAME = #{currentName} AND </if>
				<if test="createdTime != null " > CREATED_TIME = #{createdTime} AND </if>
				<if test="createdBy != null  and createdBy != '' " > CREATED_BY = #{createdBy} AND </if>
				<if test="modifiedTime != null " > MODIFIED_TIME = #{modifiedTime} AND </if>
				<if test="modifiedBy != null  and modifiedBy != '' " > MODIFIED_BY = #{modifiedBy} AND </if>
				
        </trim>
    </sql>
    <!-- 查询分页  2022-12-12 ywwb905  -->
    <select id="queryPagerList" parameterType="map" resultMap="PPMSTAFFTRANSFER_ALL">
        SELECT
        <include refid="sql_flied_all" />
        FROM PPM_STAFF_TRANSFER
        <include refid="sql_select_condition" />
    </select>

    <!-- 新增  2022-12-12 ywwb905  -->
    <insert id="addPojo" parameterType="ppmStaffTransfer">
        INSERT INTO PPM_STAFF_TRANSFER (
        <trim suffixOverrides=",">
         <if test="id != null " > ID , </if>
				<if test="instanceid != null  and instanceid != '' " > INSTANCEID , </if>
				<if test="applyerId != null  and applyerId != '' " > APPLYER_ID , </if>
				<if test="applyerDeptId != null  and applyerDeptId != '' " > APPLYER_DEPT_ID , </if>
				<if test="state != null  and state != '' " > STATE , </if>
				<if test="stateName != null  and stateName != '' " > STATE_NAME , </if>
				<if test="currentId != null  and currentId != '' " > CURRENT_ID , </if>
				<if test="currentName != null  and currentName != '' " > CURRENT_NAME , </if>
				<if test="createdTime != null " > CREATED_TIME , </if>
				<if test="createdBy != null  and createdBy != '' " > CREATED_BY , </if>
				<if test="modifiedTime != null " > MODIFIED_TIME , </if>
				<if test="modifiedBy != null  and modifiedBy != '' " > MODIFIED_BY , </if>
				
          </trim>
        )
        VALUES(
        <trim suffixOverrides=",">
         <if test="id != null " > #{id} , </if>
				<if test="instanceid != null  and instanceid != '' " > #{instanceid} , </if>
				<if test="applyerId != null  and applyerId != '' " > #{applyerId} , </if>
				<if test="applyerDeptId != null  and applyerDeptId != '' " > #{applyerDeptId} , </if>
				<if test="state != null  and state != '' " > #{state} , </if>
				<if test="stateName != null  and stateName != '' " > #{stateName} , </if>
				<if test="currentId != null " > #{currentId} , </if>
				<if test="currentName != null " > #{currentName} , </if>
				<if test="createdTime != null " > #{createdTime} , </if>
				<if test="createdBy != null  and createdBy != '' " > #{createdBy} , </if>
				<if test="modifiedTime != null " > #{modifiedTime} , </if>
				<if test="modifiedBy != null  and modifiedBy != '' " > #{modifiedBy} , </if>
				
        </trim>
        )
    </insert>

    <!--通过id查询  ywwb905 2022-12-12 -->
    <select id="queryDetail" parameterType="ppmStaffTransfer" resultMap="PPMSTAFFTRANSFER_ALL">
        SELECT
        <include refid="sql_flied_all" />
        FROM PPM_STAFF_TRANSFER 
		<trim prefix="WHERE" suffixOverrides="AND">
            <if test="id != null " > ID = #{id} AND </if>
            <if test="instanceid != null " > INSTANCEID = #{instanceid} AND </if>
			<if test="id == null and instanceid == null" > ID = '' AND </if>
        </trim>
    </select>

     <!--查询集合  ywwb905 2022-12-12 -->
    <select id="getList" parameterType="ppmStaffTransfer" resultMap="PPMSTAFFTRANSFER_ALL">
        SELECT
        <include refid="sql_flied_all" />
        FROM PPM_STAFF_TRANSFER
        <include refid="sql_select_condition" />
    </select>
    <!-- update sql -->
    <sql id="update_pojo_sql">
        <trim prefix="SET" suffixOverrides=",">
            <if test="id != null " > ID=#{id} , </if>
				<if test="instanceid != null  and instanceid != '' " > INSTANCEID=#{instanceid} , </if>
				<if test="applyerId != null  and applyerId != '' " > APPLYER_ID=#{applyerId} , </if>
				<if test="applyerDeptId != null  and applyerDeptId != '' " > APPLYER_DEPT_ID=#{applyerDeptId} , </if>
				<if test="state != null  and state != '' " > STATE=#{state} , </if>
				<if test="stateName != null  and stateName != '' " > STATE_NAME=#{stateName} , </if>
				<if test="currentId != null " > CURRENT_ID=#{currentId} , </if>
				<if test="currentName != null " > CURRENT_NAME=#{currentName} , </if>
				<if test="createdTime != null " > CREATED_TIME=#{createdTime} , </if>
				<if test="createdBy != null  and createdBy != '' " > CREATED_BY=#{createdBy} , </if>
				<if test="modifiedTime != null " > MODIFIED_TIME=#{modifiedTime} , </if>
				<if test="modifiedBy != null  and modifiedBy != '' " > MODIFIED_BY=#{modifiedBy} , </if>
				
        </trim>
    </sql>

    <!--通过id编辑 ywwb905 2022-12-12 -->
    <update id="updatePojo" parameterType="ppmStaffTransfer">
        UPDATE
        PPM_STAFF_TRANSFER
        <include refid="update_pojo_sql" />
        WHERE ID=#{id}
    </update>

    <!--通过id批量删除  ywwb905 2022-12-12 -->
    <delete id="deleteById" parameterType="ppmStaffTransfer">
        DELETE
        FROM
        PPM_STAFF_TRANSFER
        WHERE ID = #{id}
    </delete>
	
	<!--通过instanceid批量删除  ywwb905 2022-12-12 -->
    <delete id="deleteByInstanceId" parameterType="ppmStaffTransfer">
        DELETE
        FROM
        PPM_STAFF_TRANSFER
        WHERE INSTANCEID=#{instanceid}
    </delete>


</mapper>

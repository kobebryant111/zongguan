    <!-- query list ext 2022-12-13 ywwb903  -->
    <select id="queryListExt" resultMap="VENDORCONTRACT_ALL_EXT">
        SELECT
        id,contract_no, contract_name, vendor,tax_rate,person_in_charge as pro_manager
        ,case
        TO_CHAR(sysdate, 'Q')
        when '1' then to_char(add_months(sysdate,-12), 'yyyy')||'-10-01'
        when '2' then to_char(sysdate, 'yyyy')||'-01-01'
        when '3' then to_char(sysdate, 'yyyy')||'-04-01'
        when '4' then to_char(sysdate, 'yyyy')||'-07-01'
        end as start_date
        ,case
        TO_CHAR(sysdate, 'Q')
        when '1' then to_char(add_months(sysdate,-12), 'yyyy')||'-12-31'
        when '2' then to_char(sysdate, 'yyyy')||'-03-31'
        when '3' then to_char(sysdate, 'yyyy')||'-06-30'
        when '4' then to_char(sysdate, 'yyyy')||'-09-30'
        end as end_date
        FROM (
        SELECT id,contract_no, contract_name, vendor,tax_rate FROM PPM_VENDOR_CONTRACT WHERE is_del = '0' and settlement_frequency = '1' and outsource_type = '1') a
        left join
        (SELECT PERSON_IN_CHARGE, NEW_CONTRACT_ID FROM PPM_OUTSOURCING_BASIC) b
        on a.id = b.new_contract_id
        where person_in_charge is not null
        group by id,contract_no, contract_name, vendor,tax_rate,person_in_charge

    </select>


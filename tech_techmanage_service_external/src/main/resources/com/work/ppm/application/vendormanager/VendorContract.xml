    <!--  查询  -->
    <!-- pager query 2022-10-26 ywwb903  -->
    <select id="queryPagerList" parameterType="map" resultMap="VENDORCONTRACT_ALL">
        SELECT  a.*,b.outsourcname vendor_name  FROM (
        SELECT
        ID
        ,CONTRACT_NO
        ,CONTRACT_NAME
        ,VENDOR
        ,PROGRESS
        ,START_DATE
        ,END_DATE
        ,ATTACH_INFO
        ,CASE
        when  sysdate &lt; to_date(start_date,'yyyy-MM-dd') then '未生效'
        when  sysdate &gt; to_date(end_date,'yyyy-MM-dd') then '已失效'
        else '生效中'  end  as STATUS
        ,TAX_RATE
        ,PRO_CONTENT
        ,SETTLEMENT_FREQUENCY
        ,CONTRACT_DOC
        ,IS_DEL
        FROM PPM_VENDOR_CONTRACT ) a
        LEFT JOIN
        (SELECT outsourcname , orgcode as vendor_id FROM PPM_OUTSOURCING_INFO) b
        ON a.vendor = b.vendor_id
        <include refid="sql_select_condition_pager"/>
        ORDER BY start_Date DESC
    </select>


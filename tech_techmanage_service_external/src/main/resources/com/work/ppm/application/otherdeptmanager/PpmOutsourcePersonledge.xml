	<select id="queryBaseInfo" parameterType="ppmOutsourcePersonledgeExt" resultMap="PPMOUTSOURCEPERSONLEDGE_ALL_EXT">
		SELECT 
		  OP.ID,
		  OP.JOB_ID,
		  OP.USER_NAME,
		  OP.DEPT_ID,
		  CD.ADMINID,
		  CD.LOCATION DEPT_NAME,
		  OP.PRO_PERSON,
		  CE.EMPNAME PRO_PERSON_NAME,
		  OP.SUPPLIER_ID,
		  OI.OUTSOURCNAME SUPPLIER_NAME,
		  OP.OUTSOURCE_TYPE,
		  E1.DICTNAME OUTSOURCE_TYPE_NAME,
		  OP.CARD_ID,
		  OP.STARTING_TIME,
		  OP.ENDING_TIME,
		  OP.STATE,
		  OP.TELPHONE,
		  OP.IMAGE_NO,
		  OP.CREATED_TIME,
		  OP.CREATED_BY
		FROM 
			PPM_OUTSOURCE_PERSONLEDGE OP
		LEFT JOIN 
			COMM_EMPLOYEE CE ON OP.PRO_PERSON = CE.BADGE
		LEFT JOIN 
			COMM_DEPARTMENT CD ON OP.DEPT_ID = CD.DEPID
		LEFT JOIN 
			PPM_OUTSOURCING_INFO OI ON OP.SUPPLIER_ID = OI.ORGCODE
		LEFT JOIN 
			EOS_DICT_ENTRY E1 ON OP.OUTSOURCE_TYPE = E1.DICTID AND E1.DICTTYPEID = 'BUSI_OUTSOURCE_OUTSOURCETYPE'
		<trim prefix="WHERE" suffixOverrides="AND">
			<if test="id != null and id != '' ">OP.ID = #{id} AND</if>
			<if test="jobId != null and jobId != '' ">OP.JOB_ID = #{jobId} AND</if>
        </trim>
	</select>
	
	<select id="queryBaseInfoList" parameterType="ppmOutsourcePersonledgeExt" resultMap="PPMOUTSOURCEPERSONLEDGE_ALL_EXT">
		SELECT 
		  OP.ID,
		  OP.JOB_ID,
		  OP.USER_NAME,
		  OP.DEPT_ID,
		  CD.ADMINID,
		  CD.LOCATION DEPT_NAME,
		  OP.PRO_PERSON,
		  CE.EMPNAME PRO_PERSON_NAME,
		  OP.SUPPLIER_ID,
		  OI.OUTSOURCNAME SUPPLIER_NAME,
		  OP.OUTSOURCE_TYPE,
		  E1.DICTNAME OUTSOURCE_TYPE_NAME,
		  OP.CARD_ID,
		  OP.STARTING_TIME,
		  OP.ENDING_TIME,
		  OP.STATE,
		  OP.TELPHONE,
		  OP.IMAGE_NO,
		  OP.CREATED_TIME,
		  OP.CREATED_BY
		FROM 
			PPM_OUTSOURCE_PERSONLEDGE OP
		LEFT JOIN 
			COMM_EMPLOYEE CE ON OP.PRO_PERSON = CE.BADGE
		LEFT JOIN 
			COMM_DEPARTMENT CD ON OP.DEPT_ID = CD.DEPID
		LEFT JOIN 
			PPM_OUTSOURCING_INFO OI ON OP.SUPPLIER_ID = OI.ORGCODE
		LEFT JOIN 
			EOS_DICT_ENTRY E1 ON OP.OUTSOURCE_TYPE = E1.DICTID AND E1.DICTTYPEID = 'BUSI_OUTSOURCE_OUTSOURCETYPE'
		<trim prefix="WHERE" suffixOverrides="AND">
            <if test="id != null and id != '' ">OP.ID = #{id} AND</if>
			<if test="jobId != null and jobId != '' ">OP.JOB_ID = #{jobId} AND</if>
			<if test="userName != null and userName != '' ">OP.USER_NAME = #{userName} AND</if>
			<if test="userNameVal != null and userNameVal != '' ">OP.USER_NAME like '%${userNameVal}%' AND</if>
            <if test="deptId != null and deptId != '' ">OP.DEPT_ID = #{deptId} AND</if>
            <if test="proPerson != null and proPerson != '' ">OP.PRO_PERSON = #{proPerson} AND</if>
            <if test="pmVal != null and pmVal != '' ">(OP.PRO_PERSON like '%${pmVal}%' OR CE.EMPNAME like '%${pmVal}%') AND</if>
            <if test="deptVal != null and deptVal != '' "> CD.LOCATION like '%${deptVal}%' AND</if>
            <if test="supplierId != null and supplierId != '' ">OP.SUPPLIER_ID = #{supplierId} AND</if>
            <if test="state != null and state != '' ">OP.STATE = #{state} AND</if>
            <if test="adminId != null ">CD.ADMINID = #{adminId} AND</if>
        </trim>
		ORDER BY OP.CREATED_TIME DESC
	</select>
	
	


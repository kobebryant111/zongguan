    </delete>
	
	<delete id="deleteInId" parameterType="ppmSupplierRosterInfo">
        UPDATE
        PPM_SUPPLIER_ROSTER_INFO
		SET IS_DEL = '1'
		<trim prefix="WHERE" suffixOverrides="AND">
			<if test="true">PID=#{pid} AND IS_DEL = '0' AND </if>
			<if test="delVal != null and delVal != '' ">ID NOT IN (${delVal}) AND</if>
		</trim>
    </delete>
	
	<select id="queryBaseInfoList" parameterType="ppmSupplierRosterInfoExt" resultMap="PPMSUPPLIERROSTERINFO_ALL_EXT">
		SELECT 
		  RI.ID,
		  RI.PID,
		  RI.DEPT_ID,
		  CD.LOCATION DEPT_NAME,
		  RI.SUPPLIER_CODE,
		  RI.SUPPLIER_NAME,
		  RI.SUPPLIER_TYPE,
		  RI.SERVICE_MODE,
		  RI.SERVICE_TYPE,
		  RI.IS_SUBCONTRACT,
		  RI.SYSTEM_ID,
		  SI.NAME SYSTEM_NAME,
		  RI.PROJECT_ID,
		  PI.NAME PROJECT_NAME,
		  RI.START_TIME,
		  RI.END_TIME,
		  RI.SUPPLIER_YEAR,
		  RI.ACCESS_RESULT,
		  RI.FILE_NO,
		  RI.IS_DEL,
		  OI.IS_FEAT,
		  RI.CREATED_TIME, 
		  RI.CREATED_BY,
		  RI.MODIFIED_TIME,
		  RI.MODIFIED_BY
		FROM PPM_SUPPLIER_ROSTER_INFO RI
			LEFT JOIN PPM_OUTSOURCING_INFO OI ON RI.PID = OI.ID
			LEFT JOIN COMM_DEPARTMENT CD ON RI.DEPT_ID = CD.DEPID
			LEFT JOIN PPM_PROJECT_INFO PI ON PI.ID = RI.PROJECT_ID
			LEFT JOIN PPM_SYSTEM_INFO SI ON SI.ID = RI.SYSTEM_ID 
		<trim prefix="WHERE" suffixOverrides="AND">
            <if test="isDel != null and isDel != '' ">RI.IS_DEL = #{isDel} AND</if>
            <if test="pid != null and pid != '' ">RI.PID = #{pid} AND</if>
            <if test="deptId != null and deptId != '' ">RI.DEPT_ID = #{deptId} AND</if>
            <if test="assessYear != null and assessYear != '' ">RI.SUPPLIER_YEAR = #{supplierYear} AND</if>
            <if test="supplierCode != null and supplierCode != '' ">RI.SUPPLIER_CODE = #{supplierCode} AND</if>
            <if test="supplierName != null and supplierName != '' ">RI.SUPPLIER_NAME = #{supplierName} AND</if>
			<if test="supplierType != null and supplierType != '' " > RI.SUPPLIER_TYPE = #{supplierType} AND </if>
			<if test="systemId != null and systemId != '' " > RI.SYSTEM_ID = #{systemId} AND </if>
			<if test="projectId != null and projectId != '' " > RI.PROJECT_ID = #{projectId} AND </if>
        </trim>
		ORDER BY RI.ID DESC
	</select>
	
	


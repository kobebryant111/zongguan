    <!--自定义代办检验分值  k76239 2021-11-27 -->
    <select id="checkPoint" parameterType="ppmDepkpiTitle" resultMap="PPMDEPKPITITLE_ALL_EXD">
        SELECT
        NVL(T1.BASEPOINT,0) BASEPOINT,NVL(SUM(T2.BASEPOINT),0) SUMCONTENTPOINT,T1.ID
        FROM PPM_DEPKPI_TITLE T1
        LEFT JOIN PPM_DEPKPI_CONTENT T2
        ON T1.ID=T2.TITLEID
        WHERE T1.DEPID=#{depid} AND T1.HASSON=#{hasson}
        GROUP BY T1.BASEPOINT,T1.ID
    </select>


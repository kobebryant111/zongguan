		<!--查询团队的分管经理-->
		<select id="queryGroupManager" parameterType="map" resultMap="PPMDATEAMGROUP_ALL">
			select * from (
			select pdt.*,'1' flag from ppm_da_team_user u left join ppm.ppm_da_team_group pdt on u.teamgrpupid=pdt.id where u.userid=#{userid}
			and u.teamgrpupid is not null
			union
			select pdt.*,'2' flag from ppm.ppm_da_team_group pdt where  pdt.groupuserid=#{userid} and pdt.isdel='0'
			)t order by t.flag desc

        <result property="cabinet" column="CABINET"/>
        <result property="cabinetPos" column="CABINETPOS"/>
        <result property="sn" column="SN"/>
        <result property="f5ip" column="F5IP"/>
        <result property="ip" column="IP"/>
        <result property="serverIp" column="SERVERIP"/>

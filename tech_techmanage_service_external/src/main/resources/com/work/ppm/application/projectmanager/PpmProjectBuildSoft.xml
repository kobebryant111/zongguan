    <!-- 项目上线数 2020-08-05 k6991 -->
    <select id="queryProjectTree" parameterType="map" resultType="ppmProjectBuildSoftTree">
        select * from (
        select s.deptno as projectno,
        (select location from comm_department where depid = s.deptno) as projectname,
        '-1' as pid,
        '' busiuserid,
        '' manauserid,
        '' manausername,
        '' empname,
        to_date('') expectdate,
        '' sysno,
        '' sysname,
        s.proattrbutes proattrbutes
        from ppm_project_build_soft s
        where s.status is not null
        and s.isdel = '0'
        union
        select projectno,
        projectname,
        deptno as pid,
        busiuserid,
        manauserid,
        em.empname manausername,
        e.empname empname,
        expectdate,
        p.sysno,
        s.sys_name sysname,
        p.proattrbutes  proattrbutes
        from ppm_project_build_soft p
        left join comm_employee em
        on p.manauserid = em.badge
        left join comm_employee e
        on p.busiuserid = e.badge
        left join aap_system s
        on p.sysno = s.system_id
        where status is not null
        <![CDATA[
      and status <> '全部上线'
      and status <> '已关闭'
      and status <> '项目终止'
      ]]>
        and isdel = '0'
        ) temp where proattrbutes is not null
    </select>

    <!-- 查询系统负责人 2020-08-06 k6991 -->
    <select id="queryMAS" parameterType="map" resultType="ppmProjectBuildSoftInfo">
        select s.sysno,a.sys_name sysname,ar.principala manauserid,ar.principala_name manausername from
        ppm_project_build_soft s
        left join aap_system a on a.system_id=s.sysno
        left join aap_system_responsibility ar on a.res_id=ar.res_id
        where s.projectno= #{projectno}
    </select>

    <!-- 查询系统负责人 2020-12-11 k6991 -->
    <select id="querySystemPrincipal" parameterType="list" resultType="ppmProjectBuildSoftInfo">
        SELECT S.SYSTEM_ID sysno,S.SYS_NAME sysname,R.PRINCIPALA manauserid, R.PRINCIPALA_NAME manausername
        FROM AAP_SYSTEM S
        LEFT JOIN AAP_SYSTEM_RESPONSIBILITY R
        ON S.RES_ID = R.RES_ID
        WHERE S.SYSTEM_ID IN
        <foreach collection="list" item="item" separator="," open="(" close=")">

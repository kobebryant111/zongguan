    <select id="getProjectBuildSoftByDenamdID" parameterType="ppmProjectBuildSoft" resultMap="PPMPROJECTBUILDSOFTINFO_ALL">
        select p.*,
        s.sys_name sysname,
        d.location,
        e.empname,
        em.empname manausername,
        f.location depname
        from ppm_project_build_soft p
        left join aap_system s on p.sysno = s.system_id
        left join comm_employee e on p.BUSIUSERID = e.badge
        left join comm_employee em on p.manauserid = em.badge
        left join comm_department d on p.busideptno = d.depid
        left join comm_department f on f.depid = p.deptno
        where p.status is not null
        and p.status not in ('全部上线','已关闭','项目终止')
        and p.demandno =#{demandno}
    </select>

    <select id="getProjectInfoByOnlineno" parameterType="ppmProjectBuildSoft" resultMap="PPMPROJECTBUILDSOFTINFO_ALL">
        select p.*,
        s.sys_name sysname,
        d.location,
        e.empname,
        em.empname manausername,
        f.location depname
        from ppm_project_build_soft p
        left join aap_system s on p.sysno = s.system_id
        left join comm_employee e on p.BUSIUSERID = e.badge
        left join comm_employee em on p.manauserid = em.badge
        left join comm_department d on p.busideptno = d.depid
        left join comm_department f on f.depid = p.deptno
        where p.status is not null
        and p.projectno in (select n.projectno
                            from ppm_project_newonline n
                            where n.onlineno = #{onlineno})

    </select>


	<!--通过id编辑 ywwb905 2023-05-19 -->
    <update id="updatePojos" parameterType="ppmAccessCardLedgerExt">
        UPDATE
        PPM_ACCESS_CARD_LEDGER
        <trim prefix="SET" suffixOverrides=",">
			<if test="accessCardNumber != null  and accessCardNumber != '' " > ACCESS_CARD_NUMBER=#{accessCardNumber} , </if>
			<if test="receiveTime != null " > RECEIVE_TIME=#{receiveTime} , </if>
			<if test="ifReturnCard != null and ifReturnCard != ''" > IF_RETURN_CARD=#{ifReturnCard} , </if>
			<if test="returnTime != null " > RETURN_TIME=#{returnTime} , </if>
			<if test="remarkJbb != null  and remarkJbb != '' " > REMARK_JBB=#{remarkJbb} , </if>
			<if test="modifiedTime != null " > MODIFIED_TIME=#{modifiedTime} , </if>
			<if test="modifiedBy != null  and modifiedBy != '' " > MODIFIED_BY=#{modifiedBy} , </if>
        </trim>
		<if test="idList != null and idList != ''">
			WHERE ID IN 
			<foreach collection="idList.split(',')" item="item" open="(" separator="," close=")" >
				#{item}
			</foreach>
		</if>
		<if test="idList == null"> 
			WHERE ID = ''
		</if>
    </update>
	

	<select id="queryBaseInfoList" parameterType="ppmAccessCardLedgerExt" resultMap="PPMACCESSCARDLEDGER_ALL_EXT">
		SELECT 
			B.JOB_ID,
			B.USER_NAME,
			B.CERTIFICATE_NUMBER ID_CARD_NO,
			B.MOBILE TELEPHONE,
			B.OUTSOURCE_NO,
			I.OUTSOURCNAME OUTSOURCE_NAME,
			B.ENTRANCE_CARD VIRTUAL_MACHINE_ID,
			B.DEPT_ID,
			B.SEX,
			D.LOCATION DEPT_NAME,
			L.ID,
			L.PID,
			L.IF_CREATE_RETURN,
			CASE WHEN L.IF_MAKE_CARD IS NULL THEN 'N' 
				ELSE L.IF_MAKE_CARD 
			END IF_MAKE_CARD,
			L.ACCESS_CARD_NUMBER,
			L.IF_RECEIVE_CARD,
			L.RECEIVE_TIME,
			CASE WHEN (L.IF_RETURN_CARD IS NULL AND L.IF_RECEIVE_CARD = 'Y' ) THEN 'W' 
				ELSE L.IF_RETURN_CARD 
			END IF_RETURN_CARD,
			L.RETURN_TIME,
			L.CREDIT_CARD_NUMBERS,
			L.ACCOUNT_NUMBER,
			L.PLACE_OF_ACCOUNT,
			L.OUT_BANK_NAME,
			L.IS_DEL,
			L.STATE,
			L.REMARK_YGB,
			L.REMARK_JBB
        FROM PPM_ACCESS_CARD_LEDGER L
			LEFT JOIN PPM_OUTSOURCING_BASIC B ON B.JOB_ID = L.JOB_ID
			LEFT JOIN COMM_DEPARTMENT D ON B.DEPT_ID = D.DEPID
			LEFT JOIN PPM_OUTSOURCING_INFO I ON I.ORGCODE = B.OUTSOURCE_NO
		<trim prefix="WHERE" suffixOverrides="AND">
            <if test="jobId != null and jobId != '' ">B.JOB_ID = #{jobId} AND</if>
            <if test="userName != null and userName != '' ">B.USER_NAME like '%'||#{userName}||'%' AND</if>
            <if test="deptId != null and deptId != '' ">B.DEPT_ID = #{deptId} AND</if>
            <if test="ifMakeCard != null and ifMakeCard != '' and ifMakeCard == 0 "> (L.IF_MAKE_CARD = #{ifMakeCard} OR L.IF_MAKE_CARD IS NULL) AND</if>
            <if test="ifMakeCard != null and ifMakeCard != '' and ifMakeCard == 1 "> L.IF_MAKE_CARD IN ('W','Y') AND </if>
			<if test="ifMakeCard != null and ifMakeCard != '' and ifMakeCard == 2 "> L.IF_MAKE_CARD = 'Y' AND </if>
			<if test="ifMakeCard != null and ifMakeCard != '' and ifMakeCard == 3 "> L.IF_MAKE_CARD = '' AND </if>
            <if test="ifReceiveCard != null and ifReceiveCard != ''">L.IF_RECEIVE_CARD = #{ifReceiveCard} AND </if>
            <if test="ifReturnCard != null and ifReturnCard != ''">L.IF_RETURN_CARD = #{ifReturnCard} AND </if>
            <if test="ifCreateReturn != null and ifCreateReturn != ''">L.IF_CREATE_RETURN = #{ifCreateReturn} AND </if>
            <if test="isDel != null and isDel != ''">L.IS_DEL = #{isDel} AND </if>
            <if test="state != null and state != ''">L.STATE = #{state} AND </if>
            <if test="pid != null and pid != ''">L.PID = #{pid} AND </if>
        </trim>
		ORDER BY B.ID DESC
	</select>
	


    <select id="queryZdyCommit" parameterType="ppmDepkpiContentInfo" resultMap="PPMDEPKPICONTENT_ALL">
        SELECT
        <include refid="Asql_flied_all"/>
        FROM PPM_DEPKPI_CONTENT a
        LEFT JOIN PPM_DEPKPI_DEP_CHECK b
        ON a.DETAILID=b.ID
        WHERE a.TYEAR=#{tyear} AND a.DEPID=#{depid} AND a.TARGETTYPE=2 AND a.ISDEL=0

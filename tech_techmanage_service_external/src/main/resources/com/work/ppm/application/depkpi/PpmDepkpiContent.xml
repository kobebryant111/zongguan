        <include refid="Asql_flied_all"/>, b.STATUS DBSTATUS, b.NAME TARGETNAME, z.NAME TITLENAME, z.LASTMODTIME
        from PPM_DEPKPI_CONTENT a
        left join PPM_DEPKPI_DEP_CHECK b
        on a.detailid = b.id
        LEFT JOIN PPM_DEPKPI_TITLE z
        ON a.TITLEID=z.ID
        <trim prefix="WHERE" suffixOverrides="AND">
            <if test="id != null ">a.ID = #{id} AND</if>
            <if test="tyear != null">a.TYEAR = #{tyear} AND</if>
            <if test="depid != null ">a.DEPID = #{depid} AND</if>
            <if test="targetid != null ">a.TARGETID = #{targetid} AND</if>
            <if test="targettype != null ">a.TARGETTYPE=#{targettype} AND</if>
            <if test="detailid != null ">a.DETAILID = #{detailid} AND</if>
            <if test="titleid != null ">a.TITLEID = #{titleid} AND</if>
            <if test="basepoint != null ">a.BASEPOINT = #{basepoint} AND</if>
            <if test="content != null ">a.CONTENT like '%'|| #{content} ||'%' AND</if>
            <if test="standard != null ">a.STANDARD = #{standard} AND</if>
            <if test="startdate != null ">a.STARTDATE = #{startdate} AND</if>
            <if test="enddate != null ">a.ENDDATE = #{enddate} AND</if>
            <if test="evaltype != null ">a.EVALTYPE = #{evaltype} AND</if>
            <if test="selfeval != null ">a.SELFEVAL = #{selfeval} AND</if>
            <if test="isdel != null ">a.ISDEL = #{isdel} AND</if>
            <if test="sign != null ">b.SIGN = #{sign} AND</if>
            <if test="parentTitleid != null ">
                a.titleid in (
                SELECT id FROM PPM_DEPKPI_TITLE WHERE HASSON = 0
                START WITH ID = #{parentTitleid}
                CONNECT BY PRIOR ID = PARENTID
                ) AND
            </if>
            <if test="parentDetailid != null ">
                a.detailid in (
                SELECT id FROM PPM_DEPKPI_DEP_CHECK WHERE HASSON = 0
                START WITH ID = #{parentDetailid}
                CONNECT BY PRIOR ID = PARENTID
                ) AND
            </if>
            b.dbuser = #{userid}
        </trim>
        order by a.depid, a.detailid,z.lastmodtime desc, a.lastmodtime desc
    </select>

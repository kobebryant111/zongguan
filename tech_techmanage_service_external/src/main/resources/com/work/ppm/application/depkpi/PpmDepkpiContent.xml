    <select id="querySum" parameterType="ppmDepkpiContent" resultMap="PPMDEPKPICONTENT_ALL_EXT">
        select count(0) countcontent,
        nvl(sum(decode (nvl(a.secondcheckpoint,-1), -1, a.firstcheckpoint, a.secondcheckpoint)),0) sumpoint,
        (select count(0) from PPM_DEPKPI_CONTENT where nvl(secondcheckstatus,0) &lt;&gt; 1  and  DEPID = #{depid} AND
        TYEAR = #{tyear} AND isdel = 0 ) commitsum,

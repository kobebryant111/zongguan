        PPM_DEPKPI_CONTENT a left join PPM_DEPKPI_DEP_CHECK b on (b.id = a.detailid)
        <trim prefix="WHERE" suffixOverrides="AND">
            <if test="depid != null ">a.DEPID = #{depid} AND</if>
            <if test="tyear != null ">a.TYEAR = #{tyear} AND</if>
            a.ISDEL = 0
        </trim>
        group by a.depid
    </select>


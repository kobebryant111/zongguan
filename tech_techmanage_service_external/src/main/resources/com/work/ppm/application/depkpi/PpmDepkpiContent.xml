    <!--分数显示查询  k76239 2021-11-27 -->
    <select id="queryContentList" parameterType="ppmDepkpiContentInfo" resultMap="PPMDEPKPICONTENT_ALL_EXT">
        SELECT
        a.ID,
        a.TYEAR,
        a.DEPID,
        a.TARGETID,
        a.TARGETTYPE,
        a.TITLEID,
        a.DETAILID,
        a.BASEPOINT,
        a.CONTENT,
        a.STANDARD,
        a.STARTDATE,
        a.ENDDATE,
        a.EVALTYPE,
        a.SELFEVAL,
        a.ISDEL,
        a.LASTMODUSERID,
        a.LASTMODTIME,
        a.SELFEVALRES,
        a.SELFEVALSTATUS,
        a.FIRSTCHECKRES,
        a.FIRSTCHECKPOINT,
        a.FIRSTCHECKREMARK,
        a.FIRSTCHECKSTATUS,
        a.SECONDCHECKRES,
        nvl(a.SECONDCHECKPOINT,0) SECONDCHECKPOINT,
        a.SECONDCHECKREMARK,
        a.SECONDCHECKSTATUS,
        a.MAXPOINT,
        a.MINPOINT,
        a.FIRSTCHECKTIME,
        a.SECONDCHECKTIME,
        b.NAME TARGETNAME,
        z.NAME TITLENAME,
        z.LASTMODTIME,
        (select d.EMPNAME from COMM_EMPLOYEE d
        where d.ISDISABLED=0 and d.BADGE = c.firstcheck) FIRSTCHECK,
        (select d.EMPNAME from COMM_EMPLOYEE d
        where d.ISDISABLED=0 and d.BADGE = c.secondcheck) SECONDCHECK
        FROM PPM_DEPKPI_CONTENT a
        LEFT JOIN PPM_DEPKPI_DEP_CHECK b
        ON a.DETAILID=b.ID
        LEFT JOIN PPM_DEPKPI_TITLE z
        ON a.TITLEID=z.ID
        LEFT JOIN PPM_DEPKPI_DEP_REL c
        <if test="sign == 1 ">ON b.MARKERDEPID=c.DEPID</if>
        <if test="sign == 2 ">ON b.MARKERDEPID=c.CENTERID</if>
        <include refid="sql_select_a_condition"/>
        and b.SIGN=#{sign} and c.SIGN=#{sign}
        order by a.depid, a.detailid,z.lastmodtime desc, a.lastmodtime desc
    </select>


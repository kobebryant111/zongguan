        <if test="sign == 2">AND nvl(a.SECONDCHECKSTATUS,0)&lt;&gt;1</if>
        <if test="sign == 3">AND nvl(a.SELFEVALSTATUS,0)&lt;&gt;1 AND b.SELFEVAL=1</if>
    </select>

    <select id="getListIsSecond" parameterType="ppmDepkpiContentInfo" resultMap="PPMDEPKPICONTENT_ALL_EXT">
        SELECT
        <include refid="Asql_flied_all"/>,
        (select c.EMPNAME from COMM_EMPLOYEE c
        where c.ISDISABLED=0 and c.BADGE =(decode(a.targettype, 2, b.firstcheck, ''))) FIRSTCHECK,
        (select d.EMPNAME from COMM_EMPLOYEE d
        where d.ISDISABLED=0 and d.BADGE = b.secondcheck) SECONDCHECK,
        #{isSecond} ISSECOND,
        e.DBUSER, e.NAME TARGETNAME, z.NAME TITLENAME, z.LASTMODTIME
        FROM PPM_DEPKPI_CONTENT a
        left join PPM_DEPKPI_DEP_REL b
        on a.depid=b.depid
        left join PPM_DEPKPI_DEP_CHECK e
        on a.DETAILID=e.ID
        LEFT JOIN PPM_DEPKPI_TITLE z
        ON a.TITLEID=z.ID
        where a.isdel=#{isdel}
        <if test="depid != null "> and a.depid=#{depid}</if>
        <if test="dbuser != null "> and e.DBUSER=#{dbuser} </if>
        <if test="detailid != null "> and a.detailid=#{detailid}</if>
        <if test="content != null ">and a.CONTENT like '%'|| #{content} ||'%'</if>
        <if test="tyear != null">AND a.TYEAR = #{tyear} </if>
        <if test="targettype != null">AND a.targettype = #{targettype} </if>
        <if test="parentTitleid != null ">
            and a.titleid in (
            SELECT id FROM PPM_DEPKPI_TITLE WHERE HASSON = 0
            START WITH ID = #{parentTitleid}
            CONNECT BY PRIOR ID = PARENTID
            )
        </if>
        <if test="parentDetailid != null ">
            and a.detailid in (
            SELECT id FROM PPM_DEPKPI_DEP_CHECK WHERE HASSON = 0
            START WITH ID = #{parentDetailid}
            CONNECT BY PRIOR ID = PARENTID
            )
        </if>
        order by a.depid, a.targettype asc, a.detailid,z.lastmodtime desc, a.lastmodtime desc
    </select>


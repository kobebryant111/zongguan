		<select id="queryDetailAll" parameterType="ppmOutsourcingExt" resultMap="PPMOUTSOURCINGEXT_ALL_EXT">
			SELECT
			e.*,
			decode(e.attendance_type,'XXXX','轮班','YYYY','不考勤',null,'',replace(p.name,'星期一','')) attendance_Typename,
			decode(e.virtual_desktop,'01','是','02','否','') virtual_Desktopname,
			decode(e.svn_limit,'1','是','0','否','') svn_Limitname,
			decode(e.special_auth,'1','是','2','否','') special_Authname,
			en.dictname card_typename,
			en1.dictname political_statusname
			FROM PPM_OUTSOURCING_EXT e
			LEFT JOIN ppm_kq_duty_plan p on p.kq_type=e.attendance_type and p.code='1'
			LEFT JOIN EOS_DICT_ENTRY en on en.dicttypeid='NEWKG_CERTIFTYPE' and en.dictid=e.card_type
			LEFT JOIN EOS_DICT_ENTRY en1 on en1.dicttypeid='NEWKG_POLITICAL' and en1.dictid=e.political_status

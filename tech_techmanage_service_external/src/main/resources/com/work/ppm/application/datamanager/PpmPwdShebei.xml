    <select id="querySheBeiEndTime" parameterType="map" resultMap="PPMPWDSHEBEI_ALL" >
        select t.* from ppm_pwd_shebei t
        left join ppm_project_flow t1 on t1.instanceid=t.instanceid
        left join ppm_pwd_shebei_configure t2 on t2.systemid=t.systemname and t.usertype=t2.usertype and t2.ip=t.ip and t2.userid= t.username
        where t1.flowstatus='进行中' and t.checkindate is null and t.endtime is not null and t.endtime > sysdate
        <if   test="groupname != null and groupname != ''">
            and t2.groupname = #{groupname}
        </if>
        <if  test="groupname != null and groupname != ''">
            <if  test="username != null and username != ''">
                and t.username = #{username}
            </if>
            <if  test="ip != null and ip != ''">
                and t.ip = #{ip}
            </if>
        </if>
        order by t.endtime desc
    </select>

    <select id="getSheBeiList" parameterType="map" resultMap="PPMPWDSHEBEI_ALL">

        select t.* from ppm_pwd_shebei t
        left join ppm_project_flow t1 on t1.instanceid=t.instanceid
        where t1.flowstatus='进行中' and (t.hascheckin!='1' or t.hascheckin is null)
        <if  test="ip != null and ip != ''">
            AND t.ip=#{ip}
        </if>
        <if  test="username != null and username != ''">
            AND t.username=#{username}
        </if>
        <if  test="loginuser != null and loginuser != ''">
            and t.loginuser=#{loginuser}
        </if>
        and t.endtime>to_date(#{nowdate},'yyyy-MM-dd hh24:mi:ss')
        order by t.endtime desc
    </select>

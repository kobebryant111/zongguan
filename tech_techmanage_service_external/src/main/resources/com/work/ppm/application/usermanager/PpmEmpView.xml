				<if test="empstatus != null  and empstatus != '' " > EMPSTATUS=#{empstatus} AND </if>
				
            </trim>
        </select>
        <!-- update sql -->
        <sql id="update_pojo_sql">
        	<trim prefix="SET" suffixOverrides=",">
        		<if test="badge != null  and badge != '' " > BADGE=#{badge} , </if>
				<if test="empname != null  and empname != '' " > EMPNAME=#{empname} , </if>
				<if test="compid != null " > COMPID=#{compid} , </if>
				<if test="depid != null  and depid != '' " > DEPID=#{depid} , </if>
				<if test="jobid != null " > JOBID=#{jobid} , </if>
				<if test="headship != null  and headship != '' " > HEADSHIP=#{headship} , </if>
				<if test="empauth != null  and empauth != '' " > EMPAUTH=#{empauth} , </if>
				<if test="officephone != null  and officephone != '' " > OFFICEPHONE=#{officephone} , </if>
				<if test="shortphone != null  and shortphone != '' " > SHORTPHONE=#{shortphone} , </if>
				<if test="mobiletelphone != null  and mobiletelphone != '' " > MOBILETELPHONE=#{mobiletelphone} , </if>

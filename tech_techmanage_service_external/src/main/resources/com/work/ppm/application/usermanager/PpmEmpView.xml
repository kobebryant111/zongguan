            </trim>
        </sql>

        <!--通过id编辑 k6991 2020-06-16 -->
    	<update id="updatePojo" parameterType="ppmEmpView">
        	UPDATE
        	PPM_EMP_VIEW
        	<include refid="update_pojo_sql" />
        	WHERE BADGE=#{badge}
        </update>

        <!--通过id批量删除  k6991 2020-06-16 -->
        <delete id="deleteById" parameterType="ppmEmpView">
        	DELETE
        	FROM
        	PPM_EMP_VIEW
        	WHERE BADGE = #{badge}
        </delete>

        <!-- 获取主键id -->
        <select id="getPrimaryKey" parameterType="map" resultType="long">
            SELECT MAX(BADGE) FROM PPM_EMP_VIEW
        </select>
	<resultMap type="ppmEmpView" id="GETBADGEFORNAME_MAP">
		<result property="badge" column="BADGE" />
		<result property="empname" column="EMPNAME" />
	</resultMap>
	<!-- 根据用户编号查询用户名称 2020-09-04 -->
	<select id="getBadgeForName" parameterType="map" resultMap="GETBADGEFORNAME_MAP">
		SELECT
		BADGE，
		EMPNAME
		FROM PPM_EMP_VIEW  WHERE BADGE=#{badge}
	</select>
</mapper>

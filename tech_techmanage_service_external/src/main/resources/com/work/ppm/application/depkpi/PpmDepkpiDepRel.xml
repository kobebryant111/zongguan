		<!--查询集合  k1327 2021-11-18 -->
		<select id="getDepCenList" parameterType="ppmDepkpiDepRel" resultMap="PPMDEPKPIDEPREL_ALL">
			select to_char(d.depid) depid,m.centerid,e.badge director,m.userid depcharge,
			c.resuserid centercharge,'1' sign
			from comm_department d
			left join comm_employee e on d.director=e.eidhr
			left join ppm_da_dept_manager m on to_char(d.depid)=m.deptid
			left join ppm_da_center c on m.centerid=to_char(c.id)
			where d.adminid='7004' and d.isdisabled='0' and d.depid>0
			union
			select '' depid,to_char(c.id) centerid,'' director,'' depcharge,c.resuserid centercharge,'2' sign
			from ppm_da_center c
			union
			select to_char(d.depid) depid,m.centerid,e.badge director,m.userid depcharge,
			c.resuserid centercharge,'3' sign
			from comm_department d
			left join comm_employee e on d.director=e.eidhr
			left join ppm_da_dept_manager m on to_char(d.depid)=m.deptid
			left join ppm_da_center c on m.centerid=to_char(c.id)
			where d.depid='7004' and d.isdisabled='0'
		</select>

		<!--查询集合  k1327 2021-05-20 -->
		<select id="getDepKpiDepRelList" parameterType="ppmDepkpiDepRelInfo" resultMap="PPMDEPKPIDEPREL_ALL_EXT">
			select r.id,
			r.depid,
			r.director,
			r.depcharge,
			r.centercharge,
			r.centerid,
			r.tyear,
			r.isdel,
			r.lastmoduserid,
			r.lastmodtime,
			r.sign,
			en.dictname signname,
			d.location depname,
			c.centername,
			e.empname directorname,
			e1.empname depchargename,
			e2.empname centerchargename,
			r.marker,
			r.firstcheck,
			r.secondcheck,
			e3.empname markername,
			e4.empname firstcheckname,
			e5.empname secondcheckname
			from PPM_DEPKPI_DEP_REL r left join comm_department d on r.depid=d.depid
			left join ppm_da_center c on r.centerid=c.id
			left join comm_employee e on e.badge=r.director
			left join comm_employee e1 on e1.badge=r.depcharge
			left join comm_employee e2 on e2.badge=r.centercharge
			left join comm_employee e3 on e3.badge=r.marker
			left join comm_employee e4 on e4.badge=r.firstcheck
			left join comm_employee e5 on e5.badge=r.secondcheck
			left join eos_dict_entry en on en.dictid=r.sign and en.dicttypeid='KHBMJSBZ'
			<trim prefix="WHERE" suffixOverrides="AND">
				<if test="id != null " > r.ID = #{id} AND </if>
				<if test="depid != null  and depid != '' " > r.DEPID = #{depid} AND </if>
				<if test="director != null  and director != '' " > r.DIRECTOR = #{director} AND </if>
				<if test="depcharge != null  and depcharge != '' " > r.DEPCHARGE = #{depcharge} AND </if>
				<if test="centercharge != null  and centercharge != '' " > r.CENTERCHARGE = #{centercharge} AND </if>
				<if test="centerid != null  and centerid != '' " > r.CENTERID = #{centerid} AND </if>
				<if test="tyear != null  and tyear != '' " > r.TYEAR = #{tyear} AND </if>
				<if test="isdel != null " > r.ISDEL = #{isdel} AND </if>
				<if test="lastmoduserid != null  and lastmoduserid != '' " > r.LASTMODUSERID = #{lastmoduserid} AND </if>
				<if test="lastmodtime != null " > r.LASTMODTIME = #{lastmodtime} AND </if>
				<if test="sign != null " > r.SIGN = #{sign} AND </if>

				<if test="depids != null  and depids != '' " > r.DEPID in (${depids}) AND </if>
				<if test="centerids != null  and centerids != '' " > r.CENTERID in (${centerids}) AND </if>
			</trim>
			order by r.sign,r.centerid,r.depid
		</select>

	<!--模板分配首页查询  k76239 2021-11-22 -->
	<select id="queryModouAndRelList" parameterType="map"  resultMap="PPMDEPKPIDEPREL_ALL_EXT">
		select
		b.modelid MODELID,
		b.commitflag COMMITFLAG,
		a.depid DEPID,
		a.centerid CENTERID,
		d.LOCATION DEPNAME,
		e.centername CENTERNAME,
		c.name MODELNAME
		from PPM_DEPKPI_DEP_REL a
		<choose>
			<when test="sign ==2">
				left join ppm_depkpi_dep_model b on (a.centerid = b.depid and b.isdel = 0)
			</when>
			<otherwise>
				left join ppm_depkpi_dep_model b on (a.depid = b.depid and b.isdel = 0)
			</otherwise>
		</choose>
		left join ppm_depkpi_model c on (b.modelid = c.id and c.isdel = 0)
		left join comm_department d on a.depid=d.depid
		left join ppm_da_center e on a.centerid=e.id
		<trim prefix="WHERE" suffixOverrides="AND">
			<if test="depid != null and depid != ''" >a.DEPID = #{depid} AND </if>
			<if test="sign != null and sign != ''" >a.SIGN = #{sign} AND </if>
			<if test="centerid != null and centerid != ''" >a.CENTERID = #{centerid} AND</if>
			<if test="isdel != null and isdel != ''" > a.ISDEL = #{isdel} AND </if>
		</trim>
		order by a.centerid,a.depid
	</select>



			<if test="centerid != null  and centerid != '' " > CENTERID = #{centerid} AND </if>
			<if test="sign != null  and sign != '' " > SIGN = #{sign} AND </if>
			<if test="isdel != null " > ISDEL = #{isdel} AND </if>
		</trim>
	</select>


	<!--通过depid 查询集合   k76239 2021-11-18 -->
	<select id="getRelFirstAndScende" parameterType="ppmDepkpiDepRelInfo" resultMap="PPMDEPKPIDEPREL_ALL">
		select a.secondcheck, a.firstcheck
		from PPM_DEPKPI_DEP_REL a where
		<choose>
			<when test="sign ==2">
				a.secondid in(select b.MARKERDEPID  FROM PPM_DEPKPI_DEP_CHECK b where b.DEPID = #{depid} and b.SIGN = #{sign})
			</when>
			<otherwise>
				a.depid in(select b.MARKERDEPID  FROM PPM_DEPKPI_DEP_CHECK b where b.DEPID = #{depid} and b.SIGN = #{sign})
			</otherwise>
		</choose>
	</select>
</mapper>

		<result property="deptId" column="DEPT_ID" />
		<result property="deptName" column="DEPT_NAME" />
		<result property="pmId" column="PM_ID" />
		<result property="pmName" column="PM_NAME" />
		<result property="punchTime" column="PUNCH_TIME" />
		<result property="abnormalReason" column="ABNORMAL_REASON" />
		<result property="autoAbnormalReason" column="AUTO_ABNORMAL_REASON" />
		<result property="whetherAbnormal" column="WHETHER_ABNORMAL" />
		<result property="whetherHandle" column="WHETHER_HANDLE" />
		<result property="whetherKeyOne" column="WHETHER_KEY_ONE" />
		<result property="whetherKeyTwo" column="WHETHER_KEY_TWO" />
		<result property="dataType" column="DATA_TYPE" />

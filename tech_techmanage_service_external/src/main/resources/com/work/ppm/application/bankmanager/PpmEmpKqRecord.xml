    <!--通过id查询  ywwb905 2022-09-22 -->
    <select id="queryDetail" parameterType="ppmEmpKqRecord" resultMap="PPMEMPKQRECORD_ALL">
        SELECT
        <include refid="sql_flied_all" />
        FROM PPM_EMP_KQ_RECORD
        <trim prefix="WHERE" suffixOverrides="AND">
            <if test="id != null " > ID = #{id} AND </if>
			<if test="attendanceDate != null and jobId != null and jobId != '' and isHoliday != null and isHoliday != '' and whetherDaysOff != null and whetherDaysOff != ''" >
			ATTENDANCE_DATE = #{attendanceDate} AND JOB_ID = #{jobId} AND IS_HOLIDAY = #{isHoliday} AND WHETHER_DAYS_OFF = #{whetherDaysOff} AND </if>
        </trim>
    </select>

    <!--查询集合  ywwb905 2022-09-22 -->
    <select id="getEmpList" parameterType="ppmEmpKqRecord" resultMap="PPMEMPKQRECORD_ALL">
        SELECT
        <include refid="sql_flied_all" />
        FROM PPM_EMP_KQ_RECORD
        <include refid="sql_select_condition" />
		ORDER BY ATTENDANCE_DATE ASC
    </select>


    <!--通过id编辑 ywwb905 2022-09-22 -->
    <update id="updateEmpPojo" parameterType="ppmEmpKqRecord">
        UPDATE
        PPM_EMP_KQ_RECORD
        <include refid="update_pojo_sql" />
        WHERE ID=#{id}
    </update>

    <!-- update sql -->
    <sql id="update_pojo_sql">
        <trim prefix="SET" suffixOverrides=",">
            <if test="infoId != null " > INFO_ID=#{infoId} , </if>
            <if test="jobId != null " > JOB_ID=#{jobId} , </if>
            <if test="userName != null " > USER_NAME=#{userName} , </if>
            <if test="attendanceDate != null " > ATTENDANCE_DATE = #{attendanceDate}, </if>
            <if test="workingTime != null " > WORKING_TIME=#{workingTime} , </if>
            <if test="closingTime != null " > CLOSING_TIME=#{closingTime} , </if>
            <if test="overtimeHours != null " > OVERTIME_HOURS=#{overtimeHours} , </if>
            <if test="worktimeHours != null " > WORKTIME_HOURS=#{worktimeHours} , </if>
            <if test="whetherOvernight != null " > WHETHER_OVERNIGHT=#{whetherOvernight} , </if>
            <if test="overtimeStartTime != null " > OVERTIME_START_TIME=#{overtimeStartTime} , </if>
            <if test="dataEntryType != null " > DATA_ENTRY_TYPE=#{dataEntryType} , </if>
            <if test="isHoliday != null " > IS_HOLIDAY=#{isHoliday} , </if>
            <if test="isCalOvertime != null " > IS_CAL_OVERTIME=#{isCalOvertime} , </if>
            <if test="whetherDaysOff != null and whetherDaysOff != ''" > WHETHER_DAYS_OFF = #{whetherDaysOff} , </if>
            <if test="createdTime != null " > CREATED_TIME=#{createdTime} , </if>
            <if test="createdBy != null " > CREATED_BY=#{createdBy} , </if>
            <if test="modifiedTime != null " > MODIFIED_TIME=#{modifiedTime} , </if>
            <if test="modifiedBy != null " > MODIFIED_BY=#{modifiedBy} , </if>
            <if test="whetherAbnormal != null " > WHETHER_ABNORMAL=#{whetherAbnormal} , </if>
        </trim>
    </sql>

	<!-- update sql -->
    <sql id="update_pojo_import_sql">
        <trim prefix="SET" suffixOverrides=",">
            <if test="infoId != null " > INFO_ID=#{infoId} , </if>
            <if test="jobId != null " > JOB_ID=#{jobId} , </if>
            <if test="userName != null " > USER_NAME=#{userName} , </if>
            <if test="attendanceDate != null " > ATTENDANCE_DATE = #{attendanceDate}, </if>
            <if test="workingTime != null " > WORKING_TIME=#{workingTime} , </if>
            <if test="workingTime == null " > WORKING_TIME=null , </if>
            <if test="closingTime != null " > CLOSING_TIME=#{closingTime} , </if>
            <if test="closingTime == null " > CLOSING_TIME=null , </if>
            <if test="overtimeHours != null " > OVERTIME_HOURS=#{overtimeHours} , </if>
            <if test="whetherOvernight != null " > WHETHER_OVERNIGHT=#{whetherOvernight} , </if>
            <if test="overtimeStartTime != null " > OVERTIME_START_TIME=#{overtimeStartTime} , </if>
            <if test="dataEntryType != null " > DATA_ENTRY_TYPE=#{dataEntryType} , </if>
            <if test="isHoliday != null " > IS_HOLIDAY=#{isHoliday} , </if>
            <if test="isCalOvertime != null " > IS_CAL_OVERTIME=#{isCalOvertime} , </if>
            <if test="whetherDaysOff != null and whetherDaysOff != ''" > WHETHER_DAYS_OFF=#{whetherDaysOff} , </if>
            <if test="createdTime != null " > CREATED_TIME=#{createdTime} , </if>
            <if test="createdBy != null " > CREATED_BY=#{createdBy} , </if>
            <if test="modifiedTime != null " > MODIFIED_TIME=#{modifiedTime} , </if>
            <if test="modifiedBy != null " > MODIFIED_BY=#{modifiedBy} , </if>
            <if test="worktimeHours != null " > WORKTIME_HOURS=#{worktimeHours} , </if>
            <if test="whetherAbnormal != null " > WHETHER_ABNORMAL=#{whetherAbnormal} , </if>
        </trim>
    </sql>

	<update id="updatePojoImport" parameterType="ppmEmpKqRecord">
        UPDATE
        PPM_EMP_KQ_RECORD
        <include refid="update_pojo_import_sql" />
        WHERE ID=#{id}
    </update>

    <!--通过id批量删除  ywwb436 2022-06-30 -->
    <delete id="deleteById" parameterType="ppmEmpKqRecord">
        DELETE
        FROM
        PPM_EMP_KQ_RECORD
        WHERE ID = #{id}
    </delete>

	<!-- 指定查询  2022-09-22 ywwb905  -->
    <select id="empQueryDetailObject" parameterType="map" resultMap="PPMEMPKQRECORD_ALL">
        SELECT
        <include refid="sql_flied_all" />
        FROM PPM_EMP_KQ_RECORD
        WHERE
        USER_NAME = #{userName} AND JOB_ID = #{jobId} AND INFO_ID = #{infoId} AND ATTENDANCE_DATE = TO_DATE(#{attendanceDate},'yyyy-MM-dd')
    </select>

    <select id="getEmpKqList" parameterType="map" resultMap="PPMEMPKQRECORD_ALL">
        SELECT
        <include refid="sql_flied_all"/>
        FROM PPM.PPM_EMP_KQ_RECORD
        WHERE
        TO_CHAR(ATTENDANCE_DATE , 'yyyy-MM-dd') LIKE #{attendanceDate}
    </select>



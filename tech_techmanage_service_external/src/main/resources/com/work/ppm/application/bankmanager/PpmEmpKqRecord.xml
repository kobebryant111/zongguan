		<result property="annualVacationDate" column="ANNUAL_VACATION_DATE" />
     </resultMap>

    <!-- 所有字段名称 -->
    <sql id="sql_flied_all">
        ID,
        INFO_ID,
        JOB_ID,
        USER_NAME,
        ATTENDANCE_DATE,
        WORKING_TIME,
        CLOSING_TIME,
        OVERTIME_HOURS,
        WORKTIME_HOURS,
        WHETHER_OVERNIGHT,
		OVERTIME_START_TIME,
        DATA_ENTRY_TYPE,
        IS_HOLIDAY,
        IS_CAL_OVERTIME,
		WHETHER_DAYS_OFF,
        CREATED_TIME,
        CREATED_BY,
        MODIFIED_TIME,
        MODIFIED_BY,
        WHETHER_ABNORMAL
    </sql>
    <sql id="sql_select_condition">
        <trim prefix="WHERE" suffixOverrides="AND">
            <if test="id != null " > ID = #{id} AND </if>
            <if test="infoId != null " > INFO_ID = #{infoId} AND </if>
            <if test="jobId != null " > JOB_ID = #{jobId} AND </if>
            <if test="userName != null " > USER_NAME = #{userName} AND </if>
            <if test="attendanceDate != null " > ATTENDANCE_DATE = #{attendanceDate} AND </if>
            <if test="workingTime != null " > WORKING_TIME = #{workingTime} AND </if>
            <if test="closingTime != null " > CLOSING_TIME = #{closingTime} AND </if>
            <if test="overtimeHours != null " > OVERTIME_HOURS = #{overtimeHours} AND </if>
            <if test="whetherOvernight != null " > WHETHER_OVERNIGHT = #{whetherOvernight} AND </if>
            <if test="overtimeStartTime != null " > OVERTIME_START_TIME = #{overtimeStartTime} AND </if>
            <if test="dataEntryType != null " > DATA_ENTRY_TYPE = #{dataEntryType} AND </if>
            <if test="isHoliday != null " > IS_HOLIDAY = #{isHoliday} AND </if>
            <if test="isCalOvertime != null " > IS_CAL_OVERTIME = #{isCalOvertime} AND </if>
            <if test="whetherDaysOff != null and whetherDaysOff != ''" > WHETHER_DAYS_OFF = #{whetherDaysOff} AND </if>
            <if test="createdTime != null " > CREATED_TIME = #{createdTime} AND </if>
            <if test="createdBy != null " > CREATED_BY = #{createdBy} AND </if>
            <if test="modifiedTime != null " > MODIFIED_TIME = #{modifiedTime} AND </if>
            <if test="modifiedBy != null " > MODIFIED_BY = #{modifiedBy} AND </if>
            <if test="worktimeHours != null " > WORKTIME_HOURS = #{worktimeHours} AND </if>
            <if test="whetherAbnormal != null " > WHETHER_ABNORMAL = #{whetherAbnormal} AND </if>
        </trim>
    </sql>
    <!-- 查询分页  2022-09-22 ywwb905  -->
    <select id="queryPagerList" parameterType="map" resultMap="PPMEMPKQRECORD_ALL">
        SELECT
        <include refid="sql_flied_all" />
        FROM PPM_EMP_KQ_RECORD
        <include refid="sql_select_condition" />
        order by ATTENDANCE_DATE asc
    </select>


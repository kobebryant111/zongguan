        <select id="queryPagerList" parameterType="map" resultMap="PPMPROJECTFLOW_ALL">
        	SELECT
            <include refid="sql_flied_all" />
            FROM PPM_PROJECT_FLOW
            <trim prefix="WHERE" suffixOverrides="AND">
                <if test="id != null " > ID = #{id} AND </if>
				<if test="projectno != null  and projectno != '' " > PROJECTNO = #{projectno} AND </if>
				<if test="flowtitle != null  and flowtitle != '' " > INSTR(FLOWTITLE , #{flowtitle}) > 0 AND </if>
				<if test="flowname != null  and flowname != '' " > FLOWNAME = #{flowname} AND </if>

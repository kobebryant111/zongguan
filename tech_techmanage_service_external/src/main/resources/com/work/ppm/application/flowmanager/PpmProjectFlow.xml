				<if test="flowstatus != null  and flowstatus != '' " > FLOWSTATUS = #{flowstatus} AND </if>
				<if test="isdel != null " > ISDEL = #{isdel} AND </if>
				<if test="createtime != null " > CREATETIME = #{createtime} AND </if>
				<if test="creators != null  and creators != '' " > INSTR( CREATORS , #{creators} ) > 0 AND </if>
				<if test="lastmodtime != null " > LASTMODTIME = #{lastmodtime} AND </if>
				<if test="lastmoduser != null  and lastmoduser != '' " > INSTR( LASTMODUSER , #{lastmoduser} ) > 0 AND </if>
				<if test="clr != null  and clr != '' " > CLR = #{clr} AND </if>
				<if test="activityname != null  and activityname != '' " > ACTIVITYNAME = #{activityname} AND </if>
				<if test="clrid != null  and clrid != '' " > CLRID = #{clrid} AND </if>
				<if test="activityid != null  and activityid != '' " > ACTIVITYID = #{activityid} AND </if>
                <if test="dateBegin != null and dateBegin != ''">
                    CREATETIME BETWEEN
                    to_date(#{dateBegin},'YYYY-MM-DD hh24:mi:ss') AND
                    to_date(#{dateEnd},'YYYY-MM-DD hh24:mi:ss') AND
                </if>
            </trim>
			ORDER BY CREATETIME DESC
        </select>


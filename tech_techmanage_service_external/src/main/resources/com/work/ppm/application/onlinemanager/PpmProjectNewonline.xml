    <!--通过id批量删除  k4038 2021-09-14 -->
    <delete id="deleteById" parameterType="ppmProjectNewonline">
        DELETE
        FROM
        PPM_PROJECT_NEWONLINE
        WHERE ID = #{id}
    </delete>

    <select id="isExitReviewByid" parameterType="map" resultMap="PPMPROJECTNEWONLINE_ALL">
        select * from (
        select ol.reviewid from ppm_project_newonline ol
        left join ppm_project_flow fw on fw.instanceid=ol.instanceid
        where fw.flowstatus !='已删除' and ol.reviewid is not null
        union
        select f.reviewid from ppm_project_onlinefjh f
        left join ppm_project_flow fw on fw.instanceid=f.instanceid
        where fw.flowstatus !='已删除' and f.reviewid is not null
        ) where reviewid = #{reviewno}

    </select>

    <!--通过id查询  k4038 2021-09-14 -->
    <select id="queryDetailByOnlineno" parameterType="ppmProjectNewonline" resultMap="PPMPROJECTNEWONLINE_ALL">
        SELECT
        <include refid="sql_flied_all" />
        FROM PPM_PROJECT_NEWONLINE  WHERE onlineno=#{onlineno}
    </select>

	</resultMap>
	    <!-- 上线流程分页 -->
        <select id="queryOnlinePager" parameterType="map" resultMap="QUERYONLINEPAGER_MAP">
			SELECT
            P.ONLINENO,
			P.SYSNO,
			E.PROJECTNO,E.PROJECTNAME,
			V.EMPNAME TECHUSERNAME, V.BADGE TECHUSERID,
			D.LOCATION TECHDEPTNAME,
			V1.EMPNAME BUSIUSERNAME, V1.BADGE BUSIUSERID,
			D1.LOCATION BUSIDEPTNAME
			FROM PPM_PROJECT_NEWONLINE P
			LEFT JOIN PPM_PROJECT_FLOW F ON(P.INSTANCEID=F.INSTANCEID)
			LEFT JOIN PPM_PROJECT_BUILD_SOFT E ON(E.PROJECTNO = P.PROJECTNO )
			LEFT JOIN PPM_EMP_VIEW V ON(E.MANAUSERID = V.BADGE)
			LEFT JOIN COMM_DEPARTMENT D ON(D.DEPID = E.DEPTNO)
			LEFT JOIN PPM_EMP_VIEW V1 ON(E.BUSIUSERID = V1.BADGE)
			LEFT JOIN COMM_DEPARTMENT D1 ON(D1.DEPID = E.BUSIDEPTNO)
			LEFT JOIN AAP_SYSTEM S ON(S.SYSTEM_ID = P.SYSNO)
			WHERE  P.ISDEL='0'
			<if test="deptno != null and deptno != ''">
				AND P.DEPTNO=#{deptno}
			</if>
			<if test="busideptno != null and busideptno != ''">
				AND  P.BUSIDEPTNO=#{busideptno}
			</if>
			<if test="projectno != null and projectno != ''">
				AND  E.PROJECTNO=#{projectno}
			</if>
			<if test="projectName != null and projectName != ''">
				AND instr(E.PROJECTNAME,#{projectName}) > 0
			</if>
            <if test="compid != null and compid != ''">
                AND  P.COMPID=#{compid}
            </if>
			AND to_char(P.PLANONLINE,'yyyy-MM-dd') = #{planonline}
			AND NOT EXISTS (SELECT 1 FROM PPM_NEWPRODUCTION_DETAIL D WHERE D.ONLINENO = P.ONLINENO)
			AND F.FLOWSTATUS='已结束'  AND F.FLOWID='com.work.ppm.bps.newfhxmsxFJH'
		</select>


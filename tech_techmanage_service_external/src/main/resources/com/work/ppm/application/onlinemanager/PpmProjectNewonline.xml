		<result column="PROJECTNAME" property="projectName" />
		<result column="TECHUSERNAME" property="techUserName" />
		<result column="TECHUSERID" property="techUserId" />
		<result column="TECHDEPTNAME" property="techDeptName" />
		<result column="BUSIUSERNAME" property="busiUserName" />
		<result column="BUSIUSERID" property="busiUserId" />

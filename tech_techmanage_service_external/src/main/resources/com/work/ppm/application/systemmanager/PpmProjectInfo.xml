    <!-- 所有字段名称 -->
    <sql id="sql_flied_all">
        ppi.ID,
        ppi.NAME,
        ppi.BADGE,
        ce.EMPNAME,
        ppi.DEP_ID,
        cd.LOCATION,
        ppi.CREATE_BY,
        ppi.CREATE_DATE,
        ppi.UPDATE_BY,
        ppi.UPDATE_DATE,
        ppi.PROJECT_NUMBER,
        ppi.PROJECT_SOURCE,
        ppi.BUSI_BADGE,
		ce1.EMPNAME BUSI_BADGE_NAME,
		ppi.TEST_BADGE,
		ce2.EMPNAME TEST_BADGE_NAME,
		ppi.TEST_BADGE_DEPT,
		cd1.LOCATION TEST_BADGE_DEPT_NAME,
		ppi.PROJECT_END_TIME,
        ppi.REMARK
    </sql>
	
	<sql id="sql_flied_all_easy">
        ID,
        NAME,
        BADGE,
        DEP_ID,
        CREATE_BY,
        CREATE_DATE,
        UPDATE_BY,
        UPDATE_DATE,
        PROJECT_NUMBER,
        PROJECT_SOURCE,
        BUSI_BADGE,
		TEST_BADGE,
		TEST_BADGE_DEPT,
		PROJECT_END_TIME,
        REMARK
    </sql>
    <sql id="sql_select_condition">
        <trim prefix="WHERE" suffixOverrides="AND">
            <if test="id != null  and id != '' ">ppi.id =#{id} AND</if>
            <if test="name != null  and name != '' ">ppi.NAME like '%'||#{name}||'%'  AND</if>
            <if test="badge != null  and badge != '' ">ppi.BADGE = #{badge} AND</if>
            <if test="empName != null  and empName != '' ">ce.EMPNAME like '%'||#{empName}||'%'  AND</if>
            <if test="depId != null ">ppi.DEP_ID = #{depId} AND</if>
            <if test="createBy != null  and createBy != '' ">ppi.CREATE_BY like '%'||#{createBy}||'%' AND</if>
            <if test="updateBy != null  and updateBy != '' ">ppi.UPDATE_BY like '%'||#{updateBy}||'%'  AND</if>
            <if test="projectNumber != null  and projectNumber != '' ">ppi.PROJECT_NUMBER like '%'||#{projectNumber}||'%'  AND</if>
            <if test="projectSource != null  and projectSource != '' ">ppi.PROJECT_SOURCE like '%'||#{projectSource}||'%'  AND</if>
            <if test="busiBadge != null  and busiBadge != '' ">ppi.BUSI_BADGE like '%'||#{busiBadge}||'%'  AND</if>
            <if test="busiBadgeName != null  and busiBadgeName != '' ">ce1.EMPNAME like '%'||#{busiBadgeName}||'%'  AND</if>
			<if test="testBadge != null  and testBadge != '' ">ppi.TEST_BADGE like '%'||#{testBadge}||'%'  AND</if>
            <if test="testBadgeName != null  and testBadgeName != '' ">ce2.EMPNAME like '%'||#{testBadgeName}||'%'  AND</if>
            <if test="testBadgeDept != null  and testBadgeDept != '' ">ppi.TEST_BADGE_DEPT like '%'||#{testBadgeDept}||'%'  AND</if>
            <if test="testBadgeDeptName != null  and testBadgeDeptName != '' ">cd1.TEST_BADGE_DEPT_NAME like '%'||#{testBadgeDeptName}||'%'  AND</if>
            <if test="projectEndTimeVal != null  and projectEndTimeVal != '' ">TO_CHAR(ppi.PROJECT_END_TIME,'yyyyMMdd') = #{projectEndTimeVal} AND</if>
        </trim>
    </sql>
    <!-- 查询分页  2022-03-14 ywwb436  -->
    <select id="queryPagerList" parameterType="map" resultMap="PPM_PROJECT_INFO_ALL">
        SELECT
        <include refid="sql_flied_all"/>
        from ppm_project_info ppi
        left join comm_employee ce on ce.badge = ppi.badge
        left join comm_employee ce1 on ce1.badge = ppi.busi_badge
        left join comm_employee ce2 on ce2.badge = ppi.test_badge
        left join comm_department cd on cd.depid = ppi.dep_id
        left join comm_department cd1 on cd1.depid = ppi.test_badge_dept
        <include refid="sql_select_condition"/>
    </select>

    <!-- 新增  2022-03-14 ywwb436  -->
    <insert id="addPojo" parameterType="ppmProjectInfo">
        INSERT INTO PPM_PROJECT_INFO (
        <trim suffixOverrides=",">
            <if test="id != null ">ID ,</if>
            <if test="name != null  and name != '' ">NAME ,</if>
            <if test="badge != null  and badge != '' ">BADGE ,</if>
            <if test="depId != null ">DEP_ID ,</if>
            <if test="createBy != null  and createBy != '' ">CREATE_BY ,</if>
            <if test="createDate != null ">CREATE_DATE ,</if>
            <if test="updateBy != null  and updateBy != '' ">UPDATE_BY ,</if>
            <if test="updateDate != null ">UPDATE_DATE ,</if>
            <if test="remark != null  and remark != '' ">REMARK ,</if>
            <if test="projectNumber != null  and projectNumber != '' ">PROJECT_NUMBER ,</if>
            <if test="projectSource != null  and projectSource != '' ">PROJECT_SOURCE ,</if>
            <if test="busiBadge != null  and busiBadge != '' ">BUSI_BADGE ,</if>
            <if test="testBadge != null  and testBadge != '' ">TEST_BADGE ,</if>
            <if test="testBadgeDept != null  and testBadgeDept != '' ">TEST_BADGE_DEPT ,</if>
            <if test="projectEndTime != null  ">PROJECT_END_TIME ,</if>

        </trim>
        )
        VALUES(
        <trim suffixOverrides=",">
            <if test="id != null ">#{id} ,</if>
            <if test="name != null  and name != '' ">#{name} ,</if>
            <if test="badge != null  and badge != '' ">#{badge} ,</if>
            <if test="depId != null ">#{depId} ,</if>
            <if test="createBy != null  and createBy != '' ">#{createBy} ,</if>
            <if test="createDate != null ">#{createDate} ,</if>
            <if test="updateBy != null  and updateBy != '' ">#{updateBy} ,</if>
            <if test="updateDate != null ">#{updateDate} ,</if>
            <if test="remark != null  and remark != '' ">#{remark} ,</if>
            <if test="projectNumber != null and projectNumber != '' ">#{projectNumber} ,</if>
            <if test="projectSource != null and projectSource != '' ">#{projectSource} ,</if>
            <if test="busiBadge != null and busiBadge != '' ">#{busiBadge} ,</if>
            <if test="testBadge != null and testBadge != '' ">#{testBadge} ,</if>
            <if test="testBadgeDept != null and testBadgeDept != '' ">#{testBadgeDept} ,</if>
            <if test="projectEndTime != null ">#{projectEndTime} ,</if>

        </trim>
        )
    </insert>

    <!-- 查询项目关联的行员信息   -->
    <select id="findByPpmProjectInfo" parameterType="map" resultMap="COMMEMPLOYEE_ALL">
        select ce.* from ppm_system_info ppi
        join ppm_system_user_info psui on psui.sys_id = ppi.id
        join comm_employee ce on ce.badge = psui.badge
        <include refid="sql_select_condition"/>
<!--        select ce.* from ppm_project_info ppi join comm_employee ce on ce.badge = ppi.badge
        <include refid="sql_select_condition"/>
		union all 
		select ce.* from ppm_project_info ppi join comm_employee ce on ce.badge = ppi.test_badge
		<include refid="sql_select_condition"/>-->
    </select>

    <!--通过id查询  ywwb436 2022-03-14 -->
    <select id="queryDetail" parameterType="ppmProjectInfo" resultMap="PPM_PROJECT_INFO_ALL">
        SELECT
        <include refid="sql_flied_all"/>
        from ppm_project_info ppi
        left join comm_employee ce on ce.badge = ppi.badge
        left join comm_employee ce1 on ce1.badge = ppi.busi_Badge
        left join comm_employee ce2 on ce2.badge = ppi.test_Badge
        left join comm_department cd on cd.depid = ppi.dep_id
        left join comm_department cd1 on cd1.depid = ppi.test_badge_dept
        WHERE ppi.ID=#{id}
    </select>


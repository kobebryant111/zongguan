<!--  项目详情表 查询脚本 -->
<mapper namespace="com.work.ppm.application.model.systemmanager.PpmProjectInfo">
    <resultMap type="ppmProjectInfo" id="PPM_PROJECT_INFO_ALL">
        <result property="id" column="ID"/>
        <result property="name" column="NAME"/>
        <result property="badge" column="BADGE"/>
        <result property="empName" column="EMPNAME"/>
        <result property="depId" column="DEP_ID"/>
        <result property="depName" column="LOCATION"/>
        <result property="createBy" column="CREATE_BY"/>
        <result property="createDate" column="CREATE_DATE"/>
        <result property="updateBy" column="UPDATE_BY"/>
        <result property="updateDate" column="UPDATE_DATE"/>
        <result property="remark" column="REMARK"/>
        <result property="projectNumber" column="PROJECT_NUMBER"/>
        <result property="projectSource" column="PROJECT_SOURCE"/>
        <result property="projectEndTime" column="PROJECT_END_TIME"/>
        <result property="busiBadge" column="BUSI_BADGE"/>
        <result property="busiBadgeName" column="BUSI_BADGE_NAME"/>
        <result property="testBadge" column="TEST_BADGE"/>
        <result property="testBadgeName" column="TEST_BADGE_NAME"/>
        <result property="testBadgeDept" column="TEST_BADGE_DEPT"/>
        <result property="testBadgeDeptName" column="TEST_BADGE_DEPT_NAME"/>
        <result property="projectEndTimeVal" column="PROJECT_END_TIME_VAL"/>
        <result property="badgeVal" column="BADGE_VAL"/>
    </resultMap>

    <resultMap type="commEmployee" id="COMMEMPLOYEE_ALL">
        <result property="gender" column="GENDER" />
        <result property="updateflg" column="UPDATEFLG" />
        <result property="lastupdatedate" column="LASTUPDATEDATE" />
        <result property="reportto" column="REPORTTO" />
        <result property="isdisabled" column="ISDISABLED" />
        <result property="shortphone" column="SHORTPHONE" />
        <result property="empname" column="EMPNAME" />
        <result property="empauth" column="EMPAUTH" />
        <result property="birthday" column="BIRTHDAY" />
        <result property="authproperty" column="AUTHPROPERTY" />
        <result property="remark" column="REMARK" />
        <result property="fullname" column="FULLNAME" />
        <result property="jobid" column="JOBID" />
        <result property="eid" column="EID" />
        <result property="badge" column="BADGE" />
        <result property="compid" column="COMPID" />
        <result property="empstatus" column="EMPSTATUS" />
        <result property="officephone" column="OFFICEPHONE" />
        <result property="eidhr" column="EIDHR" />

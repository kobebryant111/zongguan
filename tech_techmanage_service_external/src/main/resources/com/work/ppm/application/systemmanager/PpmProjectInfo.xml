    <!-- update sql -->
    <sql id="update_pojo_sql">
        <trim prefix="SET" suffixOverrides=",">
            <if test="id != null ">ID=#{id} ,</if>
            <if test="name != null  and name != '' ">NAME=#{name} ,</if>
            <if test="badge != null  and badge != '' ">BADGE=#{badge} ,</if>
            <if test="depId != null ">DEP_ID=#{depId} ,</if>
            <if test="createBy != null  and createBy != '' ">CREATE_BY=#{createBy} ,</if>
            <if test="createDate != null ">CREATE_DATE=#{createDate} ,</if>
            <if test="updateBy != null  and updateBy != '' ">UPDATE_BY=#{updateBy} ,</if>
            <if test="updateDate != null ">UPDATE_DATE=#{updateDate} ,</if>
            <if test="remark != null  and remark != '' ">REMARK=#{remark} ,</if>
            <if test="projectNumber != null  and projectNumber != '' ">PROJECT_NUMBER=#{projectNumber} ,</if>
            <if test="projectSource != null  and projectSource != '' ">PROJECT_SOURCE=#{projectSource} ,</if>
            <if test="busiBadge != null  and busiBadge != '' ">BUSI_BADGE=#{busiBadge} ,</if>
            <if test="testBadge != null  and testBadge != '' ">TEST_BADGE=#{testBadge} ,</if>
            <if test="testBadgeDept != null  and testBadgeDept != '' ">TEST_BADGE_DEPT=#{testBadgeDept} ,</if>
            <if test="projectEndTime != null  ">PROJECT_END_TIME=#{projectEndTime} ,</if>
        </trim>
    </sql>

    <!--通过id编辑 ywwb436 2022-03-14 -->
    <update id="updatePojo" parameterType="ppmProjectInfo">
        UPDATE
        PPM_PROJECT_INFO
        <include refid="update_pojo_sql"/>
        WHERE ID=#{id}
    </update>

    <!--通过id批量删除  ywwb436 2022-03-14 -->
    <delete id="deleteById" parameterType="ppmProjectInfo">
        DELETE
        FROM
        PPM_PROJECT_INFO
        WHERE ID = #{id}
    </delete>
	
	
	<!--查询集合  ywwb436 2022-03-14 -->
    <select id="getListForNotXmid" parameterType="ppmProjectInfo" resultMap="PPM_PROJECT_INFO_ALL">
        SELECT
        <include refid="sql_flied_all"/>
        from 
		(select <include refid="sql_flied_all_easy"/> from ppm_project_info WHERE PROJECT_NUMBER IS NOT NULL ) ppi 
        left join comm_employee ce on ce.badge = ppi.badge
        left join comm_employee ce1 on ce1.badge = ppi.busi_badge
        left join comm_employee ce2 on ce2.badge = ppi.test_badge
        left join comm_department cd on cd.depid = ppi.dep_id
        left join comm_department cd1 on cd1.depid = ppi.test_badge_dept
        <trim prefix="WHERE" suffixOverrides="AND">
            <if test="id != null  and id != '' ">ppi.id =#{id} AND</if>
            <if test="name != null  and name != '' ">ppi.NAME like '%'||#{name}||'%'  AND</if>
            <if test="badge != null  and badge != '' ">ppi.BADGE = #{badge} AND</if>
            <if test="empName != null  and empName != '' ">ce.EMPNAME like '%'||#{empName}||'%'  AND</if>
            <if test="depId != null ">ppi.DEP_ID = #{depId} AND</if>
            <if test="createBy != null  and createBy != '' ">ppi.CREATE_BY like '%'||#{createBy}||'%' AND</if>
            <if test="updateBy != null  and updateBy != '' ">ppi.UPDATE_BY like '%'||#{updateBy}||'%'  AND</if>
            <if test="projectNumber != null  and projectNumber != '' ">ppi.PROJECT_NUMBER like '%'||#{projectNumber}||'%'  AND</if>
            <if test="projectSource != null  and projectSource != '' ">ppi.PROJECT_SOURCE like '%'||#{projectSource}||'%'  AND</if>
            <if test="busiBadge != null  and busiBadge != '' ">ppi.BUSI_BADGE like '%'||#{busiBadge}||'%'  AND</if>
            <if test="busiBadgeName != null  and busiBadgeName != '' ">ce1.EMPNAME like '%'||#{busiBadgeName}||'%'  AND</if>
			<if test="testBadge != null  and testBadge != '' ">ppi.TEST_BADGE like '%'||#{testBadge}||'%'  AND</if>
            <if test="testBadgeName != null  and testBadgeName != '' ">ce2.EMPNAME like '%'||#{testBadgeName}||'%'  AND</if>
            <if test="testBadgeDept != null  and testBadgeDept != '' ">ppi.TEST_BADGE_DEPT like '%'||#{testBadgeDept}||'%'  AND</if>
            <if test="testBadgeDeptName != null  and testBadgeDeptName != '' ">cd1.LOCATION like '%'||#{testBadgeDeptName}||'%'  AND</if>
            <if test="projectEndTimeVal != null  and projectEndTimeVal != '' ">TO_CHAR(ppi.PROJECT_END_TIME,'yyyyMMdd') = #{projectEndTimeVal} AND</if>
            <if test="badgeVal != null  and badgeVal != '' ">ppi.BUSI_BADGE = #{badgeVal} OR ppi.BADGE = #{badgeVal} AND</if>
        </trim>
    </select>
	
	<select id="queryProjectDetail" parameterType="ppmProjectInfo" resultMap="PPM_PROJECT_INFO_ALL">
        SELECT
        <include refid="sql_flied_all"/>
        from ppm_project_info ppi
			left join comm_employee ce on ce.badge = ppi.badge
			left join comm_employee ce1 on ce1.badge = ppi.busi_Badge
			left join comm_employee ce2 on ce2.badge = ppi.test_Badge
			left join comm_department cd on cd.depid = ppi.dep_id
			left join comm_department cd1 on cd1.depid = ppi.test_badge_dept
		<trim prefix="WHERE" suffixOverrides="AND">
            <if test="name != null and name != '' and depId != null and depId != '' ">ppi.DEP_ID=#{depId} AND ppi.NAME = #{name} AND</if>
            <if test="projectNumber != null and projectNumber != '' and depId != null and depId != '' ">ppi.PROJECT_NUMBER = #{projectNumber} AND ppi.DEP_ID=#{depId} AND</if>
			<if test="name != null and name != '' and projectNumber != null and projectNumber != '' and depId != null and depId != '' ">ppi.NAME = #{name} AND ppi.PROJECT_NUMBER = #{projectNumber} AND ppi.DEP_ID=#{depId} AND</if>
        </trim>
			
    </select>
	

</mapper>

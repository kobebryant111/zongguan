				<if test="userole != null  and userole != '' " > USEROLE = #{userole} AND </if>
				<if test="centerid != null  and centerid != '' " > CENTERID = #{centerid} AND </if>
				<if test="itype != null " > ITYPE = #{itype} AND </if>

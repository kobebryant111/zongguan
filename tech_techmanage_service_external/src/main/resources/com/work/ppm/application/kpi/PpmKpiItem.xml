	<!--查询kpi指标的下拉框  k1327 2021-05-31 -->
	<select id="getKpiItems" parameterType="ppmKpiItem" resultMap="PPMKPIITEM_ALL">
		select i.id,
		       i.item
		from ppm_kpi_item i
		<trim prefix="WHERE" suffixOverrides="AND">
			<if test="true"> i.ISDEL = '0' AND </if>
			<if test="true"> i.ITYPE = '1' AND </if>
			<if test="id != null " > i.ID = #{id} AND </if>
			<if test="item != null  and item != '' " > i.ITEM like  '%'||#{item}||'%' AND </if>
			<if test="userole != null  and userole != '' " > i.USEROLE like '%'||#{userole}||'%' AND</if>
			<if test="centerid != null  and centerid != '' " > i.CENTERID = #{centerid} AND </if>
			<if test="uptuserid != null  and uptuserid != '' " > i.UPTUSERID = #{uptuserid} AND </if>
			<if test="uptdate != null " > i.UPTDATE = #{uptdate} AND </if>
			<if test="weight != null " > i.WEIGHT = #{weight} AND </if>
			<if test="mainpart != null  and mainpart != '' " > i.MAINPART = #{mainpart} AND </if>
			<if test="userolename != null  and userolename != '' " > i.USEROLENAME = #{userolename} AND </if>
		</trim>
	</select>
</mapper>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- author:k6991 2020-03-19 -->
<mapper namespace="com.work.ppm.application.model.usermanager.PpmStaffFileEdu">
	 <resultMap type="ppmStaffFileEdu" id="PPMSTAFFFILEEDU_ALL">
        <result property="id" column="ID" />
		<result property="badge" column="BADGE" />
		<result property="starttime" column="STARTTIME" />
		<result property="endtime" column="ENDTIME" />
		<result property="edutype" column="EDUTYPE" />
		<result property="school" column="SCHOOL" />
		<result property="major" column="MAJOR" />
		<result property="learnmodality" column="LEARNMODALITY" />
		<result property="education" column="EDUCATION" />
		<result property="degree" column="DEGREE" />
		<result property="rid" column="RID" />
		<result property="ord" column="ORD" />
		<result property="updateuserid" column="UPDATEUSERID" />
		<result property="updatedate" column="UPDATEDATE" />
		
     </resultMap>

     <!-- 所有字段名称 -->
        <sql id="sql_flied_all">
        	ID,
			BADGE,
			STARTTIME,
			ENDTIME,
			EDUTYPE,
			SCHOOL,
			MAJOR,
			LEARNMODALITY,
			EDUCATION,
			DEGREE,
			RID,
			ORD,
			UPDATEUSERID,
			UPDATEDATE
        </sql>
    	<!-- 查询分页  2020-03-19 k6991  -->
        <select id="queryPagerList" parameterType="map" resultMap="PPMSTAFFFILEEDU_ALL">
        	SELECT
            <include refid="sql_flied_all" />
            FROM PPM_STAFF_FILE_EDU
            <trim prefix="WHERE" suffixOverrides="AND">
                <if test="id != null " > ID = #{id} AND </if>
				<if test="badge != null  and badge != '' " > BADGE = #{badge} AND </if>
				<if test="starttime != null " > STARTTIME = #{starttime} AND </if>
				<if test="endtime != null " > ENDTIME = #{endtime} AND </if>
				<if test="edutype != null  and edutype != '' " > EDUTYPE = #{edutype} AND </if>
				<if test="school != null  and school != '' " > SCHOOL = #{school} AND </if>
				<if test="major != null  and major != '' " > MAJOR = #{major} AND </if>
				<if test="learnmodality != null  and learnmodality != '' " > LEARNMODALITY = #{learnmodality} AND </if>
				<if test="education != null  and education != '' " > EDUCATION = #{education} AND </if>
				<if test="degree != null  and degree != '' " > DEGREE = #{degree} AND </if>
				<if test="rid != null  and rid != '' " > RID = #{rid} AND </if>
				<if test="ord != null " > ORD = #{ord} AND </if>
				<if test="updateuserid != null  and updateuserid != '' " > UPDATEUSERID = #{updateuserid} AND </if>
				<if test="updatedate != null " > UPDATEDATE = #{updatedate} AND </if>
				
            </trim>
        </select>

        <!-- 新增  2020-03-19 k6991  -->
        <insert id="addPojo" parameterType="ppmStaffFileEdu">
    		INSERT INTO PPM_STAFF_FILE_EDU (
    		ID,
			BADGE,
			STARTTIME,
			ENDTIME,
			EDUTYPE,
			SCHOOL,
			MAJOR,
			LEARNMODALITY,
			EDUCATION,
			DEGREE,
			RID,
			ORD,
			UPDATEUSERID,
			UPDATEDATE
    		)
    		VALUES(
    		#{id},
			#{badge},
			#{starttime},
			#{endtime},
			#{edutype},
			#{school},
			#{major},
			#{learnmodality},
			#{education},
			#{degree},
			#{rid},
			#{ord},
			#{updateuserid},
			#{updatedate}
    		)
        </insert>

        <!--通过id查询  k6991 2020-03-19 -->
        <select id="queryDetail" parameterType="map" resultMap="PPMSTAFFFILEEDU_ALL">
        	SELECT
        	<include refid="sql_flied_all" />
        	FROM PPM_STAFF_FILE_EDU  WHERE ID=#{id}
        </select>

         <!--查询集合  k6991 2020-03-19 -->
        <select id="getList" parameterType="map" resultMap="PPMSTAFFFILEEDU_ALL">
        	SELECT
        	<include refid="sql_flied_all" />
        	FROM PPM_STAFF_FILE_EDU
        	<trim prefix="WHERE" suffixOverrides="AND">
        		<if test="id != null " > ID=#{id} AND </if>
				<if test="badge != null  and badge != '' " > BADGE=#{badge} AND </if>
				<if test="starttime != null " > STARTTIME=#{starttime} AND </if>
				<if test="endtime != null " > ENDTIME=#{endtime} AND </if>
				<if test="edutype != null  and edutype != '' " > EDUTYPE=#{edutype} AND </if>
				<if test="school != null  and school != '' " > SCHOOL=#{school} AND </if>
				<if test="major != null  and major != '' " > MAJOR=#{major} AND </if>
				<if test="learnmodality != null  and learnmodality != '' " > LEARNMODALITY=#{learnmodality} AND </if>
				<if test="education != null  and education != '' " > EDUCATION=#{education} AND </if>
				<if test="degree != null  and degree != '' " > DEGREE=#{degree} AND </if>
				<if test="rid != null  and rid != '' " > RID=#{rid} AND </if>
				<if test="ord != null " > ORD=#{ord} AND </if>
				<if test="updateuserid != null  and updateuserid != '' " > UPDATEUSERID=#{updateuserid} AND </if>
				<if test="updatedate != null " > UPDATEDATE=#{updatedate} AND </if>
				
            </trim>
        </select>
        <!-- update sql -->
        <sql id="update_pojo_sql">
        	<trim prefix="SET" suffixOverrides=",">
        		<if test="id != null " > ID=#{id} , </if>
				<if test="badge != null  and badge != '' " > BADGE=#{badge} , </if>
				<if test="starttime != null " > STARTTIME=#{starttime} , </if>
				<if test="endtime != null " > ENDTIME=#{endtime} , </if>
				<if test="edutype != null  and edutype != '' " > EDUTYPE=#{edutype} , </if>
				<if test="school != null  and school != '' " > SCHOOL=#{school} , </if>
				<if test="major != null  and major != '' " > MAJOR=#{major} , </if>
				<if test="learnmodality != null  and learnmodality != '' " > LEARNMODALITY=#{learnmodality} , </if>
				<if test="education != null  and education != '' " > EDUCATION=#{education} , </if>
				<if test="degree != null  and degree != '' " > DEGREE=#{degree} , </if>
				<if test="rid != null  and rid != '' " > RID=#{rid} , </if>
				<if test="ord != null " > ORD=#{ord} , </if>
				<if test="updateuserid != null  and updateuserid != '' " > UPDATEUSERID=#{updateuserid} , </if>
				<if test="updatedate != null " > UPDATEDATE=#{updatedate} , </if>
				
            </trim>
        </sql>

        <!--通过id编辑 k6991 2020-03-19 -->
    	<update id="updatePojo" parameterType="ppmStaffFileEdu">
        	UPDATE
        	PPM_STAFF_FILE_EDU
        	<include refid="update_pojo_sql" />
        	WHERE ID=#{id}
        </update>

        <!--通过id批量删除  k6991 2020-03-19 -->
        <delete id="deleteById" parameterType="ppmStaffFileEdu">
        	DELETE
        	FROM
        	PPM_STAFF_FILE_EDU
        	WHERE ID = #{id}
        </delete>
</mapper>

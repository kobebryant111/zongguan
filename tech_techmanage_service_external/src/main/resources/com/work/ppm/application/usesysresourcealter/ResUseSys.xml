    <!-- 查询流程中应用系统资源变更数据 -->
    <select id="queryResUseSysAlterData" parameterType="resUseSys" resultMap="RESUSESYSOTHER_ALL">
        SELECT
            t.APPSYSNO,
            t.APPSYSNAME,
            t.DEPID,
            t.FLOWNO,
            t.ALTERCONTENT,
            t.PROCESSINSTID,
            t.STATUS,
            t.STATUSTIME,
            t.CREATOR,
            t.CREATETIME,
            t.CREATORNAME,
            a.LOGICALRESOURCESTATS,
            a.PHYSICALRESOURCESTATS,
            a.USERTYPE,
            a.EXPLAIN,
            a.SERIALNO,
            a.ID,
            a.DELORADD,
            a.CINAME,
            a.LOCALIP,
            a.RESUSESYSID,
            a.CICLASSIFYKEY,
            a.OSVERSION,
            a.activitydefid,
            a.ciid,
            a.ciinstcondition
        FROM RES_USE_SYS t
        LEFT JOIN RES_USE_SYS_OTHER a ON t.ID =a.RESUSESYSID
        <trim prefix="WHERE" suffixOverrides="AND">
            <if test="id !=null and id !=''">t.ID =#{id} AND</if>
            <if test="processInstID != null and processInstID != ''">t.PROCESSINSTID = #{processInstID} AND</if>
              a.isdelete ='0'
        </trim>

    </select>

    <!-- 清除流程中数据 -->
    <update id="delUseSysAlterData" parameterType="resUseSysOther">
        UPDATE RES_USE_SYS_OTHER T
        SET t.ISDELETE ='1',
            t.ACTIVITYDEFID =#{activitydefid}
        WHERE t.ID = #{id}
    </update>

    <update id="updateWorkFlowRelateInfo" parameterType="Map">
        UPDATE RES_USE_SYS SET STATUS=#{status}
        WHERE ID=#{id}
    </update>

    <delete id="delResOther" parameterType="map">
        delete from RES_USE_SYS_OTHER
        where RESUSESYSID =#{id}
    </delete>

    <delete id="delResUseSys" parameterType="map">
        delete from RES_USE_SYS
        where ID =#{id}
    </delete>

    <update id="updateUseSysFlowData" parameterType="resUseSysOther">
        UPDATE RES_USE_SYS_OTHER SET ISDELETE='0'
        WHERE ACTIVITYDEFID=#{activitydefid}
          AND RESUSESYSID =#{resusesysid}

    </update>

    <!-- 查询流程中应用系统资源变更数据 -->
    <select id="queryResUseSysAlterList" parameterType="map" resultMap="RESUSESYS_ALL">
        SELECT A.ID,
               A.FLOWNO,
               A.APPSYSNAME,
               A.DEPID,
               A.PROCESSINSTID,
               A.CREATETIME,
               A.STATUS,
               L.ACTIVITYNAME
        FROM RES_USE_SYS A
                 LEFT JOIN PPM_PROJECT_FLOW L
                           ON A.PROCESSINSTID = L.INSTANCEID
        <trim prefix="WHERE" suffixOverrides="AND">
            <if test="flowno !=null and flowno !=''">a.FLOWNO LIKE '%'||#{flowno}||'%' AND</if>
            <if test="appsysname != null and appsysname != ''">a.APPSYSNAME LIKE '%'||#{appsysname}||'%' AND</if>
            <if test="status != null and status != ''">a.STATUS = #{status} AND</if>
            <if test="startTime != null and startTime !=''">
                <![CDATA[ a.CREATETIME >=  TO_DATE(#{startTime},'YYYY-MM-DD HH24:MI:SS') AND ]]>
            </if>
            <if test="endTime != null and endTime!=''">
                <![CDATA[ a.CREATETIME <  TO_DATE(#{endTime},'YYYY-MM-DD HH24:MI:SS') AND ]]>
            </if>
        </trim>
        ORDER BY a.CREATETIME DESC

    </select>

    <select id="getUseSysCnt"  parameterType="map" resultType="long">
        SELECT COUNT(1)
        FROM RES_USE_SYS
        WHERE ID = #{id}
    </select>

    <!-- 更新配置信息 -->
    <update id="upResUseSys" parameterType="resUseSys">
        UPDATE RES_USE_SYS
        <trim prefix="SET" suffixOverrides=",">
            <if test="appsysno != null  and appsysno != '' " >APPSYSNO = #{appsysno} , </if>
            <if test="appsysname != null  and appsysname != '' " >APPSYSNAME = #{appsysname} , </if>
            <if test="depid != null  and depid != '' " >DEPID = #{depid} , </if>
            <if test="sysuser != null  and sysuser != '' " >SYSUSER = #{sysuser} , </if>
            <if test="status != null  and status != '' " >STATUS = #{status} , </if>
            <if test="processInstID != null  and processInstID != '' " >PROCESSINSTID = #{processInstID} , </if>
        </trim>
        WHERE ID =#{id}
    </update>

    <!-- 技评维度根据附表获取硬件资源 -->
    <select id="resConfigPart" parameterType="String" resultType="String">
        SELECT
        SYSUSER
        FROM RES_USE_SYS
        WHERE PROCESSINSTID =#{processinstid}
    </select>

</mapper>

	<!-- 中心部门树 k1327 2021-01-13 -->
	<select id="queryCenterDepTree" parameterType="map" resultType="commTree">
		select a.* from (
		select 'dep' || t.depid id, t.depcode pcode,  replace(t.location,'总行金融科技部-') text, 'org' || t.compid pid, 'dep' attr, to_char(t.depid) textpy  ,0 ord
		from comm_department t where t.adminid is null and t.isdisabled = '0' and t.depcode = '9000190000'
		union all
		select 'cen'||m.id id,to_char(m.id) pcode,m.centername text,'dep130' pid,'cen'attr,to_char(m.id) textpy,m.id ord from Ppm_Da_Center m where 1=1
		union all
		select 'dep' || t.depid id, t.depcode pcode, replace(t.location,'总行金融科技部-') text,
		decode(m.centerid,null, 'dep' || t.adminid,'cen'||m.centerid) pid, 'dep' attr, to_char(t.depid) textpy ,o.ord
		from comm_department t
		left join ppm_da_dept_manager m on to_char(t.depid)=m.deptid
		left join ppm_dept_ord o on to_char(o.depid)='dep'||to_char(t.depid)
		where t.adminid is not null and t.isdisabled = '0' and t.adminid ='7004'
		) a
		<trim prefix="WHERE" suffixOverrides="AND">
			<if test="deps != null  and deps != '' " > replace(a.id,'dep','') in (${deps}) AND </if>
		</trim>
		order by a.ord
	</select>

	<!-- 查询需要变更的人员信息 k1327 2021-01-13 -->
	<select id="queryOutChanageInfos" parameterType="map" resultMap="PPMOUTSOURCINGCHANGEINFOS_ALL">
		select i.* from ppm_outsourcing_change_infos i left join ppm_outsourcing_change_apply a on i.instanceid=a.instanceid
		where a.status='1'
		<trim prefix="AND" suffixOverrides="AND">
			<if test="sysdate != null  and sysdate != '' " > to_date(#{sysdate},'yyyy-MM-dd')>= a.act_changetime AND </if>
		</trim>
		order by i.id desc
	</select>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- author:k6991 2020-12-15 -->
<mapper namespace="com.work.ppm.application.model.systemmanager.PpmSystParameter">
	 <resultMap type="ppmSystParameter" id="PPMSYSTPARAMETER_ALL">
        <result property="id" column="ID" />
		<result property="key" column="KEY" />
		<result property="value" column="VALUE" />
		<result property="remark" column="REMARK" />
		<result property="isdel" column="ISDEL" />
		<result property="createtime" column="CREATETIME" />
		<result property="creators" column="CREATORS" />
		<result property="lastmodtime" column="LASTMODTIME" />
		<result property="lastmoduser" column="LASTMODUSER" />
		
     </resultMap>

     <!-- 所有字段名称 -->
        <sql id="sql_flied_all">
        	ID,
			KEY,
			VALUE,
			REMARK,
			ISDEL,
			CREATETIME,
			CREATORS,
			LASTMODTIME,
			LASTMODUSER
        </sql>
        <sql id="sql_select_condition">
            <trim prefix="WHERE" suffixOverrides="AND">
                <if test="id != null " > ID = #{id} AND </if>
				<if test="key != null  and key != '' " > KEY = #{key} AND </if>
				<if test="value != null  and value != '' " > VALUE = #{value} AND </if>
				<if test="remark != null  and remark != '' " > REMARK = #{remark} AND </if>
				<if test="isdel != null " > ISDEL = #{isdel} AND </if>
				<if test="createtime != null " > CREATETIME = #{createtime} AND </if>
				<if test="creators != null  and creators != '' " > CREATORS = #{creators} AND </if>
				<if test="lastmodtime != null " > LASTMODTIME = #{lastmodtime} AND </if>
				<if test="lastmoduser != null  and lastmoduser != '' " > LASTMODUSER = #{lastmoduser} AND </if>
				
            </trim>
        </sql>
    	<!-- 查询分页  2020-12-15 k6991  -->
        <select id="queryPagerList" parameterType="map" resultMap="PPMSYSTPARAMETER_ALL">
        	SELECT
            <include refid="sql_flied_all" />
            FROM PPM_SYST_PARAMETER
            <include refid="sql_select_condition" />
        </select>

        <!-- 新增  2020-12-15 k6991  -->
        <insert id="addPojo" parameterType="ppmSystParameter">
    		INSERT INTO PPM_SYST_PARAMETER (
    		<trim suffixOverrides=",">
    		 <if test="id != null " > ID , </if>
				<if test="key != null  and key != '' " > KEY , </if>
				<if test="value != null  and value != '' " > VALUE , </if>
				<if test="remark != null  and remark != '' " > REMARK , </if>
				<if test="isdel != null " > ISDEL , </if>
				<if test="createtime != null " > CREATETIME , </if>
				<if test="creators != null  and creators != '' " > CREATORS , </if>
				<if test="lastmodtime != null " > LASTMODTIME , </if>
				<if test="lastmoduser != null  and lastmoduser != '' " > LASTMODUSER , </if>
				
              </trim>
    		)
    		VALUES(
    		<trim suffixOverrides=",">
    		 <if test="id != null " > #{id} , </if>
				<if test="key != null  and key != '' " > #{key} , </if>
				<if test="value != null  and value != '' " > #{value} , </if>
				<if test="remark != null  and remark != '' " > #{remark} , </if>
				<if test="isdel != null " > #{isdel} , </if>
				<if test="createtime != null " > #{createtime} , </if>
				<if test="creators != null  and creators != '' " > #{creators} , </if>
				<if test="lastmodtime != null " > #{lastmodtime} , </if>
				<if test="lastmoduser != null  and lastmoduser != '' " > #{lastmoduser} , </if>
				
            </trim>
    		)
        </insert>

        <!--通过id查询  k6991 2020-12-15 -->
        <select id="queryDetail" parameterType="ppmSystParameter" resultMap="PPMSYSTPARAMETER_ALL">
        	SELECT
        	<include refid="sql_flied_all" />
        	FROM PPM_SYST_PARAMETER  WHERE KEY=#{key}
        </select>

         <!--查询集合  k6991 2020-12-15 -->
        <select id="getList" parameterType="ppmSystParameter" resultMap="PPMSYSTPARAMETER_ALL">
        	SELECT
        	<include refid="sql_flied_all" />
        	FROM PPM_SYST_PARAMETER
        	<include refid="sql_select_condition" />
        </select>
        <!-- update sql -->
        <sql id="update_pojo_sql">
        	<trim prefix="SET" suffixOverrides=",">
        		<if test="id != null " > ID=#{id} , </if>
				<if test="key != null  and key != '' " > KEY=#{key} , </if>
				<if test="value != null  and value != '' " > VALUE=#{value} , </if>
				<if test="remark != null  and remark != '' " > REMARK=#{remark} , </if>
				<if test="isdel != null " > ISDEL=#{isdel} , </if>
				<if test="createtime != null " > CREATETIME=#{createtime} , </if>
				<if test="creators != null  and creators != '' " > CREATORS=#{creators} , </if>
				<if test="lastmodtime != null " > LASTMODTIME=#{lastmodtime} , </if>
				<if test="lastmoduser != null  and lastmoduser != '' " > LASTMODUSER=#{lastmoduser} , </if>
				
            </trim>
        </sql>

        <!--通过id编辑 k6991 2020-12-15 -->
    	<update id="updatePojo" parameterType="ppmSystParameter">
        	UPDATE
        	PPM_SYST_PARAMETER
        	<include refid="update_pojo_sql" />
        	WHERE ID=#{id}
        </update>

        <!--通过id批量删除  k6991 2020-12-15 -->
        <delete id="deleteById" parameterType="ppmSystParameter">
        	DELETE
        	FROM
        	PPM_SYST_PARAMETER
        	WHERE ID = #{id}
        </delete>

	<select id="getValueByKey" parameterType="ppmSystParameter" resultMap="PPMSYSTPARAMETER_ALL">
		SELECT
		<include refid="sql_flied_all" />
		FROM PPM_SYST_PARAMETER  WHERE key=#{key}
	</select>
</mapper>

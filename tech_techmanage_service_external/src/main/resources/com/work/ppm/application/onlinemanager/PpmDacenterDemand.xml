        <!--通过id查询  k74879 2021-11-16 -->
        <select id="queryDetail" parameterType="ppmDacenterDemand" resultMap="PPMDACENTERDEMANDINFO_ALL">
        	SELECT
        	<include refid="sql_flied_all" />
			from PPM_DACENTER_DEMAND pd
			left join PPM_PROJECT_FLOW pf on pd.processinst_id=pf.instanceid
			left join eos_dict_entry ed on ed.dicttypeid='NEWKG_XQFL' and ed.dictid=pd.DEMAND_TYPE
			left join eos_dict_entry ed1 on ed1.dicttypeid='NEWKG_XQZT' and ed1.dictid=pd.relation_demand_status
			left join aap_system aas on aas.system_id=pd.main_system_id
			left join COMM_DEPARTMENT cd on pd.demand_dept=cd.depid
			<trim prefix="WHERE" suffixOverrides="AND">
				<if test="id != null " > pd.ID = #{id} AND </if>
				<if test="processInstId != null  and processInstId != '' " > pd.PROCESSINST_ID = #{processInstId} AND </if>
			</trim>
        </select>



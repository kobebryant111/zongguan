	<!-- 查询分页  2021-11-16 k74879  -->
	<select id="queryPagerList" parameterType="map" resultMap="PPMDACENTERDEMANDINFO_ALL">
		select
			pf.flowstatus,
			ed.dictname,
			aas.sys_name,
			cd.location,
			case when
			ot.demanStatus is not null
			then
			(select DICTNAME from eos_dict_entry where DICTTYPEID='BUSI_DEMAND_STATUS' and DICTID=ot.demanStatus)
			else
			(select DICTNAME from eos_dict_entry where DICTTYPEID='NEWKG_XQZT' and DICTID= pd.relation_demand_status)
			end
			as relationDemandStatusName,
			pd.ID,
			pd.TITLE,
			pd.DEMAND_NO,
			pd.CREATE_BY,
			pd.CREATE_DATE,
			pd.DEMAND_DEPT,
			pd.DEMAND_BY,
			pd.PHONE,
			pd.DEMAND_TYPE,
			pd.DEMAND_ONLINE_DATE,
			pd.MAIN_SYSTEM_ID,
			pd.DEMAND_REMAKR,
			pd.PROCESSINST_ID,
			pd.RELATION_DEMAND_STATUS,
			pd.RELATION_DEMAND_PROGRESS,
			pd.RELATION_DEMAND_NO,
			pd.RELATION_DEMAND_REMAKR,
			ot.bringupdate,
			ot.builddate,
			ot.status as project_status,
			ot.actualdate
				from PPM_DACENTER_DEMAND pd
				left join PPM_PROJECT_FLOW pf on pd.processinst_id=pf.instanceid
				left join eos_dict_entry ed on ed.dicttypeid='NEWKG_XQFL' and ed.dictid=pd.DEMAND_TYPE
				left join aap_system aas on aas.system_id=pd.main_system_id
				left join COMM_DEPARTMENT cd on pd.demand_dept=cd.depid
				left join (
						select t.bringupdate,
						case when
						t.status is null
						then
						'06'
						else
						t.status
						end as demanStatus,
						ps.builddate,ps.status,ps.demandno,ps.actualdate from (
						select distinct * from (
						select pt.bringupdate,pt.demandno,case when
						pt.isdel = '1'
						then
						'07'
						else
						pt1.status
						end  as status
						from ppm_demandnewinfo  pt
						left join ppm_demand_queue pt1 on pt1.demandno = pt.demandno
						union
						select  pa.bringupdate,pa.demandno,case when
						pa.isdel = '1'
						then
						'07'
						else
						pt2.status
						end  as status
						from ppm_demand_apply pa
						left join ppm_demand_queue pt2 on pt2.demandno = pa.demandno
						) ) t
						left join ppm_project_build_soft ps on ps.demandno=t.demandno
				) ot on ot.demandno=pd.RELATION_DEMAND_NO
		WHERE pd.status in('1','0')
		<trim prefix="AND" suffixOverrides="AND">
			<if test="id != null " > ID = #{id} AND </if>
			<if test="title != null  and title != '' " > pd.TITLE like  '%'||  #{title} ||'%'  AND </if>
			<if test="demandNo != null  and demandNo != '' " > pd.DEMAND_NO = #{demandNo} AND </if>
			<if test="createBy != null  and createBy != '' " > pd.CREATE_BY like  '%'|| #{createBy} ||'%'  AND </if>
			<if test="demandDept != null  and demandDept != '' " > pd.DEMAND_DEPT = #{demandDept} AND </if>
			<if test="demandBy != null  and demandBy != '' " > pd.DEMAND_BY like  '%'||  #{demandBy}  ||'%'  AND </if>
			<if test="phone != null  and phone != '' " > pd.PHONE = #{phone} AND </if>
			<if test="demandType != null  and demandType != '' " > pd.DEMAND_TYPE = #{demandType} AND </if>
			<if test="mainSystemId != null  and mainSystemId != '' " > pd.MAIN_SYSTEM_ID = #{mainSystemId} AND </if>
			<if test="demandRemakr != null  and demandRemakr != '' " > pd.DEMAND_REMAKR = #{demandRemakr} AND </if>
			<if test="processInstId != null  and processInstId != '' " > pd.PROCESSINST_ID = #{processInstId} AND </if>
			<if test="relationDemandStatus != null  and relationDemandStatus != '' " > (pd.RELATION_DEMAND_STATUS in ( ${relationDemandStatus}) AND pd.RELATION_DEMAND_NO is null)
				<if test="demanStatus != null  and demanStatus != '' " >
				or (ot.demanStatus in ( ${demanStatus})  AND pd.RELATION_DEMAND_NO is not null)
				</if> AND </if>
			<if test="relationDemandProgress != null " > pd.RELATION_DEMAND_PROGRESS = #{relationDemandProgress} AND </if>
			<if test="relationDemandNo != null  and relationDemandNo != '' " > pd.RELATION_DEMAND_NO = #{relationDemandNo} AND </if>
			<if test="flowStatus != null  and flowStatus != '' and flowStatus != '已结束' " > pf.flowstatus = #{flowStatus} AND </if>
			<if test="flowStatus=='已结束'"> (pf.flowstatus = #{flowStatus} or pd.id &lt; 0)  AND </if>
			<if test="projectStatus != null  and projectStatus != ''" >ot.status in (${projectStatus}) AND </if>
			<if test="startDate != null and startDate != ''">
				to_char(CREATE_DATE, 'YYYY-MM-DD') BETWEEN
				#{startDate}
				AND
				#{endDate}
				AND
			</if>
			<if test="startDemandOnlineDate != null and startDemandOnlineDate != ''">
				ot.actualdate BETWEEN
				to_date(#{startDemandOnlineDate},'YYYY-MM-DD')
				AND
				to_date(#{endDemandOnlineDate},'YYYY-MM-DD')
				AND
			</if>
			<if test="startBringUpdate != null and startBringUpdate != ''">
				ot.bringupdate BETWEEN
				to_date(#{startBringUpdate},'YYYY-MM-DD')
				AND
				to_date(#{endBringUpdate},'YYYY-MM-DD')
				AND
			</if>
			<if test="startBuildDate != null and startBuildDate != ''">
				ot.builddate BETWEEN
				to_date(#{startBuildDate},'YYYY-MM-DD')
				AND
				to_date(#{endBuildDate},'YYYY-MM-DD')
				AND
			</if>
		</trim>
		order by pd.create_date desc
	</select>


</mapper>

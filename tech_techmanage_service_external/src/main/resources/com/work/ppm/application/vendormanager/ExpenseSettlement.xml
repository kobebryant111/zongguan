    <!-- pager query 2022-11-13 ywwb903  -->
    <select id="queryPagerList" parameterType="map" resultType="com.work.ppm.application.dto.vendorcontract.ExpenseSettlementDto">
        SELECT
            <include refid="sql_flied_basic"/>
            FROM PPM_EXPENSE_SETTLEMENT
        <trim prefix="WHERE" suffixOverrides="AND">
            <if test="id != null and id != '' "> ID = #{id} AND </if>
            <if test="instanceId != null and instanceId != '' "> INSTANCE_ID = #{instanceId} AND </if>
            <if test="flowId != null and flowId != '' "> FLOW_ID = #{flowId} AND </if>
            <if test="approvalStatus != null and approvalStatus != '' "> APPROVAL_STATUS = #{approvalStatus} AND </if>
            <if test="vendorName != null and vendorName != '' "> VENDOR_NAME = #{vendorName} AND </if>
            <if test="vendorCode != null and vendorCode != '' "> VENDOR_CODE = #{vendorCode} AND </if>
            <if test="taxRate != null"> TAX_RATE = #{taxRate} AND </if>
            <if test="amount != null"> AMOUNT = #{amount} AND </if>
            <if test="amountTax != null"> AMOUNT_TAX = #{amountTax} AND </if>
            <if test="isDel != null and isDel != '' "> IS_DEL = #{isDel} AND </if>
            <if test="createUser != null and createUser != '' "> CREATE_USER = #{createUser} AND </if>
            <if test="updateUser != null and updateUser != '' "> UPDATE_USER = #{updateUser} AND </if>
            <if test='perm == "common"'> PRO_MANAGER = #{proManager} AND</if>
            <if test='perm=="managers"'>
                PRO_MANAGER in (select badge from comm_employee where depid in (
                select depid from comm_employee where badge = #{proManager} )) AND
            </if>
        </trim>
    </select>


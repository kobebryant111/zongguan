    <sql id="sql_flied_basic">
        ID
        ,INSTANCE_ID as instanceId
        ,FLOW_ID as flowId
        ,APPROVAL_STATUS as approvalStatus
        ,VENDOR_NAME as vendorName
        ,VENDOR_CODE as vendorCode
        ,TAX_RATE as taxRate
        ,AMOUNT
        ,AMOUNT_TAX as amountTax
        ,PRO_MANAGER as proManager
<!--        ,(select empname from comm_employee where badge = pro_manager and ISDISABLED = '0' and rownum =1) as proManagerName-->
        ,(SELECT WMSYS.WM_CONCAT(EMPNAME) FROM comm_employee WHERE ISDISABLED = '0' AND BADGE IN (
        SELECT PRO_MANAGER FROM PPM_PAYMENT_CONFIRM WHERE id  IN (
        SELECT REGEXP_substr(PAY_CONFIRM_ID,'[^,]+',1,level) tt FROM DUAL connect by level &lt;= regexp_count(PAY_CONFIRM_ID,',') + 1
        ))) as proManagerName
        ,PAY_CONFIRM_ID as payConfirmId
        ,REMARK
    </sql>

    <sql id="sql_flied_small">

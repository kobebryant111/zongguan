		  KR.PM_REMARK,
		  KR.AUTO_AM_ABNORMAL_REASON,
		  KR.AUTO_PM_ABNORMAL_REASON,
		  KR.CREATED_TIME,
		  KR.CREATED_BY,
		  KR.MODIFIED_TIME,
		  KR.MODIFIED_BY,
		  KR.DATA_TYPE,
		  KR.IS_HOLIDAY,
		  KR.IS_CAL_OVERTIME,
		  KR.WHETHER_DAYS_OFF,
		  KR.EXEMPTION_STATE,
		  OB.PERSON_IN_CHARGE PM_ID,
		  CE.EMPNAME PM_NAME,
		  OB.DEPT_ID,
		  CD.LOCATION DEPT_NAME,
		  KR.OUTSOURCE_TYPE,
		  VA.ANNUAL_VACATION_DATE,
		  CASE WHEN VA.ANNUAL_VACATION_SURPLUS IS NULL THEN 0 ELSE VA.ANNUAL_VACATION_SURPLUS END ANNUAL_VACATION_SURPLUS,
		  CASE WHEN VA.ANNUAL_VACATION_DAYS IS NULL THEN 0 ELSE VA.ANNUAL_VACATION_DAYS END ANNUAL_VACATION_DAYS
		 FROM (
			SELECT 
				KR1.*,
				KR1.WORKING_TIME PUNCH_TIME,
				KR1.AM_ABNORMAL_REASON ABNORMAL_REASON,
				KR1.AM_WHETHER_ABNORMAL WHETHER_ABNORMAL,
				KR1.AUTO_AM_ABNORMAL_REASON AUTO_ABNORMAL_REASON,
				KR1.AM_WHETHER_HANDLE WHETHER_HANDLE,
				KR1.AM_REMARK REMARK,
				'AM' AS DATA_TYPE
			FROM PPM_KQ_RECORD KR1 WHERE KR1.AM_WHETHER_HANDLE IN ('1','2','4')
			UNION ALL 
			SELECT 
				KR2.*,
				KR2.CLOSING_TIME PUNCH_TIME ,
				KR2.PM_ABNORMAL_REASON ABNORMAL_REASON,
				KR2.PM_WHETHER_ABNORMAL WHETHER_ABNORMAL,
				KR2.AUTO_PM_ABNORMAL_REASON AUTO_ABNORMAL_REASON,
				KR2.PM_WHETHER_HANDLE WHETHER_HANDLE,
				KR2.PM_REMARK REMARK,
				'PM' AS DATA_TYPE
			FROM PPM_KQ_RECORD KR2 WHERE KR2.PM_WHETHER_HANDLE IN ('1','2','4')
			) KR
			   LEFT JOIN PPM_OUTSOURCING_BASIC OB ON KR.JOB_ID = OB.JOB_ID
			   LEFT JOIN COMM_EMPLOYEE CE ON OB.PERSON_IN_CHARGE = CE.BADGE
			   LEFT JOIN COMM_DEPARTMENT CD ON OB.DEPT_ID = CD.DEPID
			   LEFT JOIN PPM_KQ_ANNUAL_VACATION VA ON VA.JOB_ID = KR.JOB_ID
		<trim prefix="WHERE" suffixOverrides="AND">
            <if test="pmId != null and pmId != '' ">OB.PERSON_IN_CHARGE = #{pmId} AND</if>
            <if test="pmName != null and pmName != '' ">CE.EMPNAME = #{pmName} AND</if>
            <if test="jobId != null and jobId != '' ">KR.JOB_ID like '%'||#{jobId}||'%' AND</if>
<!--            UPPER(KR.JOB_ID) NOT LIKE  UPPER('K%') AND-->
            <if test="attendanceDate != null ">KR.ATTENDANCE_DATE = TO_DATE(#{attendanceDate},'yyyy-MM-dd') AND</if>
            <if test="userName != null and userName != '' ">KR.USER_NAME like '%'||#{userName}||'%' AND</if>
            <if test="isHoliday != null and isHoliday != '' ">KR.IS_HOLIDAY = #{isHoliday} AND</if>
            <if test="isCalOvertime != null and isCalOvertime != '' ">KR.IS_CAL_OVERTIME = #{isCalOvertime} AND</if>
            <if test="deptId != null and deptId != '' ">OB.DEPT_ID = #{deptId} AND</if>
			<if test="whetherHandle != null and whetherHandle != '' and whetherHandle == 1">KR.WHETHER_HANDLE = '1' AND </if>
			<if test="whetherHandle != null and whetherHandle != '' and whetherHandle == 2">KR.WHETHER_HANDLE IN ('2','4') AND </if>
			<if test="attendanceDateValue != null and attendanceDateValue != ''">TO_CHAR(KR.ATTENDANCE_DATE,'yyyy-MM') = #{attendanceDateValue} AND </if>
			<if test="dataType != null and dataType != ''">KR.DATA_TYPE = #{dataType} AND </if>
			<if test="whetherAbnormal != null and whetherAbnormal != ''">KR.WHETHER_ABNORMAL = #{whetherAbnormal} AND </if>
			<if test="attendanceDateSt != null and attendanceDateSt != '' and attendanceDateEnd != null and attendanceDateEnd != ''">KR.ATTENDANCE_DATE &gt;= TO_DATE(#{attendanceDateSt},'yyyy-MM-dd') AND KR.ATTENDANCE_DATE &lt;= TO_DATE(#{attendanceDateEnd},'yyyy-MM-dd') AND</if>
        </trim>
		ORDER BY KR.ATTENDANCE_DATE DESC ,TO_NUMBER(KR.ID) DESC ,KR.DATA_TYPE ASC
	</select>
	
	<update id="updatePojoOvertime" parameterType="ppmKqRecordView">
        UPDATE
        PPM_KQ_RECORD
		<trim prefix="SET" suffixOverrides=",">
            <if test="overtimeStartTime != null " > OVERTIME_START_TIME=#{overtimeStartTime} , </if>
            <if test="isCalOvertime != null " > IS_CAL_OVERTIME=#{isCalOvertime} , </if>
        </trim>
        WHERE ATTENDANCE_DATE >= TO_DATE(#{attendanceDateValue},'yyyy/MM/dd')
    </update>
	
	<select id="queryDistinctHandle" parameterType="ppmKqRecordView" resultMap="PPMKQRECORD_ALL_EXT">
		SELECT 
		  DISTINCT
		  OB.PERSON_IN_CHARGE PM_ID
		 FROM (
			SELECT 
				KR1.*,
				KR1.WORKING_TIME PUNCH_TIME,
				KR1.AM_ABNORMAL_REASON ABNORMAL_REASON,
				KR1.AM_WHETHER_ABNORMAL WHETHER_ABNORMAL,
				KR1.AUTO_AM_ABNORMAL_REASON AUTO_ABNORMAL_REASON,
				KR1.AM_WHETHER_HANDLE WHETHER_HANDLE,
				KR1.AM_REMARK REMARK,
				'AM' AS DATA_TYPE
			FROM PPM_KQ_RECORD KR1 WHERE KR1.AM_WHETHER_HANDLE IN ('1','2','4')
			UNION ALL 
			SELECT 
				KR2.*,
				KR2.CLOSING_TIME PUNCH_TIME ,
				KR2.PM_ABNORMAL_REASON ABNORMAL_REASON,
				KR2.PM_WHETHER_ABNORMAL WHETHER_ABNORMAL,
				KR2.AUTO_PM_ABNORMAL_REASON AUTO_ABNORMAL_REASON,
				KR2.PM_WHETHER_HANDLE WHETHER_HANDLE,
				KR2.PM_REMARK REMARK,
				'PM' AS DATA_TYPE
			FROM PPM_KQ_RECORD KR2 WHERE KR2.PM_WHETHER_HANDLE IN ('1','2','4')
			) KR
			   LEFT JOIN PPM_OUTSOURCING_BASIC OB ON KR.JOB_ID = OB.JOB_ID
			   LEFT JOIN COMM_EMPLOYEE CE ON OB.PERSON_IN_CHARGE = CE.BADGE
			   LEFT JOIN COMM_DEPARTMENT CD ON OB.DEPT_ID = CD.DEPID
			   LEFT JOIN PPM_KQ_ANNUAL_VACATION VA ON VA.JOB_ID = KR.JOB_ID
			WHERE KR.WHETHER_HANDLE = #{whetherHandle}
	</select>

    <select id="getAttendanceRecord" parameterType="map" resultMap="PPMKQRECORD_ALL_EXT">
        SELECT
        <include refid="sql_flied_all" />
        FROM PPM_KQ_RECORD
        <trim prefix="WHERE" suffixOverrides="AND">
            <if test="jobId != null and jobId != '' ">JOB_ID = #{jobId} AND</if>
            <if test="isCalOvertime != null " > IS_CAL_OVERTIME = #{isCalOvertime} AND </if>
            <if test="attendanceDateSt != null and attendanceDateSt != '' and attendanceDateEnd != null and attendanceDateEnd != ''">ATTENDANCE_DATE &gt;= TO_DATE(#{attendanceDateSt},'yyyy-MM-dd') AND ATTENDANCE_DATE &lt; TO_DATE(#{attendanceDateEnd},'yyyy-MM-dd') AND</if>
        </trim>
        ORDER BY ATTENDANCE_DATE ASC
    </select>

</mapper>

	<!--查询外包加班数据统计根据科技部 k1327 2021-03-16 -->
	<select id="getRiskResultData" parameterType="map" resultType="outRiskResultData">
			select a.job_id jobid,'准入排查' risktype,a.entry_time riskdate,'已处理' risksuggest, a.courtinfo explainstate
			from ppm_outsourcing_accessapply a
			where a.job_id=#{jobid}
			union
			select * from (
			select r.jobid,e1.dictname risktype,r.riskdate,e.dictname risksuggest,r.explainstate
			from ppm_outsourcing_risk_result r
			left join eos_dict_entry e on e.dicttypeid='PCYJ' and r.risksuggest=e.dictid
			left join eos_dict_entry e1 on e1.dicttypeid='PCLX' and r.risktype=e1.dictid
			where r.jobid=#{jobid} and rownum=1 and r.risktype='0' order by r.riskdate desc
			)
			union
			select * from (
			select r.jobid,e1.dictname risktype,r.riskdate,e.dictname risksuggest,r.explainstate
			from ppm_outsourcing_risk_result r
			left join eos_dict_entry e on e.dicttypeid='PCYJ' and r.risksuggest=e.dictid
			left join eos_dict_entry e1 on e1.dicttypeid='PCLX' and r.risktype=e1.dictid
			where r.jobid=#{jobid} and rownum=1 and r.risktype='1' order by r.riskdate desc
			)
			union
			select * from (
			select r.jobid,e1.dictname risktype,r.riskdate,e.dictname risksuggest,r.explainstate
			from ppm_outsourcing_risk_result r
			left join eos_dict_entry e on e.dicttypeid='PCYJ' and r.risksuggest=e.dictid
			left join eos_dict_entry e1 on e1.dicttypeid='PCLX' and r.risktype=e1.dictid
			where r.jobid=#{jobid} and rownum=1 and r.risktype='2' order by r.riskdate desc
			)
	</select>

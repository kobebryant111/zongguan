	 <!--查询集合  ywwb905 2023-05-23 -->
    <select id="getListForInstanceId" parameterType="ppmAccessCardApplyInfoExt" resultMap="PPMACCESSCARDAPPLYINFO_ALL_EXT">
        SELECT
			AI.ID,
			AI.INSTANCE_ID,
			AI.BIZ_OBJECT_ID,
			AI.JOB_ID,
			B.DEPT_ID,
			AI.VIRTUAL_MACHINE_ID,
			AI.ACCESS_CARD_NUMBER,
			AI.IF_RECEIVE_CARD,
			AI.RECEIVE_TIME,
			AI.IF_RETURN_CARD,
			AI.RETURN_TIME,
			AI.REMARK,
			AI.IS_DEL,
			AI.CREATED_TIME,
			AI.CREATED_BY,
			AI.MODIFIED_TIME,
			AI.MODIFIED_BY,
			B.USER_NAME,
			B.CERTIFICATE_NUMBER ID_CARD_NO,
			B.MOBILE TELEPHONE,
			B.OUTSOURCE_NO,
			B.SEX,
			I.OUTSOURCNAME OUTSOURCE_NAME,
			D.LOCATION DEPT_NAME,
			CL.IF_MAKE_CARD
        FROM PPM_ACCESS_CARD_APPLY_INFO AI 
			LEFT JOIN PPM_ACCESS_CARD_LEDGER CL ON AI.BIZ_OBJECT_ID = CL.ID
			LEFT JOIN PPM_OUTSOURCING_BASIC B ON B.JOB_ID = AI.JOB_ID
			LEFT JOIN COMM_DEPARTMENT D ON B.DEPT_ID = D.DEPID
			LEFT JOIN PPM_OUTSOURCING_INFO I ON I.ORGCODE = B.OUTSOURCE_NO
		WHERE INSTANCE_ID = #{instanceId}
    </select>
	
	
	<select id="queryBaseInfoList" parameterType="ppmAccessCardApplyInfoExt" resultMap="PPMACCESSCARDAPPLYINFO_ALL_EXT">
		SELECT 
			AI.ID,
			AI.IS_DEL,
			B.JOB_ID,
			B.USER_NAME,
			B.CERTIFICATE_NUMBER ID_CARD_NO,
			B.MOBILE TELEPHONE,
			B.OUTSOURCE_NO,
			I.OUTSOURCNAME OUTSOURCE_NAME,
			B.ENTRANCE_CARD VIRTUAL_MACHINE_ID,
			B.DEPT_ID,
			B.SEX,
			D.LOCATION DEPT_NAME,
			L.ID LEDGER_ID,
			L.IF_CREATE_RETURN,
			L.IF_MAKE_CARD,
			L.ACCESS_CARD_NUMBER,
			L.IF_RECEIVE_CARD,
			L.RECEIVE_TIME,
			L.IF_RETURN_CARD,
			L.RETURN_TIME,
			L.CREDIT_CARD_NUMBERS,
			L.ACCOUNT_NUMBER,
			L.PLACE_OF_ACCOUNT,
			L.REMARK_YGB,
			L.REMARK_JBB
        FROM PPM_ACCESS_CARD_APPLY_INFO AI
			LEFT JOIN PPM_ACCESS_CARD_APPLY CA ON AI.INSTANCE_ID = CA.INSTANCE_ID
			LEFT JOIN PPM_ACCESS_CARD_LEDGER L ON AI.BIZ_OBJECT_ID = L.ID
			LEFT JOIN PPM_OUTSOURCING_BASIC B ON  B.JOB_ID = AI.JOB_ID
			LEFT JOIN COMM_DEPARTMENT D ON B.DEPT_ID = D.DEPID
			LEFT JOIN PPM_OUTSOURCING_INFO I ON I.ORGCODE = B.OUTSOURCE_NO
		<trim prefix="WHERE" suffixOverrides="AND">
            <if test="jobId != null and jobId != '' ">B.JOB_ID = #{jobId} AND</if>
            <if test="userName != null and userName != '' ">B.USER_NAME like '%'||#{userName}||'%' AND</if>
            <if test="deptId != null and deptId != '' ">B.DEPT_ID = #{deptId} AND</if>
            <if test="ifMakeCard != null and ifMakeCard != '' "> L.IF_MAKE_CARD = #{ifMakeCard} AND </if>
            <if test="ifReceiveCard != null and ifReceiveCard != ''">L.IF_RECEIVE_CARD = #{ifReceiveCard} AND </if>
            <if test="ifReturnCard != null and ifReturnCard != ''">L.IF_RETURN_CARD = #{ifReturnCard} AND </if>
        </trim>
		ORDER BY B.ID DESC
	</select>


<!--  供应商考核评分表 查询脚本 -->
<mapper namespace="com.work.ppm.application.model.suppliermanager.PpmSupplierAssessGrade">
	 <resultMap type="ppmSupplierAssessGrade" id="PPMSUPPLIERASSESSGRADE_ALL">
        <result property="id" column="ID" />
		<result property="assessType" column="ASSESS_TYPE" />
		<result property="deptId" column="DEPT_ID" />
		<result property="supplierCode" column="SUPPLIER_CODE" />
		<result property="outsourceType" column="OUTSOURCE_TYPE" />
		<result property="projectId" column="PROJECT_ID" />
		<result property="assessYear" column="ASSESS_YEAR" />
		<result property="assessResult" column="ASSESS_RESULT" />

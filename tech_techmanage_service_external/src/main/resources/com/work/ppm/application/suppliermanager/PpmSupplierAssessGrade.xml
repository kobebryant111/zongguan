        SELECT
        <include refid="sql_flied_all" />
        FROM PPM_SUPPLIER_ASSESS_GRADE  WHERE ID=#{id}
    </select>
	
	<select id="queryDetailQt" parameterType="ppmSupplierAssessGrade" resultMap="PPMSUPPLIERASSESSGRADE_ALL">

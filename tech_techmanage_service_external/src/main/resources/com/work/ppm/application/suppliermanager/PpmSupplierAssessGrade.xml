		<result property="modifiedBy" column="MODIFIED_BY" />
		
     </resultMap>

     <!-- 所有字段名称 -->
    <sql id="sql_flied_all">
        ID,
			ASSESS_TYPE,
			DEPT_ID,
			SUPPLIER_CODE,
			OUTSOURCE_TYPE,
			PROJECT_ID,
			ASSESS_YEAR,
			ASSESS_RESULT,
			CREATED_TIME,
			CREATED_BY,
			MODIFIED_TIME,
			MODIFIED_BY
    </sql>
    <sql id="sql_select_condition">
        <trim prefix="WHERE" suffixOverrides="AND">
            <if test="id != null " > ID = #{id} AND </if>
				<if test="assessType != null  and assessType != '' " > ASSESS_TYPE = #{assessType} AND </if>
				<if test="deptId != null  and deptId != '' " > DEPT_ID = #{deptId} AND </if>
				<if test="supplierCode != null  and supplierCode != '' " > SUPPLIER_CODE = #{supplierCode} AND </if>
				<if test="outsourceType != null  and outsourceType != '' " > OUTSOURCE_TYPE = #{outsourceType} AND </if>
				<if test="projectId != null  and projectId != '' " > PROJECT_ID = #{projectId} AND </if>
				<if test="assessYear != null  and assessYear != '' " > ASSESS_YEAR = #{assessYear} AND </if>
				<if test="assessResult != null " > ASSESS_RESULT = #{assessResult} AND </if>
				<if test="createdTime != null " > CREATED_TIME = #{createdTime} AND </if>
				<if test="createdBy != null  and createdBy != '' " > CREATED_BY = #{createdBy} AND </if>
				<if test="modifiedTime != null " > MODIFIED_TIME = #{modifiedTime} AND </if>
				<if test="modifiedBy != null  and modifiedBy != '' " > MODIFIED_BY = #{modifiedBy} AND </if>
				
        </trim>
    </sql>
    <!-- 查询分页  2023-02-09 ywwb905  -->
    <select id="queryPagerList" parameterType="map" resultMap="PPMSUPPLIERASSESSGRADE_ALL">
        SELECT
        <include refid="sql_flied_all" />
        FROM PPM_SUPPLIER_ASSESS_GRADE
        <include refid="sql_select_condition" />
    </select>

    <!-- 新增  2023-02-09 ywwb905  -->

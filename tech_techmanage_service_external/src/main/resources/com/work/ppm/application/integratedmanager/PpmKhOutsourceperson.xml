		<!--查询考核数据统计  k1327 2021-03-16 -->
		<select id="getOutEvalMonthData" parameterType="map" resultType="outEvalMonthData">
			select * from (
			select o.jobid,o.tmonth,o.tlevel
			from ppm.ppm_kh_outsourceperson o
			where o.jobid=#{jobid} and o.tyear=#{year}
			) pivot(
			max(tlevel) for tmonth in ('01' as jan,'02' as feb,'03' as mar,'04' as apr,'05' as may,'06' as jun,'07' as jul,'08' as aug,'09' as sep,'10' as oct,'11' as nov,'12' as dec,'年度' as year )
			)
	    </select>
		<!--查询考核数据统计根据部门  k1327 2021-03-16 -->
		<select id="getOutEvalOrderByDep" parameterType="map" resultType="outEvalOrderData">
		select o.jobid,count(*) counts,ROUND(sum(decode(O.TLEVEL,'A+',10,'A',9,'B+',8,'B',7,'C',6,0))/count(*),2) avgscore  from ppm_kh_outsourceperson o
			where o.deptno=#{deptno} and o.tyear=#{year} group by o.jobid
		order by  ROUND(sum(decode(O.TLEVEL,'A+',10,'A',9,'B+',8,'B',7,'C',6,0))/count(*),2) desc
		</select>
		<!--查询考核数据统计根据供应商 k1327 2021-03-16 -->
		<select id="getOutEvalOrderByOutsourceno" parameterType="map" resultType="outEvalOrderData">
			select o.jobid,count(*) counts,ROUND(sum(decode(O.TLEVEL,'A+',10,'A',9,'B+',8,'B',7,'C',6,0))/count(*),2) avgscore  from ppm_kh_outsourceperson o
			where o.outsourceno=#{outsourceno} and o.tyear=#{year} group by o.jobid
			order by  ROUND(sum(decode(O.TLEVEL,'A+',10,'A',9,'B+',8,'B',7,'C',6,0))/count(*),2) desc
		</select>
		<!--查询考核数据统计根据科技部 k1327 2021-03-16 -->
		<select id="getOutEvalOrder" parameterType="map" resultType="outEvalOrderData">
			select o.jobid,count(*) counts,ROUND(sum(decode(O.TLEVEL,'A+',10,'A',9,'B+',8,'B',7,'C',6,0))/count(*),2) avgscore  from ppm_kh_outsourceperson o
			where  o.tyear=#{year} group by o.jobid
			order by  ROUND(sum(decode(O.TLEVEL,'A+',10,'A',9,'B+',8,'B',7,'C',6,0))/count(*),2) desc

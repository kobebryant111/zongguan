    </delete>
    <!--查询到期的离场流程-->
    <select id="queryOutQuitInfo" parameterType="map" resultMap="PPMOUTSOURCINGLZSQ_ALL">
        select * from ppm_outsourcing_lzsq where flag='2' and to_date(lgsj,'yyyy-MM-dd') &lt; =to_date(#{sysdate},'yyyy-MM-dd')
    </select>
	<!--查询到期的离场流程-->
    <select id="queryLeavingDetailList" parameterType="ppmOutsourcingLzsq" resultMap="PPMOUTSOURCINGLZSQ_ALL">
        select * from ppm_outsourcing_lzsq where LEAVING_APPROVE_TIME = #{leavingApproveTime}
    </select>
    <!--通过id批量删除  k1327 2020-10-12 -->
    <delete id="deleteByInstanceid" parameterType="ppmOutsourcingLzsq">
        DELETE FROM  PPM_OUTSOURCING_LZSQ WHERE instanceid = #{instanceid}
    </delete>

    <!--查询集合  k1327 2020-10-12 -->
    <select id="getOutQuitFlows" parameterType="map" resultMap="PPMOUTSOURCINGLZSQ_ALL">
        select l.* from ppm_outsourcing_lzsq l left join ppm_project_flow f on l.instanceid=f.instanceid and f.isdel=0
        where f.flowstatus in ('已结束','进行中') and l.jobid=#{jobid}
    </select>

        WHERE ID=#{id}
    </update>
    <update id="updatePojoOther"  parameterType="ppmOutsourcingLzsq">
        UPDATE
        PPM_OUTSOURCING_LZSQ
        set JOBID = 'l' ||
        CASE
        WHEN #{jobId} LIKE 'ywwb%' THEN substr(#{jobId}, 5)
        ELSE substr(#{jobId}, 2)
        END
        WHERE JOBID=#{jobId}
    </update>

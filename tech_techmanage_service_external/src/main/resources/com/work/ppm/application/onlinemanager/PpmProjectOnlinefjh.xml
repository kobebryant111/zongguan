	</resultMap>

	<!--通过id查询  k4038 2021-09-28 -->
	<select id="getOnlineInfo" parameterType="ppmProjectOnlinefjh" resultMap="PPMPROJECTONLINEFJHINFO_ALL">
		select o.*,
				p.projectname,
				p.busiuserid,
				p.deptno tecdeptno,
				p.manauserid,
				s.sys_name sysname,
				d.location,
				e.empname,
				( select pev.empname || '(' || pev.badge|| ')'  from ppm_emp_viewall pev where pev.badge=o.ysfgzjluserid) as ysfgzjlname
		from PPM_PROJECT_ONLINEFJH o
		left join ppm_project_build_soft p on o.projectno = p.projectno
		left join aap_system s on o.sysno = s.system_id
		left join comm_department d on o.busideptno = d.depid
		left join ppm_emp_viewall e on o.userid = e.badge
		WHERE o.instanceid=#{instanceid}
	</select>


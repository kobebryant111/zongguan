	<select id="queryNewFjhOnileFlow" parameterType="map" resultMap="PPMPROJECTONLINEFJH_ALL">
		select w.instanceid from ppm_project_onlinefjh w
		left join ppm_project_flow f on f.instanceid=w.instanceid
		where f.flowstatus in ('进行中')
		and f.activityid='manualActivity1'
		and ( w.projectno=#{id} or  w.onlineno=#{id})
	</select>


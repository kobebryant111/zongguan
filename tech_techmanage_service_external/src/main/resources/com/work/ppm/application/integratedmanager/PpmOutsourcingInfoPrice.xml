        <!--通过id批量删除  k6991 2020-09-14 -->
        <delete id="deleteById" parameterType="ppmOutsourcingInfoPrice">
        	DELETE
        	FROM
        	PPM_OUTSOURCING_INFO_PRICE
        	WHERE ID = #{id}
        </delete>
		<resultMap id="GETOUTSOURCPRICES_MAP" type="ppmOutsourcingInfoPriceInfo" extends="PPMOUTSOURCINGINFOPRICE_ALL">
			<result column="OUTSOURCNAME" property="outsourcname" />
			<result column="DICTNAME" property="positionName" />
			<result column="DEL_VAL" property="delVal" />
		</resultMap>
		<!-- 根据外包商编号和人员类型编号查询外包商单价 k6991 2020-09-15 -->
		<select id="getOutsourcPrices" parameterType="ppmOutsourcingInfoPrice" resultMap="GETOUTSOURCPRICES_MAP">
			SELECT
			P.POSITION,
			P.FIRSTSTARTPRIE,
			P.FIRSTENDPRIE,
			P.SECONDSTARTPRIE,
			P.SECONDENDPRIE,
			P.THIRDSTARTPRIE,
			P.THIRDENDPRIE,
			P.FOURTHSTARTPRIE,
			P.FOURTHENDPRIE,
			P.REMARK,
			I.OUTSOURCNAME,
			E.DICTNAME
			FROM PPM_OUTSOURCING_INFO_PRICE P
			LEFT JOIN PPM_OUTSOURCING_INFO I ON P.ORGCODE=I.ORGCODE
			LEFT JOIN EOS_DICT_ENTRY E ON E.DICTTYPEID='RLWBXQLX' AND P.POSITION=E.DICTID
			<trim prefix="WHERE" suffixOverrides="AND">
				<if test="true" > P.IS_DEL = '0' AND</if>
				<if test="id != null " > I.ID=#{id} AND</if>
				<if test="orgcode != null  and orgcode != '' " > p.ORGCODE=#{orgcode} AND </if>
				<if test="position != null  and position != '' " > p.POSITION=#{position} AND </if>
			</trim>
		</select>
		
		
	<update id="deleteInId" parameterType="ppmOutsourcingInfoPrice">
        UPDATE
        PPM_OUTSOURCING_INFO_PRICE
		SET IS_DEL = '1'
		<trim prefix="WHERE" suffixOverrides="AND">
			<if test="true">ORGCODE=#{orgcode} AND IS_DEL = '0' AND</if>
			<if test="delVal != null and delVal != '' ">ID NOT IN (${delVal}) AND</if>
		</trim>
    </update>
</mapper>

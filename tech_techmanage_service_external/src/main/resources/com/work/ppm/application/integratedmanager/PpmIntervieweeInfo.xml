    <!--查询集合  k6991 2020-08-24 -->
    <resultMap id="GETLISTFORID_MAP" type="ppmIntervieweeInfoInfo" extends="PPMINTERVIEWEEINFO_ALL">
        <result property="outsourcName" column="OUTSOURCNAME"/>
        <result property="sexName" column="SEX_NAME"/>
        <result property="positionName" column="POSITION_NAME"/>
        <result property="rlId" column="rl_Id"/>
		
    </resultMap>
    <select id="getListForInstanceid" parameterType="map" resultMap="GETLISTFORID_MAP">
        SELECT I.*, O.OUTSOURCNAME,A.RL_ID, E.DICTNAME SEX_NAME, N.DICTNAME POSITION_NAME
        FROM PPM_INTERVIEWEE_INFO I
        LEFT JOIN PPM_INTERVIEW_APPLY A on(I.Instanceid=A.Instanceid)
        LEFT JOIN PPM_OUTSOURCING_INFO O
        ON (I.WBSID = O.ID)
        LEFT JOIN EOS_DICT_ENTRY E
        ON (I.SEX = E.DICTID AND E.DICTTYPEID = 'BUSI_OUTSOURCE_GENFER')
        LEFT JOIN EOS_DICT_ENTRY N
        ON (I.POSITION = N.DICTID AND N.DICTTYPEID = 'RLWBXQLX')
        WHERE I.instanceid = #{instanceid}
    </select>

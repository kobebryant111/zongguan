        <include refid="sql_flied_all" />
        FROM PPM_INTERVIEWEE_INFO
        <include refid="sql_select_condition" />
        ORDER BY MS_DATE DESC
    </select>

    <!--查询集合  ywwb905 2022-11-23 -->
    <select id="getCourseInfoList" parameterType="ppmIntervieweeInfoView" resultMap="PPMINTERVIEWEEINFO_ALL_EXT">
        SELECT 
			II.ID INTERVIEW_ID,
			II.MSNAME USER_NAME,
			II.WORKYEARS,
			II.SUGGESTPRICE,
			II.WBSID,
			DE.DICTNAME POSITION,
			IA.DEPTNO             DEPT_NO,
			CD.LOCATION           DEPT_NAME,
			II.IDCARD CARD_NO,
			OI.OUTSOURCNAME OUT_SOURCE_NAME
		 FROM PPM.PPM_INTERVIEWEE_OVERINFO II 
			LEFT JOIN PPM_INTERVIEW_APPLY IA ON IA.INSTANCEID = II.INSTANCEID
			LEFT JOIN PPM_OUTSOURCING_BASIC OB ON (II.IDCARD = OB.CERTIFICATE_NUMBER AND OB.STATE = '0')
			LEFT JOIN COMM_DEPARTMENT CD ON IA.DEPTNO = CD.DEPID
			LEFT JOIN PPM_OUTSOURCING_INFO OI ON II.WBSID = OI.ID
			LEFT JOIN EOS_DICT_ENTRY DE ON (II.POSITION = DE.DICTID AND DE.DICTTYPEID = 'RLWBXQLX')
        WHERE 
			II.ISRZ = 1 
			AND OB.ID IS NULL
			AND IA.DEPTNO = #{deptNo}
		ORDER BY II.ID DESC
    </select>


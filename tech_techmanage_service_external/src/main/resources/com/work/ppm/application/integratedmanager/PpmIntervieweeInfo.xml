    <resultMap id="GETINTERVIEWPROGRESS_MAP" type="ppmIntervieweeInfoInfo">
        <result property="msDate" column="DATES"/>
        <result property="sumNum" column="SUMNUM"/>
        <result property="tgNum" column="TGNUM"/>
        <result property="instanceid" column="INSTANCEID"/>
        <result property="msname" column="MSNAME"/>
    </resultMap>
    <!-- 面试进度 k6991 2020-09-30  -->
    <select id="getInterviewProgress" parameterType="ppmIntervieweeInfo" resultMap="GETINTERVIEWPROGRESS_MAP">
        SELECT TRUNC(I.MS_DATE, 'DD') DATES, COUNT(1) SUMNUM,MAX(I.INSTANCEID)INSTANCEID,
        (SELECT COUNT(1) FROM PPM_INTERVIEWEE_INFO II WHERE II.INTERVIEWRESULT=1 AND II.INSTANCEID=#{instanceid}) TGNUM,
        MAX(I.MSNAME) MSNAME
        FROM PPM_INTERVIEWEE_INFO I
        WHERE I.INSTANCEID=#{instanceid}
        GROUP BY TRUNC(I.MS_DATE, 'DD')
        ORDER BY DATES
    </select>


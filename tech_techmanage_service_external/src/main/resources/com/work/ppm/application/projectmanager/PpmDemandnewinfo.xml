        SELECT
        <include refid="sql_flied_all"/>
        ,
        (select d.location from comm_department d where depid=dw.demanddeptno) DEMAND_DEPT_NAME,
        (select empname from comm_employee e where badge=dw.busiuserid) BUSI_USER_NAME,
        (select empname from comm_employee e where badge=dw.demanduserid) DEMAND_USER_NAME,
        (select empname from comm_employee e where badge=dw.prodeuctmanageruserid) PRODEUCT_MANAGER_USER_NAME,
        (select d.location from comm_department d where depid=dw.tectdeptno) TECT_DEPT_NAME,
        (select d.location from comm_department d where depid=dw.busideptno) BUSI_DEPT_NAME,
        (select sys_name from aap_system s where s.system_id=dw.m_sysno) SYS_NAME
        FROM PPM_DEMANDNEWINFO dw
        <trim prefix="WHERE" suffixOverrides="AND">
            <if test="instanceid != null  and instanceid != '' ">INSTANCEID=#{instanceid} AND</if>

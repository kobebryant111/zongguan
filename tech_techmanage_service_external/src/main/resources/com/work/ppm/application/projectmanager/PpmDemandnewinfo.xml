    <select id="getdemandByProjectno" parameterType="ppmDemandnewinfo" resultMap="PPMDEMANDNEWINFO_ALL">
        select a.* from ppm_demandnewinfo   a
        left join ppm_project_build_soft b on b.demandno=a.demandno
        where  b.projectno=#{projectno}
    </select>


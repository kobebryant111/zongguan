        where  a.demandno=#{demandno}
    </select>
    <select id="queryByIssueId" parameterType="ppmDemandnewinfo" resultMap="PPMDEMANDNEWINFO_ALL">
        SELECT INSTANCEID FROM PPM_DEMANDNEWINFO

    <!-- 查询分页  2021-08-31 k6991  -->
    <select id="queryPagerList" parameterType="map" resultMap="QUERYPAGERLIST_MAP">
        select * from (
        select a.demandno , a.demandname , a.proscale , a.instanceid ,a.demanduserid ,
        (select operatorname||'('||a.busiuserid||')' from comm_operator where userid = a.busiuserid) as busiusername ,
        (select location from comm_department where depid = a.demanddeptno) as demanddeptname ,
        (select location from comm_department where depid = a.tectdeptno) as tecdeptname ,
        case when
        a.isdel = '1'
        then
        '07'
        else
        nvl((select distinct status from ppm_demand_queue where demandno = a.demandno),'06') end  as status ,
        (select sys_name from aap_system where system_id = a.m_sysno) as sysname ,
        a.bringupdate ,
        null as LASTMODTIME ,
        to_number(a.isdel) as isdel,
        s.status as project_status,
        s.projectno,
        s.expectdate,
        (select empname from ppm_emp_view where badge = s.manauserid) as manauser,
        a.majorproject
        from ppm_demandnewinfo a
        left join ppm_project_build_soft s on a.demandno = s.demandno
        left join ppm_project_flow ppf on ppf.INSTANCEID = a.INSTANCEID
        <trim prefix="WHERE" suffixOverrides="AND">
            <if test="true"> ppf.flowstatus ='进行中' AND </if>
            <if test="startTime != null and startTime != ''">
                a.bringupdate between to_date(#{startTime},'yyyy-MM-dd')
                and to_date(#{endTime},'yyyy-MM-dd')
                AND </if>
            <if test="demanduserid != null and demanduserid != ''"> a.demanduserid = #{demanduserid} AND </if>
            <if test="demandno != null and demandno != ''"> INSTR(a.demandno , trim(#{demandno})) > 0 AND </if>
            <if test="projectno != null and projectno != ''"> INSTR(a.projectno , trim(#{projectno})) > 0 AND </if>
            <if test="demanddeptno != null and demanddeptno != ''"> a.demanddeptno = #{demanddeptno} AND</if>
            <if test="demandname != null and demandname != ''"> INSTR(a.demandname , trim(#{demandname})) > 0 AND </if>
            <if test="proscale != null and proscale != ''"> a.proscale IN (${proscale}) AND </if>
            <if test="status != null and status != ''">
                (
                <choose>
                    <when test="status != null ">
                        (select status from ppm_demand_queue where demandno = a.demandno and status != '07') in  (${status})
                    </when>
                </choose>
                ) AND
            </if>

        </trim>
        union
        select a.demandno , a.demandname , a.proscale , a.instanceid ,a.demanduserid ,
        (select operatorname||'('||a.busiuserid||')' from comm_operator where userid = a.busiuserid) as busiusername ,
        (select location from comm_department where depid = a.demanddeptno) as demanddeptname ,
        (select location from comm_department where depid = a.tectdeptno) as tecdeptname ,
        case when
        a.isdel = '1'
        then
        '07'
        else
        nvl((select distinct status from ppm_demand_queue where demandno = a.demandno),'06') end  as status ,
        (select sys_name from aap_system where system_id = a.m_sysno) as sysname ,
        a.bringupdate ,
        a.LASTMODTIME ,
        a.isdel ,
        s.status as project_status,
        s.projectno,
        s.expectdate,
        (select empname from ppm_emp_view where badge = s.manauserid) as manauser,
        a.majorproject
        from ppm_demand_apply a left join ppm_project_build_soft s on a.demandno = s.demandno
        join ppm_project_flow ppf on ppf.INSTANCEID = a.INSTANCEID and ppf.flowstatus !='已删除'
        left join ppm_project_flow ppf2 on ppf2.INSTANCEID = s.INSTANCEID and ppf2.flowstatus !='已删除'

        <trim prefix="WHERE" suffixOverrides="AND">
            <if test="true"> operaresid = '1' AND </if>
            <if test="startTime != null and startTime != ''">
                a.bringupdate between to_date(#{startTime},'yyyy-MM-dd')
                and to_date(#{endTime},'yyyy-MM-dd')
                AND </if>
            <if test="demanduserid != null and demanduserid != ''"> a.demanduserid = #{demanduserid} AND </if>
            <if test="demandno != null and demandno != ''"> INSTR(a.demandno , trim(#{demandno})) > 0 AND </if>
            <if test="projectno != null and projectno != ''"> INSTR(a.projectno , trim(#{projectno})) > 0 AND </if>
            <if test="demanddeptno != null and demanddeptno != ''"> a.demanddeptno = #{demanddeptno} AND</if>
            <if test="demandname != null and demandname != ''"> INSTR(a.demandname , trim(#{demandname})) > 0 AND </if>
            <if test="proscale != null and proscale != ''"> a.proscale IN (${proscale}) AND </if>
            <if test="status != null and status != ''">
                (
                <choose>
                    <when test="status != null ">
                        (select status from ppm_demand_queue where demandno = a.demandno and status != '07') in  (${status})
                    </when>
                </choose>
                ) AND
            </if>
        </trim>
        ) temp  ORDER BY BRINGUPDATE DESC
    </select>


    <!-- 是否可撤回流程 k6991 2021-09-29 -->
    <select id="sfWithdraw" parameterType="ppmDemandnewinfo" resultMap="PPMDEMANDNEWINFO_ALL">
        select w.instanceid from ppm_demandnewinfo w
        left join ppm_project_flow f on f.instanceid=w.instanceid
        where f.flowstatus in ('进行中')
        and f.activityid='manualActivity2'
        and f.flowid='com.work.ppm.bps.newFhywyxFjh'
        and w.issueid=#{issueid}
    </select>


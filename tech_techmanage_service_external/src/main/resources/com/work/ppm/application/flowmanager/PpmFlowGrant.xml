        <!--通过id查询  k6991 2020-06-15 -->
        <select id="queryDetail" parameterType="map" resultMap="PPMFLOWGRANT_ALL">
			SELECT T1.FLOWDRAFTNO,T1.FLOWNAME,F.TARGETUSERID FROM PPM_FLOW_GRANT F
			LEFT JOIN PPM_FLOW_GRANT_FLOWTYPE T1 ON(F.FLOWNAME=T1.FLOWNAME)
			<trim prefix="WHERE" suffixOverrides="AND">
				<if test="id != null " > ID = #{F.id} AND </if>
				<if test="flowdraftno != null  and flowdraftno != '' " >  INSTR(T1.FLOWDRAFTNO , #{flowdraftno}) > 0 AND </if>
				<if test="date != null " >
					<![CDATA[
					#{date} <= to_char(F.enddate,'yyyy-MM-dd') and #{date} >= to_char(F.startdate,'yyyy-MM-dd') AND
					]]>
					 </if>
				<if test="isqy != null " > F.ISQY = #{isqy} AND </if>
				<if test="isdel != null " > F.ISDEL = #{isdel} AND </if>
				<if test="sourceuserid != null  and sourceuserid != '' " > F.SOURCEUSERID = #{sourceuserid} AND </if>
			</trim>
        </select>

         <!--查询集合  k6991 2020-06-15 -->

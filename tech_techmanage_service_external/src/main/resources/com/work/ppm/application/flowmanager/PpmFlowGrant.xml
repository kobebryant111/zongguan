				<if test="note != null  and note != '' " > NOTE , </if>
				<if test="isqy != null " > ISQY , </if>
				
              </trim>
    		)
    		VALUES(
    		<trim suffixOverrides=",">
    		 <if test="id != null " > #{id} , </if>
				<if test="flowdraftno != null  and flowdraftno != '' " > #{flowdraftno} , </if>
				<if test="flowname != null  and flowname != '' " > #{flowname} , </if>
				<if test="sourceuserid != null  and sourceuserid != '' " > #{sourceuserid} , </if>

    </sql>
    <resultMap id="QUERYPAGERLIST_MAP" type="commOperatorInfo" extends="COMMOPERATOR_ALL">
        <result column="DICTNAME" property="dictname"/>
        <result column="ROLEID" property="roleid"/>
        <result column="ROLENAME" property="rolename"/>
        <result column="OPERATORNAME" property="operatorname"/>
        <result column="USERID" property="userid"/>
    </resultMap>
    <!-- 查询分页  2020-01-15 k6991  -->
    <select id="queryPagerList" parameterType="map" resultMap="QUERYPAGERLIST_MAP">
        SELECT T.*, E.DICTNAME
        FROM (SELECT DISTINCT A.OPERATORNAME,A.USERID, B.operatorid, B.ROLEID, C.ROLENAME, B.ISLOSE,B.PARTID
        FROM COMM_OPERATOR A, COMM_OPERATORROLE B, COMM_ROLE C

        <trim prefix="WHERE" suffixOverrides="AND">
            <if test="1==1">
                B.operatorid = A.operatorid
                AND B.ROLEID = C.ROLEID AND
            </if>
            <if test="userid != null  and userid != '' ">A.USERID = #{userid} AND</if>
            <if test="operatorname != null  and operatorname != '' ">A.OPERATORNAME = #{operatorname} AND</if>
        </trim>
        ) T
        LEFT JOIN EOS_DICT_ENTRY E
        ON E.DICTTYPEID = 'COMM_ISLOSE'
        AND T.ISLOSE = E.DICTID
        ORDER BY T.USERID DESC

    </select>

    <!-- 新增  2020-01-15 k6991  -->
    <insert id="addPojo" parameterType="commOperator">
        <selectKey keyProperty="operatorid" keyColumn="OPERATORID" order="BEFORE" resultType="long">
            sELECT SEQ_COMM_OPERATOR.NEXTVAL FROM DUAL
        </selectKey>
        INSERT INTO COMM_OPERATOR (
        <trim suffixOverrides=",">
            <if test="operatorid != null ">OPERATORID ,</if>
            <if test="userid != null  and userid != '' ">USERID ,</if>
            <if test="operatorname != null  and operatorname != '' ">OPERATORNAME ,</if>
            <if test="password != null  and password != '' ">PASSWORD ,</if>
            <if test="authmode != null  and authmode != '' ">AUTHMODE ,</if>
            <if test="status != null  and status != '' ">STATUS ,</if>
            <if test="unlocktime != null ">UNLOCKTIME ,</if>
            <if test="menutype != null  and menutype != '' ">MENUTYPE ,</if>
            <if test="lastlogin != null ">LASTLOGIN ,</if>
            <if test="errcount != null ">ERRCOUNT ,</if>
            <if test="startdate != null ">STARTDATE ,</if>
            <if test="enddate != null ">ENDDATE ,</if>
            <if test="validtime != null ">VALIDTIME ,</if>
            <if test="invaldate != null ">INVALDATE ,</if>
            <if test="maccode != null  and maccode != '' ">MACCODE ,</if>
            <if test="ipaddress != null  and ipaddress != '' ">IPADDRESS ,</if>
            <if test="email != null  and email != '' ">EMAIL ,</if>
            <if test="partid != null ">PARTID ,</if>
            <if test="userType != null  and userType != '' ">USER_TYPE ,</if>
        </trim>
        )
        VALUES(
        <trim suffixOverrides=",">
            <if test="operatorid != null ">#{operatorid} ,</if>
            <if test="userid != null  and userid != '' ">#{userid} ,</if>
            <if test="operatorname != null  and operatorname != '' ">#{operatorname} ,</if>
            <if test="password != null  and password != '' ">#{password} ,</if>
            <if test="authmode != null  and authmode != '' ">#{authmode} ,</if>
            <if test="status != null  and status != '' ">#{status} ,</if>
            <if test="unlocktime != null ">#{unlocktime} ,</if>
            <if test="menutype != null  and menutype != '' ">#{menutype} ,</if>
            <if test="lastlogin != null ">#{lastlogin} ,</if>
            <if test="errcount != null ">#{errcount} ,</if>
            <if test="startdate != null ">#{startdate} ,</if>
            <if test="enddate != null ">#{enddate} ,</if>
            <if test="validtime != null ">#{validtime} ,</if>
            <if test="invaldate != null ">#{invaldate} ,</if>
            <if test="maccode != null  and maccode != '' ">#{maccode} ,</if>
            <if test="ipaddress != null  and ipaddress != '' ">#{ipaddress} ,</if>
            <if test="email != null  and email != '' ">#{email} ,</if>
            <if test="partid != null ">#{partid} ,</if>
            <if test="userType != null  and userType != '' ">#{userType} ,</if>
        </trim>
        )
    </insert>

    <!--通过id查询  k6991 2020-01-15 -->
    <select id="queryById" parameterType="map" resultMap="COMMOPERATOR_ALL">
        SELECT
        <include refid="sql_flied_all"/>
        FROM COMM_OPERATOR WHERE UNLOCKTIME=#{unlocktime}
    </select>

    <!--查询集合  k6991 2020-01-15 -->
    <select id="getList" parameterType="map" resultMap="COMMOPERATOR_ALL">

        UNLOCKTIME,
        LASTLOGIN,
        INVALDATE,
        EMAIL,
        USER_TYPE,
        MENUTYPE,
        ERRCOUNT,
        MACCODE,
        USERID,
        AUTHMODE,
        STATUS,
        VALIDTIME,
        IPADDRESS,
        OPERATORID,
        STARTDATE,
        ENDDATE,
        PARTID,
        OPERATORNAME,

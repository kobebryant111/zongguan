            <if test="maccode != null  and maccode != '' ">MACCODE=#{maccode} AND</if>
            <if test="userid != null  and userid != '' ">USERID=#{userid} AND</if>
            <if test="authmode != null  and authmode != '' ">AUTHMODE=#{authmode} AND</if>
            <if test="status != null  and status != '' ">STATUS=#{status} AND</if>
            <if test="validtime != null ">VALIDTIME=#{validtime} AND</if>
            <if test="ipaddress != null  and ipaddress != '' ">IPADDRESS=#{ipaddress} AND</if>

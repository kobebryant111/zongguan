    <!--通过id编辑 k6991 2020-01-15 -->
    <update id="updatePojo" parameterType="commOperator">
        UPDATE
        COMM_OPERATOR
        <include refid="update_pojo_sql"/>
        WHERE UNLOCKTIME=#{unlocktime}
    </update>
    <!-- 通过userid更新密码 ywwb903 2023-01-28 -->
    <update id="updatePojoCus" parameterType="commOperator">
        UPDATE
        COMM_OPERATOR
        <include refid="update_pojo_sql"/>
        WHERE userid=#{userid}
    </update>
    <update id="updateLastlogin" parameterType="commOperator">
        UPDATE
        COMM_OPERATOR
        SET LASTLOGIN=#{lastlogin}
        WHERE userid=#{userid}
    </update>
    <resultMap id="DOLOGIN_MAP" type="commOperatorInfo" extends="COMMOPERATOR_ALL">
        <result property="deptId" column="DEPID"/>
        <result property="location" column="LOCATION"/>
        <result property="stockpath" column="STOCKPATH"/>
        <result property="docname" column="DOCNAME"/>
        <result property="docdomain" column="DOCDOMAIN"/>
        <result property="certificateType" column="CERTIFICATE_TYPE"/>
        <result property="certificateNumber" column="CERTIFICATE_NUMBER"/>
    </resultMap>
    <!-- 登录  2020-02-20 k6991 -->
    <select id="doLogin" parameterType="commOperator" resultMap="DOLOGIN_MAP">
        SELECT O.*,E.DEPID,E.LOCATION,D.STOCKPATH,D.DOCNAME,D.DOCDOMAIN FROM (
            SELECT
            UNLOCKTIME, LASTLOGIN, INVALDATE, EMAIL, USER_TYPE, CERTIFICATE_TYPE, CERTIFICATE_NUMBER,
            MENUTYPE, ERRCOUNT, MACCODE, USERID, AUTHMODE, STATUS, VALIDTIME,
            IPADDRESS, OPERATORID, STARTDATE, ENDDATE, PARTID, OPERATORNAME, PASSWORD
            FROM COMM_OPERATOR co,COMM_EMPLOYEE ce where ce.badge = co.userid
            AND co.USERID = #{userid} ORDER BY PARTID DESC
        ) O LEFT JOIN
        COMM_EMPLOYEE_VIEW E ON(O.USERID=E.BADGE)
        LEFT JOIN PPM_STAFF_FILE S ON(O.USERID = S.BADGE)
        LEFT JOIN PPM_DOCUMENT D ON(S.IMAGE=D.DOCUMENTNO)
    </select>

    <!-- 下一个操作用户id -->
    <select id="getNextRoleUser" parameterType="map" resultMap="COMMOPERATOR_ALL">
        SELECT USERID,OPERATORNAME FROM COMM_OPERATOR WHERE OPERATORID IN (
        SELECT OPERATORID FROM COMM_OPERATORROLE WHERE ROLEID IN (${roleid})
        )
    </select>

    <!-- 根据用户id 查询用户名称  k6991 2020-06-10 -->
    <select id="getUserNameByUserId" parameterType="map" resultMap="COMMOPERATOR_ALL">
        SELECT USERID,OPERATORNAME FROM COMM_OPERATOR WHERE userid=#{userId}
    </select>
    <!-- 获取最大id -->
    <select id="getPrimaryKey" parameterType="map" resultType="long">
        SELECT MAX(OPERATORID) FROM COMM_OPERATOR
    </select>
</mapper>

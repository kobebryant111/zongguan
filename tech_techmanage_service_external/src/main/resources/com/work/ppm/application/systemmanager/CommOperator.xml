        <trim prefix="SET" suffixOverrides=",">
            <if test="unlocktime != null ">UNLOCKTIME=#{unlocktime} ,</if>
            <if test="lastlogin != null ">LASTLOGIN=#{lastlogin} ,</if>
            <if test="invaldate != null ">INVALDATE=#{invaldate} ,</if>
            <if test="email != null  and email != '' ">EMAIL=#{email} ,</if>
            <if test="userType != null  and userType != '' ">USER_TYPE=#{userType} ,</if>
            <if test="menutype != null  and menutype != '' ">MENUTYPE=#{menutype} ,</if>
            <if test="errcount != null ">ERRCOUNT=#{errcount} ,</if>
            <if test="maccode != null  and maccode != '' ">MACCODE=#{maccode} ,</if>
            <if test="userid != null  and userid != '' ">USERID=#{userid} ,</if>
            <if test="authmode != null  and authmode != '' ">AUTHMODE=#{authmode} ,</if>
            <if test="status != null  and status != '' ">STATUS=#{status} ,</if>

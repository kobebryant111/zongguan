    <!-- 部门系统树 2020-08-06 k6991-->
    <select id="querySystemTree" parameterType="map" resultType="commTree">
        select distinct t.*,
        case
        when pcode = '9000000000' then
        'order1'
        else
        'order2'
        end order_by
        from (
        select a.*
        from (
        select 'org' || t.compid id, t.compcode pcode, t.location text, 'org' || t.adminid pid, 'org' attr, '' textpy
        from comm_organization t where t.isdisabled = '0'
        union all
        select 'dep' || t.depid id, t.depcode pcode, t.location text, 'org' || t.compid pid, 'dep' attr, '' textpy
        from comm_department t where t.adminid is null and t.isdisabled = '0'
        union all
        select 'dep' || t.depid id, t.depcode pcode, t.location text, 'dep' || t.adminid pid, 'dep' attr, '' textpy
        from comm_department t where t.adminid is not null and t.isdisabled = '0'
        union all
        select 'sys' || x.res_id, x.system_id pcode, x.sys_name text,
        'dep' || x.tec_dep pid,
        'sys' attr, '' textpy
        from
        (
        select a.res_id, nvl(b.system_id, a.res_id) system_id, b.sys_name, a.tec_dep, c.location,b.p_res_id
        from aap_system_responsibility a
        left join comm_department c on a.tec_dep = c.depid
        right join aap_system b on a.res_id = b.res_id and b.sys_name is not null

        where 1=1
        <if test="isGetChild != null and isGetChild != ''">
            and b.p_res_id is null
        </if>

        <if test="status != null and status != '' ">
            and b.sys_status not in ('2','3')
        </if>
        <if test="busdep != null and busdep != ''">
            and ','||a.bus_dep||',' like '%,'||#{busdep}||',%'
        </if>
        ) x
        ) a
        where 1=1
        <if test="system != null and system != ''">
            and a.text like '%'||#{system}||'%'

        </if>
        <if test="objectCode != null and objectCode != ''">
            start with ','||#{objectCode}||',' like '%,'||a.pcode||',%' or a.pcode='6000000000' connect by prior a.id =
            a.pid
        </if>
        ) t
        start with t.attr = 'sys' connect by prior t.pid = t.id
        order by order_by,id
    </select>


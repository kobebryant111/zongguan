    <select id="getFZRSysno" parameterType="map" resultMap="AAPSYSTEM_ALL">
        SELECT TO_CHAR(WM_CONCAT(T.SYSTEM_ID)) SYSTEM_ID FROM AAP_SYSTEM T
        LEFT JOIN AAP_SYSTEM_RESPONSIBILITY B ON B.RES_ID=T.RES_ID
        WHERE B.PRINCIPALA=#{userId} OR B.PRINCIPALB=#{userId}
    </select>

    <!-- 查询计划上线系统 -->
    <select id="queryPlansystem" parameterType="map" resultMap="aapSystemInfo">
        select r.principala,a.* from aap_system a
        left join aap_system_responsibility r on r.res_id=a.res_id
        where a.sys_status='1'
        and a.system_id = #{sysno}
    </select>

    <!-- 查询总行系统 -->
    <select id="querySystemIsZH" parameterType="map" resultMap="AAPSYSTEM_ALL">
        select r.principala,a.* from aap_system a
        left join aap_system_responsibility r on r.res_id=a.res_id
        left join comm_department d on r.tec_dep = d.depid
        left join Comm_Organization n on n.compid = d.compid
        where a.sys_status='1'
        and n.location in ('总行', '永赢金租')
        and a.system_id = #{sysno}
    </select>
</mapper>

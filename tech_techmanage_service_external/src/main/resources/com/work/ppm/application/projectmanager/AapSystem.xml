    <select id="queryPasBySystems" parameterType="map" resultType="aapSystemInfo">
        select wm_concat(aap1.system_id) sysids ,wm_concat(aap1.sys_name) sysnames,wm_concat(res1.principala_name)
        usernames ,
        wm_concat(res1.principala) userids from aap_system aap1 left join aap_system_responsibility res1 on
        aap1.res_id=res1.res_id
        where aap1.system_id in(${systemid})
    </select>
